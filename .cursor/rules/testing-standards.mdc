import type { LotusNode } from '@/types';

export function createMockNode(
  id: string,
  type: LotusNode['type'] = 'content',
  children: LotusNode[] = []
): LotusNode {
  return {
    id,
    type,
    title: {
      en: `${id} EN`,
      ru: `${id} RU`,
    },
    description: {
      en: `Description for ${id}`,
      ru: `Описание для ${id}`,
    },
    children,
    tags: ['test'],
    lastModified: '2024.03.20',
  };
}

export function createMockGraph(): LotusNode {
  return createMockNode('home', 'hub', [
    createMockNode('lectures', 'hub', [
      createMockNode('lectures-neuroplasticity', 'content'),
      createMockNode('lectures-art-brain', 'content'),
    ]),
    createMockNode('works', 'hub', [
      createMockNode('works-neuromandala', 'media'),
    ]),
    createMockNode('contacts', 'content'),
  ]);
}
```

