## Unit Tests

### Testing Utilities

**Example:** `src/utils/nodeHelpers.test.ts`

```typescript
import { describe, it, expect } from 'vitest';
import { findNode, getNodePath } from './nodeHelpers';
import { createMockNode } from '@/test/utils/mockData';

describe('nodeHelpers', () => {
  describe('findNode', () => {
    it('should find node by id', () => {
      const root = createMockNode('home', 'hub', [
        createMockNode('child1', 'content'),
        createMockNode('child2', 'content'),
      ]);

      const result = findNode(root, 'child1');
      
      expect(result).toBeDefined();
      expect(result?.id).toBe('child1');
    });

    it('should return undefined for non-existent node', () => {
      const root = createMockNode('home', 'hub');
      const result = findNode(root, 'non-existent');
      
      expect(result).toBeUndefined();
    });

    it('should find deeply nested nodes', () => {
      const root = createMockNode('home', 'hub', [
        createMockNode('parent', 'hub', [
          createMockNode('child', 'content', [
            createMockNode('grandchild', 'content'),
          ]),
        ]),
      ]);

      const result = findNode(root, 'grandchild');
      
      expect(result).toBeDefined();
      expect(result?.id).toBe('grandchild');
    });
  });

  describe('getNodePath', () => {
    it('should return path from root to node', () => {
      const root = createMockNode('home', 'hub', [
        createMockNode('parent', 'hub', [
          createMockNode('child', 'content'),
        ]),
      ]);

      const path = getNodePath(root, 'child');
      
      expect(path).toHaveLength(3);
      expect(path.map(n => n.id)).toEqual(['home', 'parent', 'child']);
    });
  });
});
```

### Testing Frontmatter Parser

**Example:** `src/utils/frontmatter.test.ts`

```typescript
import { describe, it, expect } from 'vitest';
import { parseFrontmatter } from './frontmatter';

describe('parseFrontmatter', () => {
  it('should parse valid frontmatter', () => {
    const content = `---
id: test-node
parent: home
title_en: Test
title_ru: Тест
type: content
date: 2024.03.20
---

Content here`;

    const result = parseFrontmatter(content);

    expect(result.id).toBe('test-node');
    expect(result.parent).toBe('home');
    expect(result.title_en).toBe('Test');
    expect(result.title_ru).toBe('Тест');
    expect(result.type).toBe('content');
  });

  it('should handle missing optional fields', () => {
    const content = `---
id: test
parent: home
title_en: Test
title_ru: Тест
type: content
date: 2024.03.20
---`;

    const result = parseFrontmatter(content);

    expect(result.tags).toBeUndefined();
    expect(result.order).toBeUndefined();
  });

  it('should throw on invalid YAML', () => {
    const content = `---
invalid: yaml: structure
---`;

    expect(() => parseFrontmatter(content)).toThrow();
  });
});
```

### Testing Custom Hooks

**Example:** `src/hooks/useLotusLogic.test.ts`

```typescript
import { describe, it, expect } from 'vitest';
import { renderHook } from '@testing-library/react';
import { useLotusLogic } from './useLotusLogic';
import { createMockNode } from '@/test/utils/mockData';

describe('useLotusLogic', () => {
  it('should return visible nodes', () => {
    const node = createMockNode('hub', 'hub', [
      createMockNode('child1', 'content'),
      createMockNode('child2', 'content'),
    ]);

    const { result } = renderHook(() => useLotusLogic(node));

    expect(result.current.visibleNodes).toHaveLength(2);
  });

  it('should respect grid limit', () => {
    const children = Array.from({ length: 10 }, (_, i) =>
      createMockNode(`child${i}`, 'content')
    );
    const node = createMockNode('hub', 'hub', children);

    const { result } = renderHook(() => useLotusLogic(node));

    expect(result.current.visibleNodes.length).toBeLessThanOrEqual(8);
  });
});
```

