**Example:** `src/components/NodeCard.test.tsx`

```typescript
import { describe, it, expect, vi } from 'vitest';
import { screen } from '@testing-library/react';
import userEvent from '@testing-library/user-event';
import { renderWithContext } from '@/test/utils/renderWithContext';
import { NodeCard } from './NodeCard';
import { createMockNode } from '@/test/utils/mockData';

describe('NodeCard', () => {
  it('should render node title', () => {
    const node = createMockNode('test', 'content');
    renderWithContext(<NodeCard node={node} />);

    expect(screen.getByText(node.title.en)).toBeInTheDocument();
  });

  it('should call onClick when clicked', async () => {
    const node = createMockNode('test', 'content');
    const onClick = vi.fn();
    const user = userEvent.setup();

    renderWithContext(<NodeCard node={node} onClick={onClick} />);

    await user.click(screen.getByRole('button'));

    expect(onClick).toHaveBeenCalledWith(node.id);
  });

  it('should display correct icon for node type', () => {
    const hubNode = createMockNode('hub', 'hub');
    const contentNode = createMockNode('content', 'content');

    const { rerender } = renderWithContext(<NodeCard node={hubNode} />);
    expect(screen.getByTestId('icon-layers')).toBeInTheDocument();

    rerender(<NodeCard node={contentNode} />);
    expect(screen.getByTestId('icon-file-text')).toBeInTheDocument();
  });
});
```

## Content Validation

### Orphaned Nodes Detection

**Script:** `scripts/validate-content.js` (to be created)

```javascript
import fs from 'fs';
import path from 'path';

const CONTENT_DIR = 'src/content';

function validateContent() {
  const files = fs.readdirSync(CONTENT_DIR).filter(f => f.endsWith('.md'));
  const nodes = new Map();
  const orphaned = [];

  // Parse all nodes
  files.forEach(file => {
    const content = fs.readFileSync(path.join(CONTENT_DIR, file), 'utf-8');
    const idMatch = content.match(/^id:\s*(.+)$/m);
    const parentMatch = content.match(/^parent:\s*(.+)$/m);

    if (idMatch) {
      const id = idMatch[1].trim();
      const parent = parentMatch ? parentMatch[1].trim() : null;
      nodes.set(id, { id, parent, file });
    }
  });

  // Check for orphaned nodes
  nodes.forEach((node, id) => {
    if (node.parent && node.parent !== 'home' && !nodes.has(node.parent)) {
      orphaned.push(node);
    }
  });

  if (orphaned.length > 0) {
    console.error('❌ ORPHANED NODES DETECTED:');
    orphaned.forEach(node => {
      console.error(`  - ${node.id} (parent: ${node.parent}) in ${node.file}`);
    });
    process.exit(1);
  }

  console.log('✅ All nodes have valid parents');
}

validateContent();
```

**Add to package.json:**
```json
{
  "scripts": {
    "validate:content": "node scripts/validate-content.js"
  }
}
```

### Broken Links Detection

**Script:** `scripts/validate-links.js` (to be created)

```javascript
import fs from 'fs';
import path from 'path';

const CONTENT_DIR = 'src/content';
const PUBLIC_DIR = 'public';

function validateLinks() {
  const files = fs.readdirSync(CONTENT_DIR).filter(f => f.endsWith('.md'));
  const brokenLinks = [];

  files.forEach(file => {
    const content = fs.readFileSync(path.join(CONTENT_DIR, file), 'utf-8');
    
    // Check markdown images
    const mdImages = content.matchAll(/!\[.*?\]\((.*?)\)/g);
    for (const match of mdImages) {
      const url = match[1];
      if (url.startsWith('/')) {
        const filePath = path.join(PUBLIC_DIR, url.substring(1));
        if (!fs.existsSync(filePath)) {
          brokenLinks.push({ file, url, type: 'image' });
        }
      }
    }

    // Check wiki-links
    const wikiLinks = content.matchAll(/!\[\[(.*?)\]\]/g);
    for (const match of wikiLinks) {
      const parts = match[1].split('|');
      const url = parts[0].trim();
      const poster = parts[2]?.trim();

      if (url.startsWith('/')) {
        const filePath = path.join(PUBLIC_DIR, url.substring(1));
        if (!fs.existsSync(filePath)) {
          brokenLinks.push({ file, url, type: 'media' });
        }
      }

      if (poster && poster.startsWith('/')) {
        const posterPath = path.join(PUBLIC_DIR, poster.substring(1));
        if (!fs.existsSync(posterPath)) {
          brokenLinks.push({ file, url: poster, type: 'poster' });
        }
      }
    }
  });

  if (brokenLinks.length > 0) {
    console.error('❌ BROKEN LINKS DETECTED:');
    brokenLinks.forEach(link => {
      console.error(`  - ${link.file}: ${link.url} (${link.type})`);
    });
    process.exit(1);
  }

  console.log('✅ All links are valid');
}

validateLinks();
```

