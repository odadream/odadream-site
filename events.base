filters:
  and:
    - file.folder == "src/content"
    - kind == "event"
    - file.hasTag("hub-registry")
views:
  - type: table
    name: Участия
    order:
      - file.name
    sort:
      - property: date_start
        direction: DESC
    columnSize:
      note.date_start: 120
      note.title_ru: 280
      note.subkind: 120
      note.orgs: 180
      note.venues: 200
      note.city_ru: 120
    properties:
      date_start:
        displayName: Дата
      title_ru:
        displayName: Название
      subkind:
        displayName: Тип
      orgs:
        displayName: Организатор
      venues:
        displayName: Площадка
      city_ru:
        displayName: Город
      title_en:
        displayName: Title (EN)
      city_en:
        displayName: City (EN)
