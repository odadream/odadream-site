### Import Order

```typescript
// 1. React and external libraries
import React, { useState, useEffect } from 'react';
import { motion } from 'framer-motion';

// 2. Types
import type { LotusNode, Language } from '@/types';

// 3. Context and hooks
import { useNavigation } from '@/context/NavigationContext';
