---
import '../../styles/global.css';
import CalloutLink from '../../components/CalloutLink.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <title>Record not transferred — ODA.dream</title>
    <meta
      name="description"
      content="This archived ODA.dream record has not been transferred to the new public site."
    />
    <link rel="canonical" href="https://odadream.art/legacy/unavailable/" />
  </head>
  <body>
    <main class="shell page-intro">
      <p class="eyebrow">ODA.DREAM / LEGACY RECORD</p>
      <h1>Record not transferred</h1>
      <p class="lead mt-5">
        This archived record has not been selected for the new public site. It has not been silently replaced
        with another project.
      </p>
      <p class="small-note mt-5">
        Legacy ID: <code id="legacy-id">unknown</code>
      </p>
      <div class="link-row mt-6">
        <CalloutLink class="legacy-works-link" href="/en/works/">
          Explore works
        </CalloutLink>
        <CalloutLink class="legacy-contact-link" href="/en/contact/">
          Ask the studio
        </CalloutLink>
      </div>
    </main>
    <script is:inline>
      const params = new URLSearchParams(location.search);
      const id = params.get('id');
      const output = document.querySelector('#legacy-id');
      if (output) output.textContent = id || 'unknown';
      if (params.get('lang') === 'ru') {
        document.documentElement.lang = 'ru';
        const heading = document.querySelector('h1');
        const lead = document.querySelector('.lead');
        document.title = 'Запись не перенесена — ODA.dream';
        const works = document.querySelector('.legacy-works-link');
        const contact = document.querySelector('.legacy-contact-link');
        if (works) {
          works.href = '/ru/works/';
          works.textContent = 'Посмотреть работы';
        }
        if (contact) {
          contact.href = '/ru/contact/';
          contact.textContent = 'Связаться со студией';
        }
        if (heading) heading.textContent = 'Запись не перенесена';
        if (lead)
          lead.textContent =
            'Эта архивная запись пока не выбрана для нового публичного сайта. Мы не заменили её молча другим проектом.';
      }
    </script>
  </body>
</html>
