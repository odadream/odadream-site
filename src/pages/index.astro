---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageView from '../components/PageView.astro';
import { pages } from '../lib/routes';
const page = pages.find((item) => item.path === '/en/')!;
---

<BaseLayout page={page} canonicalPath="/en/">
  <script is:inline>
    const params = new URLSearchParams(location.search);
    if (params.has('id')) {
      const lang = params.get('lang') === 'ru' ? 'ru' : 'en';
      location.replace('/legacy/unavailable/?lang=' + lang);
    }
  </script>
  <PageView page={page} />
</BaseLayout>
