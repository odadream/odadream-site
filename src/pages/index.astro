---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageView from '../components/PageView.astro';
import { pages } from '../lib/routes';
const page = pages.find((item) => item.path === '/en/')!;
---

<BaseLayout page={page} canonicalPath="/en/">
  <script is:inline>
    const params = new URLSearchParams(location.search);
    if (params.has('id')) {
      const id = params.get('id') || '';
      const lang = params.get('lang') === 'ru' ? 'ru' : 'en';
      const fallback = '/legacy/unavailable/?id=' + encodeURIComponent(id) + '&lang=' + lang;
      fetch('/legacy-map.json')
        .then((response) => {
          if (!response.ok) throw new Error('Legacy map unavailable');
          return response.json();
        })
        .then((routes) => location.replace(routes[id]?.[lang === 'ru' ? 1 : 0] || fallback))
        .catch(() => location.replace(fallback));
    }
  </script>
  <PageView page={page} />
</BaseLayout>
