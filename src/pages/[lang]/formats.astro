---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegacyNotice from '../../components/LegacyNotice.astro';
import type { Lang } from '../../data/site';
export function getStaticPaths() {
  return ['en', 'ru'].map((lang) => ({ params: { lang } }));
}
const lang: Lang = Astro.params.lang === 'ru' ? 'ru' : 'en';
const page = {
  lang,
  kind: 'education' as const,
  family: 'E' as const,
  path: `/${lang}/formats/`,
  title: lang === 'ru' ? 'Сайт обновился — ODA.dream' : 'The site has changed — ODA.dream',
  description:
    lang === 'ru'
      ? 'Структура сайта изменилась. Перейдите на главную ODA.dream.'
      : 'The site structure has changed. Continue to the ODA.dream home page.',
};
---

<BaseLayout page={page} noindex>
  <LegacyNotice lang={lang} />
</BaseLayout>
