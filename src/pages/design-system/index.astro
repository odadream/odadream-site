---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import WorkCard from '../../components/WorkCard.astro';
import { minddbSnapshot, works } from '../../data/site';
import '../../styles/design-system.css';
const page = {
  lang: 'ru' as const,
  kind: 'home' as const,
  path: '/ru/design-system/',
  title: 'Дизайн-система V5 → V2 — ODA.dream',
  description: 'Рабочая спецификация визуального языка ODA.dream.',
};
const sections = [
  ['01', 'Основание'],
  ['02', 'Типографика'],
  ['03', 'Ритм и сетка'],
  ['04', 'Навигация и действия'],
  ['05', 'Материал и карточки'],
  ['06', 'Речь, медиа и состояния'],
  ['07', 'Документация'],
  ['08', 'Бренд'],
  ['09', 'Hero · движущееся медиа'],
];
---

<BaseLayout page={page} canonicalPath="/design-system/" noindex>
  <div class="shell system-page">
    <section class="system-intro system-grid">
      <div class="section-label">
        <span class="index">DS</span>
        <span class="eyebrow">ODA.DREAM / V5 → V2</span>
      </div>
      <div>
        <h1>Система, в которой работа остаётся главным событием.</h1>
        <p class="lead">
          Рабочий стенд утверждённого визуального языка. Примеры ниже используют те же токены и компоненты,
          что и публичные страницы. Новые паттерны главной дополняют систему, не заменяя её.
        </p>
        <nav class="system-index" aria-label="Разделы дизайн-системы">
          {sections.map(([n, label]) => (
            <a href={`#system-${n}`}>{label}</a>
          ))}
        </nav>
        <p class="eyebrow system-stamp">ARTISTIC MATERIAL FIRST · UI AS DOCUMENTATION · 2026</p>
      </div>
    </section>

    <section class="system-grid system-section" id="system-01">
      <aside class="system-side">
        <div class="section-label">
          <span class="index">01</span>
          <span class="eyebrow">Основание</span>
        </div>
        <p>Палитра разделяет материал, интерфейс и статус. Зелёный — точный сигнал, не декоративный цвет.</p>
      </aside>
      <div class="system-content">
        <p class="system-lede">
          Три плана задают глубину: фон страницы, поверхность чтения, поднятый материал. Изображение остаётся
          главным визуальным акцентом.
        </p>
        <div class="swatch-grid">
          <div class="swatch swatch-back">
            <span>PLANE / BACK</span>
            <strong>#111110</strong>
          </div>
          <div class="swatch swatch-middle">
            <span>PLANE / MIDDLE</span>
            <strong>#1b1a18</strong>
          </div>
          <div class="swatch swatch-front">
            <span>PLANE / FRONT</span>
            <strong>#23211e</strong>
          </div>
          <div class="swatch swatch-ink">
            <span>INK</span>
            <strong>#f3f1ec</strong>
          </div>
          <div class="swatch swatch-muted">
            <span>MUTED</span>
            <strong>#aaa79f</strong>
          </div>
          <div class="swatch swatch-accent">
            <span>SIGNAL</span>
            <strong>#00d884</strong>
          </div>
          <div class="swatch swatch-alert">
            <span>ALERT</span>
            <strong>#efb452</strong>
          </div>
          <div class="swatch swatch-danger">
            <span>ERROR</span>
            <strong>#df716b</strong>
          </div>
        </div>
        <div class="plane-demo">
          <span>CANVAS</span>
          <div>
            SURFACE<div>FOREGROUND MATERIAL</div>
          </div>
        </div>
      </div>
    </section>

    <section class="system-grid system-section" id="system-02">
      <aside class="system-side">
        <div class="section-label">
          <span class="index">02</span>
          <span class="eyebrow">Типографика</span>
        </div>
        <p>
          JetBrains Mono — основной текст, подписи, документация. Manrope — заголовки и короткие
          художественные высказывания.
        </p>
      </aside>
      <div class="system-content">
        <div class="type-row">
          <span class="eyebrow">T1 / PAGE / MANROPE</span>
          <p class="type-h1">Состояние человека как художественный материал.</p>
        </div>
        <div class="type-row">
          <span class="eyebrow">T2 / SECTION / MANROPE</span>
          <h2>Форма предшествует технологии.</h2>
        </div>
        <div class="type-row">
          <span class="eyebrow">BODY / JETBRAINS MONO</span>
          <p>
            Биологическая обратная связь — художественный медиум. Человек видит ответ среды и выбирает, как
            участвовать. Human state becomes material, not a diagnosis.
          </p>
        </div>
        <div class="type-row">
          <span class="eyebrow">CYRILLIC + LATIN PROOF</span>
          <p class="font-proof">Ёж, Йога, Щука, ъ ь ы э ю я / ODA.dream · 2019–2026 · EEG → image</p>
        </div>
        <p class="small-note">
          Кегли страницы: 32–48 px; секции: 26–42 px; основной текст: 15–16 px; метаданные: 11–12 px.
          Межбуквенный интервал применяется к метаданным, не к абзацам.
        </p>
      </div>
    </section>

    <section class="system-grid system-section" id="system-03">
      <aside class="system-side">
        <div class="section-label">
          <span class="index">03</span>
          <span class="eyebrow">Ритм и сетка</span>
        </div>
        <p>
          Единица — 4 px. Группировка создаётся интервалами и тональными поверхностями; не каждая секция
          нуждается в линии.
        </p>
      </aside>
      <div class="system-content">
        <div class="scale-list">
          <div>
            <span>LABEL</span>
            <strong>12 px</strong>
          </div>
          <div>
            <span>COPY</span>
            <strong>16 px</strong>
          </div>
          <div>
            <span>GROUP</span>
            <strong>32 px</strong>
          </div>
          <div>
            <span>BLOCK</span>
            <strong>48 px</strong>
          </div>
          <div>
            <span>SECTION</span>
            <strong>80 / 48 px</strong>
          </div>
          <div>
            <span>GUTTER</span>
            <strong>40 / 16 px</strong>
          </div>
        </div>
        <div class="line-demo">
          <p>
            <span class="eyebrow">Без линии</span> Разделы отделяет пространство.
          </p>
          <p>
            <span class="eyebrow">Тихая линия</span> Только ряды данных и внутренние таблицы.
          </p>
          <p>
            <span class="eyebrow">Сильная линия</span> Рамка действия или ошибки, не орнамент.
          </p>
        </div>
        <p class="small-note">
          Контейнер — до 1360 px. На узких экранах один поток без горизонтального прокручивания.
        </p>
      </div>
    </section>

    <section class="system-grid system-section" id="system-04">
      <aside class="system-side">
        <div class="section-label">
          <span class="index">04</span>
          <span class="eyebrow">Навигация и действия</span>
        </div>
        <p>
          Одна роль — один отклик. Ссылка видна в покое; кнопка обозначает действие; статус не выглядит
          кликабельным.
        </p>
      </aside>
      <div class="system-content">
        <p class="component-title">Меню · neutral / active</p>
        <nav class="menu-sample" aria-label="Пример меню">
          <a href="/ru/">Главная</a>
          <a href="/ru/works/" aria-current="page">
            Работы
          </a>
          <a href="/ru/cases/">Кейсы</a>
          <a href="/ru/contact/">Контакт</a>
        </nav>
        <div class="component-pair">
          <div>
            <p class="component-title">Редакционные ссылки</p>
            <a class="quiet-link" href="/ru/works/interference-of-realities/">
              Документация работы ↗
            </a>
            <br />
            <a class="quiet-link" href="/ru/works/">
              Вернуться к работам ↗
            </a>
          </div>
          <div>
            <p class="component-title">Кнопки и статус</p>
            <button class="button primary" type="button" data-design-lightbox>
              Открыть медиа
            </button>{' '}
            <button class="button secondary" type="button" disabled>
              PDF не приложен
            </button>{' '}
            <button class="button" type="button" disabled>
              Недоступно
            </button>
            <p class="status-row">
              <span class="status" data-status="premiered">
                Премьера
              </span>
              <span class="status" data-status="archive">
                Архив
              </span>
              <span class="status" data-status="research">
                R&amp;D
              </span>
            </p>
          </div>
        </div>
        <p class="small-note">
          Tap-target ≥ 44 × 44 px. Для клавиатуры есть видимый focus. Disabled — не ссылка. Навигация и
          карточки не подчёркиваются.
        </p>
      </div>
    </section>

    <section class="system-grid system-section" id="system-05">
      <aside class="system-side">
        <div class="section-label">
          <span class="index">05</span>
          <span class="eyebrow">Материал и карточки</span>
        </div>
        <p>Карточка ведёт к работе. Медиа впереди; название, статус и описание образуют компактную группу.</p>
      </aside>
      <div class="system-content">
        <div class="work-grid">
          {works.slice(0, 2).map((item) => (
            <WorkCard item={item} lang="ru" eager />
          ))}
        </div>
        <p class="small-note">
          Видео-превью загружается только при взаимодействии и при разрешённом движении. При отсутствии
          документального видео сохраняется изображение; анимация изображения не выдаётся за запись работы.
        </p>
        <p class="component-title">Медиа + подпись + источник</p>
        <MediaFigure id="interference-stage" lang="ru" priority />
      </div>
    </section>

    <section class="system-grid system-section" id="system-06">
      <aside class="system-side">
        <div class="section-label">
          <span class="index">06</span>
          <span class="eyebrow">Речь, медиа и состояния</span>
        </div>
        <p>
          Цитата — художественное высказывание, не отзыв. Ошибка объясняет состояние и путь восстановления.
        </p>
      </aside>
      <div class="system-content">
        <blockquote class="quote">
          Данные здесь не объясняют человека — они становятся материалом для переживания и разговора.
        </blockquote>
        <p class="caption">ODA.dream · метод студии</p>
        <div class="gallery-demo">
          <MediaFigure id="interference-stage" lang="ru" priority />
          <MediaFigure id="schrodinger" lang="ru" priority />
        </div>
        <div class="error-sample">
          <div>
            <strong>Материал временно недоступен</strong>
            <p>Файл не найден в архиве. Описание работы и связанные документы остаются доступны.</p>
          </div>
          <a class="quiet-link" href="/ru/works/interference-of-realities/">
            К документации ↗
          </a>
        </div>
        <p class="small-note">
          Lightbox: Escape, возврат фокуса, подпись и alt. Видео: poster, muted preview, без обязательного
          autoplay и с reduced-motion.
        </p>
      </div>
    </section>

    <section class="system-grid system-section" id="system-07">
      <aside class="system-side">
        <div class="section-label">
          <span class="index">07</span>
          <span class="eyebrow">Документация</span>
        </div>
        <p>
          Работа, событие, источник, роль организации и благодарность — разные записи. Не подтверждать факт
          отсутствующим документом.
        </p>
      </aside>
      <div class="system-content record-grid">
        <article>
          <span class="component-title">Событие / показ</span>
          <h3>Интерференция реальностей</h3>
          <dl>
            <dt>Дата</dt>
            <dd>16 мая 2026</dd>
            <dt>Место</dt>
            <dd>Инновационный культурный центр, Калуга</dd>
            <dt>Контекст</dt>
            <dd>«Циолковский фест»</dd>
          </dl>
          <a class="quiet-link" href="/ru/cases/tsiolkovsky-festival-2026/">
            Кейс и источники ↗
          </a>
        </article>
        <article>
          <span class="component-title">Статус / доступность</span>
          <h3>Разные утверждения</h3>
          <p>
            <span class="status" data-status="presented">
              Показ состоялся
            </span>
          </p>
          <p>
            <span class="status" data-status="archive">
              Не в репертуаре
            </span>
          </p>
          <p class="small-note">
            Реализация не означает доступность для заказа. Условия следующего показа указываются отдельно.
          </p>
        </article>
        <article>
          <span class="component-title">Благодарность / образец</span>
          <h3>Документ пока не приложен</h3>
          <p>
            Для публикации письма нужны автор, дата, связанное событие, оригинал и разрешение. Этот образец не
            является отзывом.
          </p>
        </article>
        <article>
          <span class="component-title">Метод / ограничение</span>
          <h3>Без ложного обещания</h3>
          <p>
            ЭЭГ и биологическая обратная связь входят в художественную партитуру. Визуализация не является
            точным прочтением мыслей или чувств.
          </p>
        </article>
      </div>
    </section>

    <section class="system-grid system-section" id="system-08">
      <aside class="system-side">
        <div class="section-label">
          <span class="index">08</span>
          <span class="eyebrow">Бренд</span>
        </div>
        <p>
          Знак и контур мозга имеют собственное свободное поле. Они не заменяют авторство и источники
          документации.
        </p>
      </aside>
      <div class="system-content">
        <div class="brand-demo">
          <figure>
            <img src="/brand/oda-logo.svg" alt="Логотип ODA.dream" />
          </figure>
          <figure>
            <img src="/brand/oda-brain.svg" alt="Фирменный контур мозга" />
          </figure>
        </div>
        <p class="small-note">
          Логотип в header: около 94 × 46 px. Свободное поле: 24 px. Контур мозга — одиночный мотив у раздела
          метода, а не повторяющийся фон.
        </p>
      </div>
    </section>
    <section class="system-grid system-section" id="system-09">
      <aside class="system-side">
        <div class="section-label">
          <span class="index">09</span>
          <span class="eyebrow">Hero · движущееся медиа</span>
        </div>
        <p>
          Видео — главный художественный материал, а не фон для рекламного заголовка. Короткое интро
          обозначает студию; этикетка и агрегаты остаются вторичными.
        </p>
      </aside>
      <div class="system-content">
        <div class="hero-specimen">
          <div
            class="hero-specimen__image"
            role="img"
            aria-label="Нейромандала: кадр из локального постера"
          />
          <div class="hero-specimen__copy">
            <span class="eyebrow">ODA.DREAM / NEUROMANDALA</span>
            <h2>Состояние человека — художественный материал.</h2>
          </div>
          <div class="hero-specimen__data">
            <span class="eyebrow">MINDDB / СНИМОК {minddbSnapshot.asOf}</span>
            <strong>{minddbSnapshot.takeCount.toLocaleString('ru-RU')} тейков</strong>
            <span>
              {minddbSnapshot.videoDurationHours} ч измеренной длительности · агрегат пока не опубликован
            </span>
          </div>
        </div>
        <p class="small-note">
          Паттерн использует hero-токены из <code>tokens.css</code>. Одно активное видео; poster — до запуска
          и при reduced-motion / экономии трафика. Выпуск требует проверки прав и приватности.
        </p>
      </div>
    </section>
    <p class="eyebrow system-end">
      Источник: утверждённая V5-спецификация · токены: src/styles/tokens.css · компоненты: рабочий сайт V2
    </p>
  </div>
  <script>
    document
      .querySelector('[data-design-lightbox]')
      ?.addEventListener('click', () =>
        document.querySelector<HTMLButtonElement>('.gallery-demo [data-lightbox]')?.click(),
      );
  </script>
</BaseLayout>
