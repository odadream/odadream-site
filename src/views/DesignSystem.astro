---
import DisclosureHeading from '../components/DisclosureHeading.astro';
import SourceLinks from '../components/SourceLinks.astro';
import type { PageFamily } from '../lib/page-codes';
import { chapterMarker } from '../lib/page-outline';
import { designCoverage, designPatterns } from '../lib/design-coverage';
import BaseLayout from '../layouts/BaseLayout.astro';
import DevNote from '../components/DevNote.astro';
import MediaGallery from '../components/MediaGallery.astro';
import GalleryStudy from '../components/GalleryStudy.astro';
import type { MediaItem } from '../lib/media-presentation';
import { mediaById } from '../data/catalogue';
import MediaFigure from '../components/MediaFigure.astro';
import VideoPreview from '../components/VideoPreview.astro';
import ProgrammeCard from '../components/ProgrammeCard.astro';
import ParticipationPanel from '../components/ParticipationPanel.astro';
import WorkCard from '../components/WorkCard.astro';
import CaseRow from '../components/CaseRow.astro';
import Chronology from '../components/Chronology.astro';
import SelectControl from '../components/SelectControl.astro';
import CaseArchive from '../components/CaseArchive.astro';
