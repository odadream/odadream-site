  <script>
    const updateTokenReadouts = () => {
      const computed = getComputedStyle(document.documentElement);
      document.querySelectorAll<HTMLElement>('[data-css-token]').forEach((node) => {
        node.textContent = computed.getPropertyValue(node.dataset.cssToken || '').trim();
      });
    };
    updateTokenReadouts();
    window.addEventListener('resize', updateTokenReadouts);
    new MutationObserver(updateTokenReadouts).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'class', 'style'],
    });
    document
      .querySelector('[data-design-lightbox]')
      ?.addEventListener('click', () =>
        document.querySelector<HTMLButtonElement>('.gallery-demo [data-lightbox]')?.click(),
      );
  </script>
