---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaGallery from '../components/MediaGallery.astro';
import type { MediaItem } from '../lib/media-presentation';
import { mediaById } from '../data/catalogue';
import MediaFigure from '../components/MediaFigure.astro';
import VideoPreview from '../components/VideoPreview.astro';
import ProgrammeCard from '../components/ProgrammeCard.astro';
import ParticipationPanel from '../components/ParticipationPanel.astro';
import WorkCard from '../components/WorkCard.astro';
import CaseRow from '../components/CaseRow.astro';
import RecognitionCard from '../components/RecognitionCard.astro';
import StatisticsStamp from '../components/StatisticsStamp.astro';
import MindDBStamp from '../components/MindDBStamp.astro';
import SectionRail from '../components/SectionRail.astro';
import RecordStamp from '../components/RecordStamp.astro';
import EditorialSections from '../components/EditorialSections.astro';
import DocumentList from '../components/DocumentList.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import EvidenceNote from '../components/EvidenceNote.astro';
import TechnicalMark from '../components/TechnicalMark.astro';
import CalloutLink from '../components/CalloutLink.astro';
import PageCode from '../components/PageCode.astro';
import {
  recognitions,
  works,
  cases,
  evidence,
  workDocuments,
  referenceDocuments,
  configurations,
  programmes,
} from '../data/site';
import { siteStats } from '../lib/site-stats';
import { navigationFor } from '../lib/routes';
import '../styles/design-system.css';
const page = {
  lang: 'ru' as const,
  kind: 'home' as const,
  family: 'D' as const,
  path: '/ru/design-system/',
  title: 'Дизайн-система V5 → V2 — ODA.dream',
  description: 'Рабочая спецификация визуального языка ODA.dream.',
};
const gallerySpecimens: MediaItem[] = [
  mediaById('emomandala-object')!,
  mediaById('rings')!,
  mediaById('neurobattle')!,
  {
    id: 'hse-document-specimen',
    src: recognitions[4].previewSrc!,
    kind: 'image',
    width: 659,
    height: 947,
    representation: 'document',
    alt: recognitions[4].title,
    caption: recognitions[4].claim,
  },
  mediaById('neuromandala-terra')!,
  mediaById('schrodinger-poster')!,
  mediaById('honors-scheme')!,
];
const sections = [
  ['Основание'],
  ['Типографика'],
  ['Ритм и сетка'],
  ['Навигация и действия'],
  ['Материал и карточки'],
  ['Речь, медиа и состояния'],
  ['Документация'],
  ['Бренд'],
  ['Hero · движущееся медиа'],
  ['Свет / тьма · данные и документы'],
  ['Поля · индексы · паспорта'],
];
const signalFamilies = [
  ['H', 'Главная', '--signal-home'],
  ['W', 'Работы', '--signal-works'],
  ['E', 'Образование', '--signal-education'],
  ['C', 'Сотрудничество', '--signal-cooperation'],
  ['S', 'Студия', '--signal-studio'],
  ['K', 'Кейсы', '--signal-cases'],
  ['N', 'Контакт', '--signal-contact'],
  ['M', 'Метод', '--signal-technology'],
  ['R', 'Признания', '--signal-recognition'],
  ['D', 'Дизайн-система', '--signal-design'],
];
const profileTokens = [
  ['--space-unit', 'Единица пространственного ритма'],
  ['--type-scale', 'Масштаб читаемой типографики'],
  ['--grid-rail', 'Поле документа'],
  ['--grid-gap', 'Расстояние между полем и материалом'],
  ['--page-inset', 'Общая внешняя ось, включая полноширинное видео'],
  ['--intro-space-start', 'Верхняя горизонталь вступления и hero'],
  ['--hero-edge-space', 'Общий нижний край этикетки и статистики hero'],
  ['--type-folio', 'Единый размер фонового номера на этом экране'],
  ['--reference-surface', 'Фон справочной статистики'],
  ['--reference-ink', 'Читаемые, но вторичные значения'],
  ['--type-stat', 'Размер справочного числа'],
  ['--weight-folio', 'Вес фоновой маркировки'],
  ['--folio-fill', 'Заливка номера на заднем плане'],
  ['--mark-size', 'Размер условного знака'],
  ['--mark-stroke', 'Толщина векторного штриха'],
  ['--tap-target', 'Минимальная цель нажатия'],
  ['--signal-home', 'Цвет кода главной страницы'],
  ['--signal-works', 'Цвет кода страницы работ'],
  ['--signal-education', 'Цвет кода образовательных страниц'],
  ['--signal-cooperation', 'Цвет кода страницы сотрудничества'],
  ['--signal-studio', 'Цвет кода страницы студии'],
  ['--signal-cases', 'Цвет кода страницы кейсов'],
  ['--signal-contact', 'Цвет кода страницы контактов'],
  ['--signal-technology', 'Цвет кода страницы метода'],
  ['--signal-recognition', 'Цвет кода страницы признаний'],
  ['--signal-design', 'Цвет кода дизайн-системы'],
];
---

<BaseLayout page={page} canonicalPath="/design-system/" noindex>
  <div class="shell system-page">
    <section class="system-intro system-grid">
      <div class="section-label">
        <PageCode family="D" section={0} lang="ru" />
        <span class="eyebrow">ODA.DREAM / V5 → V2</span>
      </div>
      <div>
        <h1>Система, в которой работа остаётся главным событием.</h1>
        <p class="lead">
          Рабочий стенд утверждённого визуального языка. Примеры ниже используют те же токены и компоненты,
          что и публичные страницы. Новые паттерны главной дополняют систему, не заменяя её.
        </p>
        <nav class="system-index" aria-label="Разделы дизайн-системы">
          {sections.map(([label], i) => (
            <a href={`#system-${String(i + 1).padStart(2, '0')}`}>{label}</a>
          ))}
        </nav>
        <p class="eyebrow system-stamp">ARTISTIC MATERIAL FIRST · UI AS DOCUMENTATION · 2026</p>
      </div>
    </section>

    <section class="system-grid system-section" id="system-01">
      <aside class="system-side">
        <div class="section-label">
          <PageCode family="D" section={1} lang="ru" />
          <span class="eyebrow">Основание</span>
        </div>
        <p>Палитра разделяет материал, интерфейс и статус. Зелёный — точный сигнал, не декоративный цвет.</p>
      </aside>
      <div class="system-content">
        <p class="system-lede">
          Три плана задают глубину: фон страницы, поверхность чтения, поднятый материал. Изображение остаётся
          главным визуальным акцентом.
        </p>
        <details class="token-profile">
          <summary>Параметры стилистического профиля</summary>
          <p class="small-note">
            Профиль → семантическая роль → компонент. Полный реестр: docs/DESIGN-TOKENS.md. Справочные числа
            принадлежат фону; их низкий приоритет задаётся тоном и масштабом, а не нечитаемостью.
          </p>
          <dl>
            {profileTokens.map(([token, purpose]) => (
              <div>
                <dt>
                  {purpose}
                  <code>{token}</code>
                </dt>
                <dd data-css-token={token}></dd>
              </div>
            ))}
          </dl>
        </details>
        <div class="swatch-grid">
          <div class="swatch swatch-back">
            <span>PLANE / BACK</span>
            <strong data-css-token="--plane-back"></strong>
          </div>
          <div class="swatch swatch-middle">
            <span>PLANE / MIDDLE</span>
            <strong data-css-token="--plane-middle"></strong>
          </div>
          <div class="swatch swatch-front">
            <span>PLANE / FRONT</span>
            <strong data-css-token="--plane-front"></strong>
          </div>
          <div class="swatch swatch-ink">
            <span>INK</span>
            <strong data-css-token="--ink"></strong>
          </div>
          <div class="swatch swatch-muted">
            <span>MUTED</span>
            <strong data-css-token="--muted"></strong>
          </div>
          <div class="swatch swatch-accent">
            <span>SIGNAL</span>
            <strong data-css-token="--accent"></strong>
          </div>
          <div class="swatch swatch-alert">
            <span>ALERT</span>
            <strong data-css-token="--alert"></strong>
          </div>
          <div class="swatch swatch-danger">
            <span>ERROR</span>
            <strong data-css-token="--danger"></strong>
          </div>
        </div>
        <div class="signal-key" aria-label="Цветовая кодировка страниц">
          {signalFamilies.map(([code, label, token]) => (
            <div class="signal-key__entry" data-signal={code}>
              <code>{code}</code>
              <span>{label}</span>
              <i aria-hidden="true"></i>
              <code data-css-token={token}></code>
            </div>
          ))}
        </div>
        <div class="plane-demo">
          <span>CANVAS</span>
          <div>
            SURFACE<div>FOREGROUND MATERIAL</div>
          </div>
        </div>
        <p class="system-lede">
          Шапка и раскрытая навигация используют FOREGROUND MATERIAL: сплошную плоскость и мягкую тень.
          Градиентной полосы под ними нет.
        </p>
      </div>
    </section>

    <section class="system-grid system-section" id="system-02">
      <aside class="system-side">
        <div class="section-label">
          <PageCode family="D" section={2} lang="ru" />
          <span class="eyebrow">Типографика</span>
        </div>
        <p>
          JetBrains Mono — основной текст, подписи, документация. Manrope — заголовки и короткие
          художественные высказывания.
        </p>
      </aside>
      <div class="system-content">
        <div class="type-row">
          <span class="eyebrow">T1 / PAGE / MANROPE</span>
          <p class="type-h1">Состояние человека как художественный материал.</p>
        </div>
        <div class="type-row">
          <span class="eyebrow">T2 / SECTION / MANROPE</span>
          <h2>Форма предшествует технологии.</h2>
        </div>
        <div class="type-row">
          <span class="eyebrow">BODY / JETBRAINS MONO</span>
          <p>
            Биологическая обратная связь — художественный медиум. Человек видит ответ среды и выбирает, как
            участвовать. Human state becomes material, not a diagnosis.
          </p>
        </div>
        <div class="type-row">
          <span class="eyebrow">CYRILLIC + LATIN PROOF</span>
          <p class="font-proof">Ёж, Йога, Щука, ъ ь ы э ю я / ODA.dream · 2019–2026 · EEG → image</p>
        </div>
        <p class="small-note">
          Кегли страницы: 32–48 px; секции: 26–42 px; основной текст: 15–16 px; метаданные: 11–12 px.
          Межбуквенный интервал применяется к метаданным, не к абзацам.
        </p>
      </div>
    </section>

    <section class="system-grid system-section" id="system-03">
      <aside class="system-side">
        <div class="section-label">
          <PageCode family="D" section={3} lang="ru" />
          <span class="eyebrow">Ритм и сетка</span>
        </div>
        <p>
          Единица — 4 px. Группировка создаётся интервалами и тональными поверхностями; не каждая секция
          нуждается в линии.
        </p>
      </aside>
      <div class="system-content">
        <h2>Метка на поле, материал на общей оси</h2>
        <p>
          Метка привязана к первой строке заголовка оптически, а не к центру всей секции. Фон панели выступает
          наружу; заголовок, текст, список и паспорт начинают на одной оси. На телефоне метка предшествует
          материалу в одном потоке.
        </p>
        <article class="list-row" id="system-narrative-row">
          <div>
            <h3>Текстовая строка без отдельной даты</h3>
            <p>
              Единственный блок занимает доступную колонку. Длина абзаца ограничена шириной чтения, а не
              пустыми колонками для отсутствующих даты и действия.
            </p>
            <CalloutLink href="/ru/cooperation/">Сценарии сотрудничества</CalloutLink>
          </div>
        </article>
        <h3>Список после заголовка</h3>
        <ul class="facts" id="system-facts">
          <li>Интервал перед списком равен интервалу между остальными блоками содержания.</li>
          <li>
            Длинный пункт переносится по оси текста; маркер остаётся слева. Список может содержать
            <strong>выделение</strong> и обычные ссылки внутри пункта.
          </li>
        </ul>
        <article class="list-row" id="system-metadata-row">
          <span class="meta">2026-10-06</span>
          <div>
            <h3>Запись с датой и действием</h3>
            <p>Отдельные реквизиты получают свои колонки; на телефоне следуют в одном потоке.</p>
          </div>
          <CalloutLink href="/ru/cases/">Кейсы</CalloutLink>
        </article>
        <div class="scale-list">
          <div>
            <span>LABEL</span>
            <strong>12 px</strong>
          </div>
          <div>
            <span>COPY</span>
            <strong>16 px</strong>
          </div>
          <div>
            <span>GROUP</span>
            <strong>32 px</strong>
          </div>
          <div>
            <span>BLOCK</span>
            <strong>48 px</strong>
          </div>
          <div>
            <span>SECTION</span>
            <strong>80 / 48 px</strong>
          </div>
          <div>
            <span>GUTTER</span>
            <strong>40 / 16 px</strong>
          </div>
        </div>
        <p class="small-note">
          Одна внешняя ось: шапка → текст hero → секции → выходные данные → футер. Одна внутренняя ось:
          заголовки, текст и медиа. Фон панели выступает за ось, но не сдвигает содержание. Номера одинакового
          размера в каждом viewport; на телефоне поля скрыты. Сетка и интервалы стенда совпадают с сайтом.
        </p>
        <div class="line-demo">
          <p>
            <span class="eyebrow">Без линии</span> Разделы отделяет пространство.
          </p>
          <p>
            <span class="eyebrow">Тихая линия</span> Только ряды данных и внутренние таблицы.
          </p>
          <p>
            <span class="eyebrow">Сильная линия</span> Рамка действия или ошибки, не орнамент.
          </p>
        </div>
        <p class="small-note">
          Контейнер — до 1360 px. На узких экранах один поток без горизонтального прокручивания.
        </p>
      </div>
    </section>

    <section class="system-grid system-section" id="system-04">
      <aside class="system-side">
        <div class="section-label">
          <PageCode family="D" section={4} lang="ru" />
          <span class="eyebrow">Навигация и действия</span>
        </div>
        <p>
          Одна роль — один отклик. Ссылка видна в покое; кнопка обозначает действие; статус не выглядит
          кликабельным.
        </p>
      </aside>
      <div class="system-content">
        <p class="component-title">Меню · neutral / active</p>
        <nav class="menu-sample" aria-label="Пример меню">
          {navigationFor('ru').map(({ label, href, family, route }) => (
            <a href={href} aria-current={route === 'works' ? 'page' : undefined}>
              <PageCode family={family} lang="ru" register={false} />
              {label}
            </a>
          ))}
        </nav>
        <p class="small-note">
          Все девять обзорных разделов берутся из реестра маршрутов. До 1600 px меню раскрывается кнопкой;
          длинный список прокручивается внутри доступной высоты экрана. D / Система доступен только в dev.
        </p>
        <div class="component-pair">
          <div>
            <p class="component-title">Редакционные ссылки</p>
            <CalloutLink href="/ru/works/">Работы</CalloutLink>
            <br />
            <CalloutLink href="/ru/works/">
              Документация премьерного показа и исследования восприятия зрителей
            </CalloutLink>
            <br />
            <CalloutLink href="/en/works/">
              Typography, imagery and underlying project documentation
            </CalloutLink>
            <br />
            <CalloutLink href="/ru/works/interference-of-realities/">Документация работы</CalloutLink>
            <br />
            <CalloutLink href="/ru/works/">Вернуться к работам</CalloutLink>
          </div>
          <div>
            <p class="component-title">Кнопки и статус</p>
            <button class="button primary" type="button" data-design-lightbox>
              Открыть медиа
            </button>{' '}
            <button class="button secondary" type="button" disabled>
              PDF не приложен
            </button>{' '}
            <button class="button" type="button" disabled>
              Недоступно
            </button>
            <p class="status-row">
              <span class="status" data-status="realized">
                Реализовано
              </span>
              <span class="status" data-status="prototype">
                Прототип
              </span>
              <span class="status" data-status="concept">
                Концепция
              </span>
            </p>
          </div>
        </div>
        <p class="small-note">
          Tap-target ≥ 44 × 44 px. Для клавиатуры есть видимый focus. Disabled — не ссылка. Навигация и
          карточки не подчёркиваются. Одна focus-обводка действует также для summary и полей ввода; якоря
          учитывают высоту шапки. Вторичное действие имеет сплошную тихую рамку, не пунктир.
        </p>
      </div>
    </section>

    <section class="system-grid system-section" id="system-05">
      <aside class="system-side">
        <div class="section-label">
          <PageCode family="D" section={5} lang="ru" />
          <span class="eyebrow">Материал и карточки</span>
        </div>
        <p>Карточка ведёт к работе. Медиа впереди; название, статус и описание образуют компактную группу.</p>
      </aside>
      <div class="system-content">
        <div class="work-grid">
          {works
            .filter((item) => ['rings', 'emomandala', 'sync', 'ancestors'].includes(item.id))
            .map((item) => (
              <WorkCard item={item} lang="ru" eager />
            ))}
        </div>
        <p class="small-note">
          В одном ряду карточки разделяют четыре строки: медиа, метаданные, название, описание. Длинная
          категория расширяет строку у обеих карточек: текст не обрезается и не подгоняется вручную.
        </p>
        <p class="small-note">
          Видео-превью загружается только при взаимодействии и при разрешённом движении. При отсутствии
          документального видео сохраняется изображение; анимация изображения не выдаётся за запись работы.
        </p>
        <p class="small-note">
          Адрес ограничен двумя уровнями: <code>W</code> — страница, <code>W.01</code> — раздел. Карточки не
          получают порядковых кодов: их отличают название, категория, дата и статус.
        </p>
        <p class="small-note">
          Документ — подборка целых страниц WebP с общим увеличением. Исходный PDF доступен отдельно;
          извлечённые текстовые копии остаются в служебном кеше и не публикуются автоматически.
        </p>
        <DocumentList documents={workDocuments} lang="ru" />
        <DocumentList
          documents={referenceDocuments.filter(
            (row) => row.kind === 'technical-overview' && row.language === 'ru',
          )}
          lang="ru"
          title="Технический обзор · 6 октября 2026"
        />
        <DocumentList
          documents={referenceDocuments.filter((row) => row.kind === 'cv' && row.language === 'ru')}
          lang="ru"
          title="CV авторов"
        />
        <p class="component-title">Медиа + подпись + источник</p>
        <MediaFigure id="interference-stage" lang="ru" priority />
      </div>
    </section>

    <section class="system-grid system-section" id="system-06">
      <aside class="system-side">
        <div class="section-label">
          <PageCode family="D" section={6} lang="ru" />
          <span class="eyebrow">Речь, медиа и состояния</span>
        </div>
        <p>
          Цитата — художественное высказывание, не отзыв. Ошибка объясняет состояние и путь восстановления.
        </p>
      </aside>
      <div class="system-content">
        <blockquote class="quote">
          Данные здесь не объясняют человека — они становятся материалом для переживания и разговора.
        </blockquote>
        <p class="caption">ODA.dream · метод студии</p>
        <div class="gallery-demo">
          <MediaFigure id="interference-stage" lang="ru" priority />
          <MediaFigure id="schrodinger" lang="ru" priority />
        </div>
        <div class="error-sample">
          <div>
            <strong>Материал временно недоступен</strong>
            <p>Файл не найден в архиве. Описание работы и связанные документы остаются доступны.</p>
          </div>
          <CalloutLink href="/ru/works/interference-of-realities/">К документации</CalloutLink>
        </div>
        <AnalyticsConsent lang="ru" specimen />
        <div class="video-preview-specimens">
          <VideoPreview
            src="/video/hero/terra-preview.mp4"
            poster="/video/hero/terra-poster.webp"
            alt="Терраформинг: первый кадр видеопревью"
