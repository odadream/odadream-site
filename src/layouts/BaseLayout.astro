---
import '../styles/global.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '@fontsource/jetbrains-mono/cyrillic-400.css';
import '@fontsource/jetbrains-mono/cyrillic-500.css';
import '@fontsource/jetbrains-mono/cyrillic-600.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-800.css';
import '@fontsource/manrope/cyrillic-500.css';
import { cases, mediaById, socialLinks, works } from '../data/site';
import { pairedPath, type Page } from '../lib/routes';
import RecordStamp from '../components/RecordStamp.astro';
import { familyByKind } from '../lib/page-codes';
import PageCode from '../components/PageCode.astro';
import lastmod from '../data/lastmod.json';
import astroPackage from 'astro/package.json';
interface Props {
  page: Page;
  canonicalPath?: string;
  noindex?: boolean;
}
const { page, canonicalPath = page.path, noindex = false } = Astro.props;
const site = 'https://odadream.art';
const canonical = new URL(canonicalPath, site).href;
const alternateEn = new URL(pairedPath(page.path, 'en'), site).href;
const alternateRu = new URL(pairedPath(page.path, 'ru'), site).href;
const nav =
  page.lang === 'en'
    ? [
        ['Works', 'works'],
        ['Formats', 'formats'],
        ['Cooperation', 'cooperation'],
        ['Studio', 'studio'],
        ['Cases', 'cases'],
        ['Contact', 'contact'],
      ]
    : [
        ['Работы', 'works'],
        ['Форматы', 'formats'],
        ['Сотрудничество', 'cooperation'],
        ['Студия', 'studio'],
        ['Кейсы', 'cases'],
        ['Контакт', 'contact'],
      ];
const navRoot = page.kind === 'work' ? 'works' : page.kind === 'case' ? 'cases' : page.kind;
const pageSection = page.family === 'D' ? 'design' : navRoot;
const contentDate = lastmod[page.path as keyof typeof lastmod];
const record =
  page.kind === 'work'
    ? works.find((item) => item.slug === page.slug)
    : page.kind === 'case'
      ? cases.find((item) => item.slug === page.slug)
      : undefined;
const ogMedia = mediaById(record?.media[0] ?? 'interference-stage');
const schema =
  page.kind === 'home' || page.kind === 'studio'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'ODA.dream',
        url: site,
        description: page.description,
        founder: [
          { '@type': 'Person', name: 'Olga Arabova' },
          { '@type': 'Person', name: 'Daler Arabov' },
        ],
      }
    : page.kind === 'work'
      ? {
          '@context': 'https://schema.org',
          '@type': 'CreativeWork',
          name: page.title.replace(' — ODA.dream', ''),
          description: page.description,
          url: canonical,
          creator: { '@type': 'Organization', name: 'ODA.dream' },
        }
      : null;
const crumbs = page.path.split('/').filter(Boolean);
const crumbNames: Record<string, string> =
  page.lang === 'en'
    ? {
        en: 'Home',
        works: 'Works',
        formats: 'Formats',
        cooperation: 'Cooperation',
        studio: 'Studio',
        cases: 'Cases',
        contact: 'Contact',
        technology: 'Neuromandala',
        recognition: 'Recognition',
      }
    : {
        ru: 'Главная',
        works: 'Работы',
        formats: 'Форматы',
        cooperation: 'Сотрудничество',
        studio: 'Студия',
        cases: 'Кейсы',
        contact: 'Контакт',
        technology: 'Нейромандала',
        recognition: 'Признания',
      };
const breadcrumbSchema =
  crumbs.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((part, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: i === crumbs.length - 1 ? page.title.replace(' — ODA.dream', '') : (crumbNames[part] ?? part),
          item: new URL(`/${crumbs.slice(0, i + 1).join('/')}/`, site).href,
        })),
      }
    : null;
---

<!doctype html>
<html lang={page.lang} data-section={pageSection} data-page-family={page.family}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#23211e" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('oda-theme');
          const mode = saved === 'light' || saved === 'dark' ? saved : 'auto';
          const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.themeMode = mode;
          document.documentElement.dataset.theme = mode === 'auto' ? (systemDark ? 'dark' : 'light') : mode;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute(
              'content',
              document.documentElement.dataset.theme === 'light' ? '#faf7f0' : '#23211e',
            );
        } catch {
          document.documentElement.dataset.themeMode = 'auto';
          document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute(
              'content',
              document.documentElement.dataset.theme === 'light' ? '#faf7f0' : '#23211e',
            );
        }
      })();
    </script>
    <link rel="icon" href="/brand/oda-brain.svg" type="image/svg+xml" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={canonical} />
    {!noindex && (
      <>
        <link rel="alternate" hreflang="en" href={alternateEn} />
        <link rel="alternate" hreflang="ru" href={alternateRu} />
        <link rel="alternate" hreflang="x-default" href={alternateEn} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content={page.kind === 'work' || page.kind === 'case' ? 'article' : 'website'} />
    <meta property="og:site_name" content="ODA.dream" />
    <meta property="og:locale" content={page.lang === 'en' ? 'en_US' : 'ru_RU'} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    {ogMedia && (
      <>
        <meta property="og:image" content={new URL(ogMedia.src, site).href} />
        <meta property="og:image:alt" content={ogMedia.alt[page.lang]} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {page.lang === 'en' ? 'Skip to content' : 'К содержимому'}
    </a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={`/${page.lang}/`} aria-label="ODA.dream — home">
          <img src="/brand/oda-logo.svg" alt="ODA.dream" width="112" height="52" />
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label={page.lang === 'en' ? 'Open menu' : 'Открыть меню'}
        >
          ☰
        </button>
        <nav
          id="site-nav"
          class="site-nav"
          aria-label={page.lang === 'en' ? 'Main navigation' : 'Основная навигация'}
        >
          {nav.map(([label, route]) => (
            <a
              href={`/${page.lang}/${route}/`}
              data-route={route}
              aria-current={navRoot === route ? 'page' : undefined}
            >
              <PageCode
                family={familyByKind[route as keyof typeof familyByKind]}
                lang={page.lang}
                register={false}
              />
              {label}
            </a>
          ))}
          {import.meta.env.DEV && (
            <a
              href="/design-system/"
              data-route="design"
              aria-current={pageSection === 'design' ? 'page' : undefined}
            >
              <PageCode family="D" lang={page.lang} register={false} />
              {page.lang === 'ru' ? 'Система' : 'System'}
            </a>
          )}
        </nav>
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          aria-label={page.lang === 'ru' ? 'Тема: автоматически' : 'Theme: automatic'}
          title={page.lang === 'ru' ? 'Сменить тему' : 'Change theme'}
        >
          <span aria-hidden="true">◐</span>
          <span data-theme-label>{page.lang === 'ru' ? 'Авто' : 'Auto'}</span>
        </button>
        {page.path !== '/ru/design-system/' && (
          <a
            class="language-link"
            href={pairedPath(page.path, page.lang === 'en' ? 'ru' : 'en')}
            lang={page.lang === 'en' ? 'ru' : 'en'}
            aria-label={page.lang === 'en' ? 'Русская версия' : 'English version'}
          >
            {page.lang === 'en' ? 'RU' : 'EN'}
          </a>
        )}
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      {!noindex && (
        <div class="shell site-colophon">
          <RecordStamp
            title={page.lang === 'ru' ? 'Выходные данные' : 'Document details'}
            wide
            fields={[
              {
                label: page.lang === 'ru' ? 'Обновление содержания' : 'Content updated',
                value: contentDate || '—',
              },
              { label: page.lang === 'ru' ? 'Движок' : 'Engine', value: `Astro ${astroPackage.version}` },
            ]}
          >
            <Fragment slot="fields-after">
              <div>
                <dt>
                  {page.lang === 'ru'
                    ? 'Предыдущее посещение · это устройство'
                    : 'Previous visit · this device'}
                </dt>
                <dd data-previous-visit>—</dd>
              </div>
              <div>
                <dt>{page.lang === 'ru' ? 'Ссылка на страницу' : 'Page link'}</dt>
                <dd>
                  <button class="colophon-copy" type="button" data-copy-page-link>
                    {page.lang === 'ru' ? 'Копировать ссылку' : 'Copy page link'}
                  </button>
                  <span role="status" data-copy-status></span>
                  <input
                    class="colophon-url"
                    data-copy-fallback
                    hidden
                    readonly
                    aria-label={
                      page.lang === 'ru' ? 'Скопируйте адрес вручную' : 'Copy this address manually'
                    }
                  />
                </dd>
              </div>
            </Fragment>
          </RecordStamp>
        </div>
      )}
      <div class="shell footer-inner">
        <div>
          <span class="eyebrow">ODA.DREAM / 2026</span>
          <p>
            {page.lang === 'en'
              ? 'Human state as artistic material.'
              : 'Состояние человека как художественный материал.'}
          </p>
        </div>
        <div class="footer-links">
          <a href={`/${page.lang}/contact/`}>{page.lang === 'en' ? 'Contact' : 'Контакт'}</a>
          <a href={`/${page.lang}/studio/`}>{page.lang === 'en' ? 'Studio' : 'Студия'}</a>
          <a href={`/${page.lang}/technology/`}>{page.lang === 'en' ? 'Neuromandala' : 'Нейромандала'}</a>
          <a href={`/${page.lang}/recognition/`}>{page.lang === 'en' ? 'Recognition' : 'Признания'}</a>
          {socialLinks
            .filter((item) => item.languages.includes(page.lang))
            .map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${item.label} — ODA.dream`}
              >
                <span class="social-icon" data-social-icon={item.id} aria-hidden="true">
                  {item.id === 'telegram' ? (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="m21 4-3.2 16-6-5.1-3.1 3 .6-5.6L19 6.1l-11 4.8-4.2-1.5L21 4Z" />
                    </svg>
                  ) : item.id === 'youtube' ? (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M21 8.1a2.7 2.7 0 0 0-1.9-1.9C17.4 5.8 12 5.8 12 5.8s-5.4 0-7.1.4A2.7 2.7 0 0 0 3 8.1a28 28 0 0 0-.4 3.9A28 28 0 0 0 3 16a2.7 2.7 0 0 0 1.9 1.9c1.7.4 7.1.4 7.1.4s5.4 0 7.1-.4A2.7 2.7 0 0 0 21 16a28 28 0 0 0 .4-4 28 28 0 0 0-.4-3.9Z" />
                      <path d="m10 15 5-3-5-3v6Z" />
                    </svg>
                  ) : item.id === 'instagram' ? (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle class="social-icon__dot" cx="17.7" cy="6.7" r=".8" />
                    </svg>
                  ) : (
                    <span>Д</span>
                  )}
                </span>
                <span>{item.label}</span>
              </a>
            ))}
        </div>
      </div>
    </footer>
    <dialog
      id="lightbox"
      class="lightbox"
      aria-label={page.lang === 'en' ? 'Image viewer' : 'Просмотр изображения'}
    >
      <button
        class="lightbox-close"
        type="button"
        aria-label={page.lang === 'en' ? 'Close image' : 'Закрыть изображение'}
      >
        ×
      </button>
      <img alt="" />
      <p class="lightbox-caption"></p>
    </dialog>
    <script>
      const ru = document.documentElement.lang === 'ru';
      const visit = document.querySelector<HTMLElement>('[data-previous-visit]');
      if (visit) {
        try {
          let previous = sessionStorage.getItem('oda-previous-visit');
          if (previous === null) {
            previous = localStorage.getItem('oda-last-visit') || 'first';
            sessionStorage.setItem('oda-previous-visit', previous);
            localStorage.setItem('oda-last-visit', new Date().toISOString());
          }
          const date = new Date(previous);
          visit.textContent =
            previous === 'first'
              ? ru
                ? 'Первое посещение'
                : 'First visit'
              : Number.isNaN(date.getTime())
                ? '—'
                : new Intl.DateTimeFormat(ru ? 'ru-RU' : 'en-GB', {
                    dateStyle: 'medium',
                    timeStyle: 'short',
                  }).format(date);
        } catch {
          visit.textContent = ru ? 'Не сохранено' : 'Not stored';
        }
      }
      document
        .querySelector<HTMLButtonElement>('[data-copy-page-link]')
        ?.addEventListener('click', async () => {
          const status = document.querySelector<HTMLElement>('[data-copy-status]');
          const fallback = document.querySelector<HTMLInputElement>('[data-copy-fallback]');
          try {
            await navigator.clipboard.writeText(window.location.href);
            if (status) {
              status.textContent = ru ? 'Ссылка скопирована' : 'Link copied';
            }
            if (fallback) fallback.hidden = true;
          } catch {
            if (status) {
              status.classList.remove('sr-only');
              status.textContent = ru ? 'Скопируйте адрес вручную' : 'Copy the address manually';
            }
            if (fallback) {
              fallback.hidden = false;
              fallback.value = window.location.href;
              fallback.focus();
              fallback.select();
            }
          }
        });
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-nav');
      const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const themeLabel = themeButton?.querySelector<HTMLElement>('[data-theme-label]');
      const themeNames =
        document.documentElement.lang === 'ru'
          ? { auto: 'Авто', light: 'Свет', dark: 'Тьма' }
          : { auto: 'Auto', light: 'Light', dark: 'Dark' };
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
      const updateThemeLabel = () => {
        const mode = (document.documentElement.dataset.themeMode || 'auto') as keyof typeof themeNames;
        if (themeLabel) themeLabel.textContent = themeNames[mode];
        themeButton?.setAttribute(
          'aria-label',
          `${document.documentElement.lang === 'ru' ? 'Тема' : 'Theme'}: ${themeNames[mode]}`,
        );
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute(
            'content',
            document.documentElement.dataset.theme === 'light' ? '#faf7f0' : '#23211e',
          );
      };
      updateThemeLabel();
      themeButton?.addEventListener('click', () => {
        const current = document.documentElement.dataset.themeMode || 'auto';
        const next = current === 'auto' ? 'light' : current === 'light' ? 'dark' : 'auto';
        document.documentElement.dataset.themeMode = next;
        document.documentElement.dataset.theme =
          next === 'auto' ? (systemTheme.matches ? 'dark' : 'light') : next;
        try {
          localStorage.setItem('oda-theme', next);
        } catch {
          /* private storage */
        }
        updateThemeLabel();
      });
      systemTheme.addEventListener('change', () => {
        if (document.documentElement.dataset.themeMode === 'auto') {
          document.documentElement.dataset.theme = systemTheme.matches ? 'dark' : 'light';
          updateThemeLabel();
        }
      });
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('open', open);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || menu?.getAttribute('aria-expanded') !== 'true') return;
        menu.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('open');
        menu.focus();
      });
      const dialog = document.querySelector<HTMLDialogElement>('#lightbox');
      const image = dialog?.querySelector<HTMLImageElement>('img');
      const caption = dialog?.querySelector<HTMLElement>('.lightbox-caption');
      let trigger: HTMLElement | null = null;
      document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((button) =>
        button.addEventListener('click', () => {
          trigger = button;
          if (image) {
            image.src = button.dataset.src || '';
            image.alt = button.dataset.alt || '';
          }
          if (caption) caption.textContent = button.dataset.caption || '';
          dialog?.showModal();
        }),
      );
      dialog
        ?.querySelector<HTMLButtonElement>('.lightbox-close')
        ?.addEventListener('click', () => dialog.close());
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog?.addEventListener('close', () => {
        if (image) image.src = '';
        trigger?.focus();
      });
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
        ?.saveData;
      const canMove = () => !reduceMotion.matches && !saveData;
      const playPreview = (video: HTMLVideoElement | null) => {
        if (!video || !canMove()) return;
        const source = video.querySelector<HTMLSourceElement>('source[data-src]');
        if (source && !source.src && source.dataset.src) {
          source.src = source.dataset.src;
          video.load();
        }
        if (!video.poster && video.dataset.poster) video.poster = video.dataset.poster;
        video.preload = 'metadata';
        video
          .play()
          .then(() => video.classList.add('is-playing'))
          .catch(() => {});
      };
      const stopPreview = (video: HTMLVideoElement | null) => {
        if (!video) return;
        video.pause();
        video.classList.remove('is-playing');
      };
      const releasePreview = (video: HTMLVideoElement) => {
        stopPreview(video);
        video.removeAttribute('poster');
        video.preload = 'none';
        const source = video.querySelector<HTMLSourceElement>('source[data-src]');
        if (source?.hasAttribute('src')) {
          source.removeAttribute('src');
          video.load();
        }
      };
      document.querySelectorAll<HTMLElement>('[data-motion-card]').forEach((card) => {
        const video = card.querySelector<HTMLVideoElement>('video[data-preview]');
        const activate = () => {
          if (!canMove()) return;
          card.classList.add('is-active');
          playPreview(video);
        };
        const deactivate = () => {
          card.classList.remove('is-active');
          stopPreview(video);
        };
        card.addEventListener('mouseenter', activate);
        card.addEventListener('mouseleave', deactivate);
        card.addEventListener('focusin', activate);
        card.addEventListener('focusout', deactivate);
        const observer = new IntersectionObserver(
          ([entry]) => {
            if (window.matchMedia('(hover: none)').matches && entry.intersectionRatio >= 0.65) activate();
            else if (window.matchMedia('(hover: none)').matches) deactivate();
          },
          { threshold: [0, 0.65, 1] },
        );
        observer.observe(card);
      });
      const carousel = document.querySelector<HTMLElement>('[data-carousel]');
      if (carousel) {
        let slides = [...carousel.querySelectorAll<HTMLElement>('[data-slide]')];
        const slideSlot = carousel.querySelector<HTMLElement>('.nm-heading');
        try {
          const priorOrder = sessionStorage.getItem('oda-hero-order');
          const ids = slides.map((slide) => slide.dataset.slideId || '');
          const saved = priorOrder ? (JSON.parse(priorOrder) as string[]) : [];
          const validSavedOrder = saved.length === ids.length && ids.every((id) => saved.includes(id));
          const order = validSavedOrder ? saved : [...ids];
          if (!validSavedOrder) {
            for (let i = order.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [order[i], order[j]] = [order[j], order[i]];
            }
          }
          slides = order.map((id) => slides.find((slide) => slide.dataset.slideId === id)!).filter(Boolean);
          slides.forEach((slide) => carousel.insertBefore(slide, slideSlot));
          sessionStorage.setItem('oda-hero-order', JSON.stringify(order));
        } catch {
          // Storage may be unavailable; the server-rendered order remains usable.
        }
        let current = 0;
        let timer: number | undefined;
        let inView = false;
        let pointerInside = false;
        let focusInside = false;
        const mayPlay = () => canMove() && !document.hidden && inView;
        slides.forEach((slide, index) => {
          slide.hidden = index !== 0;
          const video = slide.querySelector<HTMLVideoElement>('video[data-preview]');
          if (video) {
            if (index === 0 && video.dataset.poster) video.poster = video.dataset.poster;
            else video.removeAttribute('poster');
          }
          const counter = slide.querySelector<HTMLElement>('[data-carousel-position]');
          if (counter)
            counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
        });
        const show = (next: number) => {
          const focused = document.activeElement;
          const control = ['data-carousel-prev', 'data-carousel-next'].find((name) =>
            focused?.hasAttribute(name),
          );
          slides[current]?.querySelectorAll<HTMLVideoElement>('video').forEach(releasePreview);
          slides[current].hidden = true;
          current = (next + slides.length) % slides.length;
          slides[current].hidden = false;
          const activeVideo = slides[current].querySelector<HTMLVideoElement>('video[data-preview]');
          if (activeVideo?.dataset.poster) activeVideo.poster = activeVideo.dataset.poster;
          if (mayPlay()) playPreview(slides[current].querySelector('video'));
          if (control)
            slides[current].querySelector<HTMLButtonElement>(`[${control}]`)?.focus({ preventScroll: true });
        };
        const pause = () => {
          window.clearInterval(timer);
          timer = undefined;
        };
        const resume = () => {
          pause();
          if (mayPlay()) {
            playPreview(slides[current].querySelector('video'));
            if (!pointerInside && !focusInside) timer = window.setInterval(() => show(current + 1), 14000);
          } else {
            slides[current].querySelectorAll<HTMLVideoElement>('video').forEach(stopPreview);
          }
        };
        carousel.querySelectorAll('[data-carousel-prev]').forEach((button) =>
          button.addEventListener('click', () => {
            show(current - 1);
            resume();
          }),
        );
        carousel.querySelectorAll('[data-carousel-next]').forEach((button) =>
          button.addEventListener('click', () => {
            show(current + 1);
            resume();
          }),
        );
        carousel.addEventListener('mouseenter', () => {
          pointerInside = true;
          pause();
        });
        carousel.addEventListener('mouseleave', () => {
          pointerInside = false;
          resume();
        });
        carousel.addEventListener('focusin', () => {
          focusInside = true;
          pause();
        });
        carousel.addEventListener('focusout', (event) => {
          if (event.relatedTarget instanceof Node && carousel.contains(event.relatedTarget)) return;
          focusInside = false;
          resume();
        });
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            pause();
            slides[current]?.querySelectorAll<HTMLVideoElement>('video').forEach(stopPreview);
          } else {
            resume();
          }
        });
        reduceMotion.addEventListener('change', () => {
          if (canMove()) resume();
          else {
            pause();
            slides.forEach((slide) => slide.querySelectorAll<HTMLVideoElement>('video').forEach(stopPreview));
          }
        });
        const visibility = new IntersectionObserver(
          ([entry]) => {
            inView = entry.isIntersecting;
            resume();
          },
          { threshold: 0 },
        );
        visibility.observe(carousel);
      }
    </script>
  </body>
</html>
