---
import DisclosureHeading from '../components/DisclosureHeading.astro';
import MediaViewer from '../components/MediaViewer.astro';
import '../styles/global.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '@fontsource/jetbrains-mono/cyrillic-400.css';
import '@fontsource/jetbrains-mono/latin-400-italic.css';
import '@fontsource/jetbrains-mono/cyrillic-400-italic.css';
import '@fontsource/jetbrains-mono/cyrillic-500.css';
import '@fontsource/jetbrains-mono/cyrillic-600.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-800.css';
import '@fontsource/manrope/cyrillic-500.css';
import { socialLinks } from '../data/site';
import { intellectualProperty } from '../data/editorial';
import { cases, mediaById, works, preview, people } from '../data/catalogue';
import { pairedPath, navigationFor, type Page } from '../lib/routes';
import DzenIcon from '../assets/social/dzen.svg';
import RecordStamp from '../components/RecordStamp.astro';
import DevNote from '../components/DevNote.astro';
import MediaCropEditor from '../components/MediaCropEditor.astro';
import DevPublicationMark from '../components/DevPublicationMark.astro';
import '../styles/editorial.css';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import TechnicalMark from '../components/TechnicalMark.astro';
import PageCode from '../components/PageCode.astro';
import ReadingNavigation from '../components/ReadingNavigation.astro';
import { pageChapters, caseYearLinks } from '../lib/page-outline';
import lastmod from '../data/lastmod.json';
interface Props {
  page: Page;
  canonicalPath?: string;
  noindex?: boolean;
}
const { page, canonicalPath = page.path, noindex = false } = Astro.props;
const site = 'https://odadream.art';
const canonical = new URL(canonicalPath, site).href;
const alternateEn = new URL(pairedPath(page.path, 'en'), site).href;
const alternateRu = new URL(pairedPath(page.path, 'ru'), site).href;
const nav = navigationFor(page.lang);
const navRoot =
  page.kind === 'work'
    ? 'works'
    : page.kind === 'case'
      ? 'cases'
      : page.kind === 'programme'
        ? 'education'
        : page.kind;
const pageSection = page.family === 'D' ? 'design' : navRoot;
const currentSection = nav.find((item) => item.route === pageSection);
const sectionLabel = currentSection?.label ?? (page.lang === 'ru' ? 'Система' : 'System');
const contentHtml = await Astro.slots.render('default');
const chapters = pageChapters(contentHtml);
const isHome = page.path === `/${page.lang}/`;
const pageName = isHome ? sectionLabel : page.title.replace(' — ODA.dream', '');
const parentSection =
  ['work', 'programme', 'case'].includes(page.kind) && currentSection ? currentSection : undefined;
const caseYears = page.kind === 'cases' ? caseYearLinks(cases) : [];
const contentDate = lastmod[page.path as keyof typeof lastmod];
const record =
  page.kind === 'work'
    ? works.find((item) => item.slug === page.slug)
    : page.kind === 'case'
      ? cases.find((item) => item.slug === page.slug)
      : undefined;
const ogMedia = mediaById(record?.media[0] ?? 'interference-stage');
const schema =
  page.kind === 'home' || page.kind === 'studio'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'ODA.dream',
        url: site,
        description: page.description,
        founder:
          people.length > 0
            ? [
                { '@type': 'Person', name: 'Olga Arabova' },
                { '@type': 'Person', name: 'Daler Arabov' },
              ]
            : undefined,
      }
    : page.kind === 'work'
      ? {
          '@context': 'https://schema.org',
          '@type': 'CreativeWork',
          name: page.title.replace(' — ODA.dream', ''),
          description: page.description,
          url: canonical,
          creator: { '@type': 'Organization', name: 'ODA.dream' },
        }
      : null;
const crumbs = page.path.split('/').filter(Boolean);
const crumbNames: Record<string, string> =
  page.lang === 'en'
    ? {
        en: 'Home',
        works: 'Works',
        education: 'Education',
        cooperation: 'Cooperation',
        studio: 'Studio',
        cases: 'Cases',
        contact: 'Contact',
        technology: 'Neuromandala',
        recognition: 'Recognition',
      }
    : {
        ru: 'Главная',
        works: 'Работы',
        education: 'Образование',
        cooperation: 'Сотрудничество',
        studio: 'Студия',
        cases: 'Кейсы',
        contact: 'Контакт',
        technology: 'Нейромандала',
        recognition: 'Признания',
      };
const breadcrumbSchema =
  crumbs.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: crumbs.map((part, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: i === crumbs.length - 1 ? page.title.replace(' — ODA.dream', '') : (crumbNames[part] ?? part),
          item: new URL(`/${crumbs.slice(0, i + 1).join('/')}/`, site).href,
        })),
      }
    : null;
---

<!doctype html>
<html
  lang={page.lang}
  data-section={pageSection}
  data-page-kind={page.kind}
  data-page-family={page.family}
  data-analytics-page={canonicalPath}
  data-analytics-preview={String(preview)}
  data-work-id={
    page.kind === 'work'
      ? record?.id
      : page.kind === 'case'
        ? cases.find((row) => row.slug === page.slug)?.work
        : undefined
  }
  data-case-id={page.kind === 'case' ? record?.id : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#23211e" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('oda-theme');
          const mode = saved === 'light' || saved === 'dark' ? saved : 'auto';
          const systemDark = matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.themeMode = mode;
          document.documentElement.dataset.theme = mode === 'auto' ? (systemDark ? 'dark' : 'light') : mode;
        } catch {
          document.documentElement.dataset.themeMode = 'auto';
          document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
      })();
    </script>
    <link rel="icon" href="/brand/oda-brain.svg" type="image/svg+xml" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={canonical} />
    {!noindex && (
      <>
        <link rel="alternate" hreflang="en" href={alternateEn} />
        <link rel="alternate" hreflang="ru" href={alternateRu} />
        <link rel="alternate" hreflang="x-default" href={alternateEn} />
      </>
    )}
    {(noindex || preview) && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content={page.kind === 'work' || page.kind === 'case' ? 'article' : 'website'} />
    <meta property="og:site_name" content="ODA.dream" />
    <meta property="og:locale" content={page.lang === 'en' ? 'en_US' : 'ru_RU'} />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    {ogMedia && (
      <>
        <meta property="og:image" content={new URL(ogMedia.src, site).href} />
        <meta property="og:image:alt" content={ogMedia.alt[page.lang]} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    )}
  </head>
  <body>
    <div id="top" class="page-top" aria-hidden="true"></div>
    <a class="skip-link" href="#main">
      {page.lang === 'en' ? 'Skip to content' : 'К содержимому'}
    </a>
    <header class="site-header">
      <div class="shell header-inner">
        <a
          class="brand"
          href={`/${page.lang}/`}
          aria-label={page.lang === 'ru' ? 'ODA.dream — главная' : 'ODA.dream — home'}
        >
          <img src="/brand/oda-logo.svg" alt="ODA.dream" width="112" height="52" />
        </a>
        <nav class="primary-nav" aria-label={page.lang === 'ru' ? 'Основные разделы' : 'Primary sections'}>
          {nav
            .filter(({ route }) => route !== 'home' && route !== pageSection)
            .map(({ label, href, route, family }) => (
              <a href={href} data-route={route}>
                <PageCode family={family} lang={page.lang} register={false} />
                <span>{label}</span>
              </a>
            ))}
          {import.meta.env.DEV && pageSection !== 'design' && (
            <a href="/design-system/" data-route="design">
              <PageCode family="D" register={false} />
              <span>{page.lang === 'ru' ? 'Система' : 'System'}</span>
            </a>
          )}
        </nav>
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label={page.lang === 'en' ? 'Open menu' : 'Открыть меню'}
        >
          <span class="menu-open-mark">
            <TechnicalMark kind="menu" />
          </span>
          <span class="menu-close-mark">
            <TechnicalMark kind="close" />
          </span>
          <span data-menu-label>{page.lang === 'ru' ? 'Меню' : 'Menu'}</span>
        </button>
        <nav
          id="site-nav"
          class="site-nav"
          aria-label={page.lang === 'en' ? 'Main navigation' : 'Основная навигация'}
        >
          {nav
            .filter(({ route }) => route !== 'home' && route !== pageSection)
            .map(({ label, route, href, family }) => (
              <a href={href} data-route={route}>
                <PageCode family={family} lang={page.lang} register={false} />
                {label}
              </a>
            ))}
          {import.meta.env.DEV && pageSection !== 'design' && (
            <a href="/design-system/" data-route="design">
              <PageCode family="D" lang={page.lang} register={false} />
              {page.lang === 'ru' ? 'Система' : 'System'}
            </a>
          )}
          <div class="navigation-preferences">
            <span>{page.lang === 'ru' ? 'Оформление' : 'Appearance'}</span>
            <button
              class="theme-toggle"
              type="button"
              data-theme-toggle
              aria-label={page.lang === 'ru' ? 'Тема: автоматически' : 'Theme: automatic'}
              title={page.lang === 'ru' ? 'Сменить тему' : 'Change theme'}
            >
              <TechnicalMark kind="theme" />
              <span data-theme-label>{page.lang === 'ru' ? 'Авто' : 'Auto'}</span>
            </button>
          </div>
        </nav>
        {page.path !== '/ru/design-system/' && (
          <a
            class="language-link"
            href={pairedPath(page.path, page.lang === 'en' ? 'ru' : 'en')}
            lang={page.lang === 'en' ? 'ru' : 'en'}
            aria-label={page.lang === 'en' ? 'Русская версия' : 'English version'}
          >
            {page.lang === 'en' ? 'RU' : 'EN'}
          </a>
        )}
      </div>
      <ReadingNavigation
        lang={page.lang}
        title={pageName}
        home={isHome}
        family={page.family}
        parent={parentSection}
        chapters={chapters}
        years={caseYears}
      />
    </header>
    {import.meta.env.DEV && <script is:inline type="module" src="/__editorial/client.js"></script>}
    <noscript>
      <style>
        .header-inner {
          flex-wrap: wrap;
        }
        .primary-nav,
        .header-inner .menu-toggle {
          display: none !important;
        }
        .header-inner .language-link {
          margin-left: auto;
        }
        .site-header .site-nav {
          display: grid;
          position: static;
          order: 3;
          width: 100%;
          max-height: none;
          box-shadow: none;
        }
      </style>
    </noscript>
    <MediaCropEditor lang={page.lang} />
    <main id="main" data-page-code={page.family}>
      {preview && page.family !== 'D' && (
        <DevNote id="dev-catalogue-scope" lang={page.lang}>
          <p>
            {page.lang === 'ru'
              ? 'Редакционный каталог включает непубличные материалы. Сравнить с публикационной сборкой можно в панели DEV / PUBLIC.'
              : 'The editorial catalogue includes unpublished material. Compare it with the publication build using DEV / PUBLIC.'}
          </p>
        </DevNote>
      )}
      {record && (
        <DevPublicationMark
          kind={page.kind === 'work' ? 'works' : 'cases'}
          recordId={record.id}
          lang={page.lang}
        />
      )}
      <Fragment set:html={contentHtml} />
    </main>
    <footer class="site-footer">
      {!noindex && (
        <div class="shell site-colophon">
          <nav class="footer-navigation" aria-label={page.lang === 'ru' ? 'Разделы сайта' : 'Site sections'}>
            {nav.map(({ label, href, family, route }) => (
              <a href={href} aria-current={pageSection === route ? 'page' : undefined}>
                <PageCode family={family} lang={page.lang} register={false} />
                <span>{label}</span>
              </a>
            ))}
          </nav>
          <details class="footer-document">
            <DisclosureHeading>
              {page.lang === 'ru' ? 'Об этой странице' : 'About this page'}
            </DisclosureHeading>
            <RecordStamp
              title={page.lang === 'ru' ? 'Выходные данные' : 'Document details'}
              wide
              layout="colophon"
              fields={[
                {
                  label: page.lang === 'ru' ? 'Обновлено' : 'Updated',
                  value: contentDate || '—',
                },
              ]}
            >
              <Fragment slot="fields-after">
                <div>
                  <dt>{page.lang === 'ru' ? 'Ссылка на страницу' : 'Page link'}</dt>
                  <dd>
                    <button class="colophon-copy" type="button" data-copy-page-link>
                      {page.lang === 'ru' ? 'Копировать ссылку' : 'Copy page link'}
                    </button>
                    <span role="status" data-copy-status></span>
                    <input
                      class="colophon-url"
                      data-copy-fallback
                      hidden
                      readonly
                      aria-label={
                        page.lang === 'ru' ? 'Скопируйте адрес вручную' : 'Copy this address manually'
                      }
                    />
                  </dd>
                </div>
              </Fragment>
            </RecordStamp>
          </details>
        </div>
      )}
      <div class="shell footer-inner">
        <div>
          <small class="footer-copyright">
            © 2019–{new Date().getFullYear()}{' '}
            <span class="footer-brand">
              ODA.dream
              <sup
                title={
                  page.lang === 'ru'
                    ? `Товарный знак №${intellectualProperty.trademark.number} от 25.02.2026`
                    : `Registered trademark No. ${intellectualProperty.trademark.number}, 25 February 2026`
                }
              >
                ®
              </sup>
            </span>
          </small>
          <p>
            {page.lang === 'en'
              ? 'Human state as artistic material.'
              : 'Состояние человека как художественный материал.'}
          </p>
          <button
            type="button"
            class="analytics-settings-toggle"
            data-analytics-settings
            hidden
            aria-expanded="false"
          >
            <TechnicalMark kind="settings" />
            {page.lang === 'ru' ? 'Настройки аналитики' : 'Analytics settings'}
          </button>
        </div>
        <nav
          class="footer-links"
          aria-label={page.lang === 'ru' ? 'Контакты и социальные сети' : 'Contact and social links'}
        >
          <a class="footer-top" href="#top">
            <TechnicalMark kind="previous" />
            {page.lang === 'ru' ? 'Наверх' : 'Back to top'}
          </a>
          {socialLinks
            .filter((item) => item.languages.includes(page.lang))
            .map((item) => (
              <a
                href={item.href}
                data-contact-channel={item.id}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${item.label} — ODA.dream`}
              >
                <span class="social-icon" data-social-icon={item.id} aria-hidden="true">
                  {item.id === 'telegram' ? (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="m21 4-3.2 16-6-5.1-3.1 3 .6-5.6L19 6.1l-11 4.8-4.2-1.5L21 4Z" />
                    </svg>
                  ) : item.id === 'youtube' ? (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M21 8.1a2.7 2.7 0 0 0-1.9-1.9C17.4 5.8 12 5.8 12 5.8s-5.4 0-7.1.4A2.7 2.7 0 0 0 3 8.1a28 28 0 0 0-.4 3.9A28 28 0 0 0 3 16a2.7 2.7 0 0 0 1.9 1.9c1.7.4 7.1.4 7.1.4s5.4 0 7.1-.4A2.7 2.7 0 0 0 21 16a28 28 0 0 0 .4-4 28 28 0 0 0-.4-3.9Z" />
                      <path d="m10 15 5-3-5-3v6Z" />
                    </svg>
                  ) : item.id === 'instagram' ? (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle class="social-icon__dot" cx="17.7" cy="6.7" r=".8" />
                    </svg>
                  ) : item.id === 'vk' ? (
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M13.16 18.7c-8.2 0-12.88-5.63-13.08-15h4.11c.14 6.88 3.17 9.8 5.57 10.4V3.7h3.87v5.94c2.37-.25 4.86-2.96 5.7-5.94h3.87c-.64 3.67-3.33 6.38-5.24 7.5 1.91.91 4.97 3.28 6.04 7.5h-4.26c-.9-2.81-3.13-4.99-6.11-5.28v5.28h-.47Z" />
                    </svg>
                  ) : (
                    <DzenIcon />
                  )}
                </span>
                <span>{item.label}</span>
              </a>
            ))}
        </nav>
      </div>
    </footer>
    <AnalyticsConsent lang={page.lang} />
    <MediaViewer lang={page.lang} />
    <script>
      import { createAnalytics } from '../scripts/analytics';
      import { initVideoPreviews } from '../scripts/video-previews';
      import { initHeroCarousel } from '../scripts/hero-carousel';
      import { initReadingNavigation } from '../scripts/reading-navigation';
      import { analyticsConfig } from '../data/analytics-config';
      const root = document.documentElement;
      createAnalytics(analyticsConfig, {
        pagePath: root.dataset.analyticsPage ?? location.pathname,
        language: root.lang === 'ru' ? 'ru' : 'en',
        workId: root.dataset.workId,
        caseId: root.dataset.caseId,
        preview: root.dataset.analyticsPreview === 'true',
      });
      const ru = document.documentElement.lang === 'ru';
      document
        .querySelector<HTMLButtonElement>('[data-copy-page-link]')
        ?.addEventListener('click', async () => {
          const status = document.querySelector<HTMLElement>('[data-copy-status]');
          const fallback = document.querySelector<HTMLInputElement>('[data-copy-fallback]');
          try {
            await navigator.clipboard.writeText(window.location.href);
            if (status) {
              status.textContent = ru ? 'Ссылка скопирована' : 'Link copied';
            }
            if (fallback) fallback.hidden = true;
          } catch {
            if (status) {
              status.classList.remove('sr-only');
              status.textContent = ru ? 'Скопируйте адрес вручную' : 'Copy the address manually';
            }
            if (fallback) {
              fallback.hidden = false;
              fallback.value = window.location.href;
              fallback.focus();
              fallback.select();
            }
          }
        });
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-nav');
      const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const themeLabel = themeButton?.querySelector<HTMLElement>('[data-theme-label]');
      const themeNames =
        document.documentElement.lang === 'ru'
          ? { auto: 'Авто', light: 'Свет', dark: 'Тьма' }
          : { auto: 'Auto', light: 'Light', dark: 'Dark' };
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
      const updateThemeLabel = () => {
        const mode = (document.documentElement.dataset.themeMode || 'auto') as keyof typeof themeNames;
        if (themeLabel) themeLabel.textContent = themeNames[mode];
        themeButton?.setAttribute(
          'aria-label',
          `${document.documentElement.lang === 'ru' ? 'Тема' : 'Theme'}: ${themeNames[mode]}`,
        );
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute(
            'content',
            getComputedStyle(document.documentElement).getPropertyValue('--header-bg').trim(),
          );
      };
      updateThemeLabel();
      themeButton?.addEventListener('click', () => {
        const current = document.documentElement.dataset.themeMode || 'auto';
        const next = current === 'auto' ? 'light' : current === 'light' ? 'dark' : 'auto';
        document.documentElement.dataset.themeMode = next;
        document.documentElement.dataset.theme =
          next === 'auto' ? (systemTheme.matches ? 'dark' : 'light') : next;
        try {
          localStorage.setItem('oda-theme', next);
        } catch {
          /* private storage */
        }
        updateThemeLabel();
      });
      systemTheme.addEventListener('change', () => {
        if (document.documentElement.dataset.themeMode === 'auto') {
          document.documentElement.dataset.theme = systemTheme.matches ? 'dark' : 'light';
          updateThemeLabel();
        }
      });
      import { initDisclosures } from '../scripts/disclosures';
      function initPriorityNavigation() {
        const primary = document.querySelector<HTMLElement>('.primary-nav');
        if (!primary || !nav || !menu) return;
        const links = Array.from(primary.querySelectorAll<HTMLAnchorElement>('a'));
        const overflow = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[data-route]'));
        const header = primary.closest<HTMLElement>('.header-inner')!;
        const theme = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
        const preferences = nav.querySelector<HTMLElement>('.navigation-preferences')!;
        const language = header.querySelector<HTMLElement>('.language-link');
        function fit() {
          if (!primary || !menu || !nav) return;
          links.forEach((link) => {
            link.hidden = false;
          });
          const navGap = parseFloat(getComputedStyle(primary).columnGap) || 0;
          const widths = links.map((link) => link.getBoundingClientRect().width);
          const total =
            widths.reduce((sum, width) => sum + width, 0) + navGap * Math.max(0, links.length - 1);
          const prefixCount = () => {
            let used = 0,
              count = 0;
            for (const width of widths) {
              if (used + width > primary.clientWidth) break;
              used += width + navGap;
              count++;
            }
            return count;
          };
          // Compare actual layouts. Theme never displaces a destination that could fit.
          preferences.append(theme);
          preferences.hidden = false;
          menu.hidden = false;
          const withoutTheme = prefixCount();
          header.insertBefore(theme, language);
          preferences.hidden = true;
          const withTheme = prefixCount();
          menu.hidden = true;
          const allFit = total <= primary.clientWidth && header.scrollWidth <= header.clientWidth;
          const themeFits =
            allFit ||
            (withTheme >= withoutTheme && withTheme > 0 && header.scrollWidth <= header.clientWidth);
          if (!themeFits) {
            preferences.append(theme);
            preferences.hidden = false;
          }
          menu.hidden = allFit;
          const count = allFit ? links.length : prefixCount();
          links.forEach((link, index) => {
            link.hidden = index >= count;
          });
          overflow.forEach((link) => {
            link.hidden = links.some((item) => item.dataset.route === link.dataset.route && !item.hidden);
          });
          if (allFit) setMenuOpen(false);
          const closedLabel = ru ? (count === 0 ? 'Меню' : 'Ещё') : count === 0 ? 'Menu' : 'More';
          menu.dataset.closedLabel = closedLabel;
          if (menu.getAttribute('aria-expanded') !== 'true') {
            const label = menu.querySelector('[data-menu-label]');
            if (label) label.textContent = closedLabel;
          }
        }
        new ResizeObserver(fit).observe(header);
        document.fonts.ready.then(fit);
        fit();
      }
      function setMenuOpen(open: boolean) {
        menu?.setAttribute('aria-expanded', String(open));
        const text = menu?.dataset.closedLabel || (ru ? 'Ещё' : 'More');
        const label = menu?.querySelector('[data-menu-label]');
        if (label) label.textContent = text;
        menu?.setAttribute(
          'aria-label',
          ru ? (open ? 'Закрыть меню' : 'Открыть меню') : open ? 'Close menu' : 'Open menu',
        );
        nav?.classList.toggle('open', open);
      }
      document.addEventListener('oda:contents:open', () => setMenuOpen(false));
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true';
        setMenuOpen(open);
        if (open) document.dispatchEvent(new CustomEvent('oda:main-menu:open'));
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || menu?.getAttribute('aria-expanded') !== 'true') return;
        setMenuOpen(false);
        menu.focus();
      });
      document.addEventListener('pointerdown', (event) => {
        if (event.target instanceof Node && !document.querySelector('.site-header')?.contains(event.target))
          setMenuOpen(false);
      });
      initDisclosures();
      initPriorityNavigation();
      initReadingNavigation();
      const videoPreviews = initVideoPreviews();
      initHeroCarousel(videoPreviews);
    </script>
  </body>
</html>
