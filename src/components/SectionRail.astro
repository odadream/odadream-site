---
import TechnicalMark from './TechnicalMark.astro';
import PageCode from './PageCode.astro';
import { makePageCode, type PageFamily } from '../lib/page-codes';
interface Props {
  family: PageFamily;
  section: number;
  label: string;
  note: string;
  lang?: 'en' | 'ru';
}
const { family, section, label, note, lang = 'en' } = Astro.props;
const index = makePageCode(family, section).split('.')[1];
const hasData = Astro.slots.has('default');
---

<aside class:list={['section-rail', { 'section-rail--empty': !hasData }]} aria-label={label}>
  <div class="section-rail__field">
    <span class="section-rail__folio" aria-hidden="true">
      {index}
    </span>
    <div class="section-label section-rail__spine">
      <PageCode family={family} section={section} lang={lang} />
    </div>
  </div>
  {hasData && (
    <div class="section-rail__data">
      <slot />
    </div>
  )}
  <p class="section-rail__note">
    <TechnicalMark kind="note" />
    {note}
  </p>
</aside>
