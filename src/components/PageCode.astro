---
import { makePageCode, type PageFamily } from '../lib/page-codes';
import TechnicalMark from './TechnicalMark.astro';

interface Props {
  family: PageFamily;
  section?: number;
  lang?: 'en' | 'ru';
  register?: boolean;
}

const { family, section = 0, lang = 'en', register = true } = Astro.props;
const code = makePageCode(family, section);
const description =
  section === 0
    ? lang === 'ru'
      ? `Страница ${family}`
      : `Page ${family}`
    : lang === 'ru'
      ? `Страница ${family}, раздел ${String(section).padStart(2, '0')}`
      : `Page ${family}, section ${String(section).padStart(2, '0')}`;
const suffix = code.slice(2);
const sectionCode = suffix.slice(0, 2);
const marks = {
  H: 'home',
  W: 'works',
  E: 'education',
  C: 'cooperation',
  S: 'studio',
  K: 'cases',
  N: 'contact',
  M: 'technology',
  R: 'recognition',
  D: 'design',
} as const;
const names = {
  H: ['Home', 'Главная'],
  W: ['Works', 'Работы'],
  E: ['Education', 'Образование'],
  C: ['Cooperation', 'Сотрудничество'],
  S: ['Studio', 'Студия'],
  K: ['Cases', 'Кейсы'],
  N: ['Contact', 'Контакт'],
  M: ['Neuromandala', 'Нейромандала'],
  R: ['Recognition', 'Признания'],
  D: ['Design system', 'Система дизайна'],
};
const accessibleDescription = description.replace(family, names[family][lang === 'ru' ? 1 : 0]);
---

<span
  class="page-code page-code--chip"
  data-family={family}
  data-page-code={register ? code : undefined}
  role="img"
  aria-label={accessibleDescription}
>
  {[
    <span class="page-code__family">
      <TechnicalMark kind={marks[family]} />
    </span>,
    sectionCode && <span class="page-code__section">{`.${sectionCode}`}</span>,
  ]}
</span>
