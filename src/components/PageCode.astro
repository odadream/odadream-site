---
import { makePageCode, type PageFamily } from '../lib/page-codes';

interface Props {
  family: PageFamily;
  section?: number;
  item?: number;
  lang?: 'en' | 'ru';
  chip?: boolean;
}

const { family, section = 0, item, lang = 'en', chip = false } = Astro.props;
const code = makePageCode(family, section, item);
const description =
  lang === 'ru'
    ? `Страница ${family}, раздел ${String(section).padStart(2, '0')}${item === undefined ? '' : `, элемент ${String(item).padStart(2, '0')}`}`
    : `Page ${family}, section ${String(section).padStart(2, '0')}${item === undefined ? '' : `, item ${String(item).padStart(2, '0')}`}`;
const segments = code.split('.');
---

<span class:list={['page-code', { 'page-code--chip': chip }]} data-page-code={code} aria-label={description}>
  <span class="page-code__family">{segments[0]}</span>
  {chip ? (
    <span class="page-code__compact">{segments.slice(1).join('')}</span>
  ) : (
    segments.slice(1).map((segment) => <span class="page-code__segment">{segment}</span>)
  )}
</span>
