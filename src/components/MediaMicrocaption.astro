---
import TechnicalMark from './TechnicalMark.astro';
import CalloutLink from './CalloutLink.astro';
import type { Lang } from '../data/site';
import type { MediaItem } from '../lib/media-presentation';
interface Props {
  item: MediaItem;
  lang?: Lang;
  event?: { title: string; href: string; date: string };
  created?: string;
  title?: string;
}
const { item, event, created, lang = 'ru', title = item.caption[lang] } = Astro.props;
---

<figcaption class="media-microcaption">
  <span class="media-microcaption__identity">
    <span class="media-microcaption__symbol">
      <TechnicalMark kind={item.kind === 'video' ? 'video' : 'image'} />
    </span>
    <span>{title}</span>
  </span>
  {created && (
    <span>
      {lang === 'ru' ? 'Создано' : 'Created'}: {created}
    </span>
  )}
  {event && (
    <span>
      <CalloutLink href={event.href} inline>
        {event.title}
      </CalloutLink>{' '}
      · <span>{event.date}</span>
    </span>
  )}
</figcaption>
