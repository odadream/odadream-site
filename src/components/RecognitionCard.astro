---
import DevPublicationMark from './DevPublicationMark.astro';
import RecognitionCaption from './RecognitionCaption.astro';
import CalloutLink from './CalloutLink.astro';
import type { Lang, Recognition } from '../data/site';
interface Props {
  item: Pick<
    Recognition,
    | 'captionLabel'
    | 'place'
    | 'id'
    | 'kind'
    | 'title'
    | 'issuer'
    | 'year'
    | 'previewSrc'
    | 'claim'
    | 'overviewClaim'
    | 'recipient'
    | 'limitations'
    | 'contextPath'
    | 'documents'
    | 'width'
    | 'height'
  >;
  lang: Lang;
  presentation?: 'catalogue' | 'overview';
}
const { item, lang, presentation = 'catalogue' } = Astro.props;
const overview = presentation === 'overview';
const documents = item.documents?.length
  ? item.documents
  : item.previewSrc
    ? [{ id: item.id, src: item.previewSrc, label: item.title, width: item.width, height: item.height }]
    : [];
---

<article
  class:list={[
    'recognition-card',
    { 'recognition-card--overview': overview, 'recognition-card--text': documents.length === 0 },
  ]}
  id={`recognition-${item.id}`}
>
  <DevPublicationMark kind="recognitions" recordId={item.id} lang={lang} />
  {documents.length > 0 && (
    <div class="recognition-card__documents" data-media-gallery>
      {documents.map((document) => (
        <button
          data-material-id={item.id}
          class="recognition-card__image"
          type="button"
          data-lightbox
          data-gallery-item
          data-details-href={`/${lang}/recognition/#recognition-${item.id}`}
          data-src={document.src}
          data-alt={`${document.label[lang]} · ${item.title[lang]}`}
          data-viewer-summary={`${item.year} · ${(item.captionLabel ?? item.issuer)[lang]}${item.place ? ` · ${item.place}${lang === 'ru' ? ' место' : 'st place'}` : ''} · ${document.label[lang]}`}
          data-caption={`${document.label[lang]} · ${item.issuer[lang]}, ${item.year}`}
          aria-label={
            lang === 'ru'
              ? `Открыть: ${document.label.ru} · ${item.title.ru}`
              : `Open: ${document.label.en} · ${item.title.en}`
          }
        >
          <img
            src={document.src}
            alt=""
            width={document.width}
            height={document.height}
            loading="lazy"
            decoding="async"
          />
        </button>
      ))}
    </div>
  )}
  <span class="meta">
    <RecognitionCaption item={item} lang={lang} />
  </span>
  <div>
    <h3>{item.title[lang]}</h3>
    {!overview && <p>{item.issuer[lang]}</p>}
    <p class="recognition-card__claim">
      {overview ? (item.overviewClaim?.[lang] ?? item.claim[lang]) : item.claim[lang]}
    </p>
    {!overview && (
      <p class="small-note">
        {lang === 'ru' ? 'Адресат' : 'Recipient'}: {item.recipient[lang]}
      </p>
    )}
    {!overview && item.limitations && <p class="small-note">{item.limitations[lang]}</p>}
    {(item.contextPath || overview) && (
      <CalloutLink href={`/${lang}/${item.contextPath ?? `recognition/#recognition-${item.id}`}`}>
        {item.contextPath
          ? lang === 'ru'
            ? 'Контекст участия'
            : 'Contribution context'
          : lang === 'ru'
            ? 'Подробнее о признании'
            : 'Recognition details'}
      </CalloutLink>
    )}
  </div>
</article>
