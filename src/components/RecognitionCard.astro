---
import TechnicalMark from './TechnicalMark.astro';
import CalloutLink from './CalloutLink.astro';
import type { Lang, Recognition, RecognitionKind } from '../data/site';
interface Props {
  item: Pick<
    Recognition,
    | 'id'
    | 'kind'
    | 'title'
    | 'issuer'
    | 'year'
    | 'previewSrc'
    | 'claim'
    | 'recipient'
    | 'limitations'
    | 'contextPath'
    | 'width'
    | 'height'
  >;
  lang: Lang;
}
const { item, lang } = Astro.props;
const kindLabels: Record<RecognitionKind, Record<Lang, string>> = {
  award: { en: 'Award', ru: 'Награда' },
  certificate: { en: 'Certificate', ru: 'Диплом' },
  'acknowledgement-letter': { en: 'Acknowledgement', ru: 'Благодарность' },
};
---

<article class="recognition-card" id={`recognition-${item.id}`}>
  {item.previewSrc ? (
    <button
      data-material-id={item.id}
      class="recognition-card__image"
      type="button"
      data-lightbox
      data-src={item.previewSrc}
      data-alt={item.title[lang]}
      data-caption={`${item.title[lang]} · ${item.issuer[lang]}, ${item.year}`}
      aria-label={lang === 'ru' ? `Открыть документ: ${item.title.ru}` : `Open document: ${item.title.en}`}
    >
      <img
        src={item.previewSrc}
        alt=""
        width={item.width}
        height={item.height}
        loading="lazy"
        decoding="async"
      />
    </button>
  ) : (
    <div
      class="recognition-card__missing"
      role="img"
      aria-label={
        lang === 'ru' ? 'Скан не найден в прежнем архиве' : 'Scan missing from the previous archive'
      }
    >
      <TechnicalMark kind="missing" />
      <small>{lang === 'ru' ? 'Скан недоступен' : 'Scan unavailable'}</small>
    </div>
  )}
  <span class="meta">
    {item.year} · {kindLabels[item.kind][lang]}
  </span>
  <div>
    <h3>{item.title[lang]}</h3>
    <p>{item.issuer[lang]}</p>
    <p>{item.claim[lang]}</p>
    <p class="small-note">
      {lang === 'ru' ? 'Адресат' : 'Recipient'}: {item.recipient[lang]}
    </p>
    <p class="small-note">{item.limitations[lang]}</p>
    {item.contextPath && (
      <CalloutLink href={`/${lang}/${item.contextPath}`}>
        {lang === 'ru' ? 'Контекст участия' : 'Contribution context'}
      </CalloutLink>
    )}
  </div>
</article>
