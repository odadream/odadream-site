---
import DevPublicationMark from './DevPublicationMark.astro';
import CalloutLink from './CalloutLink.astro';
import type { Lang, Recognition } from '../data/site';
import { recognitionKindLabel } from '../lib/recognition-presentation';
interface Props {
  item: Pick<
    Recognition,
    | 'id'
    | 'kind'
    | 'title'
    | 'issuer'
    | 'year'
    | 'previewSrc'
    | 'claim'
    | 'overviewClaim'
    | 'recipient'
    | 'limitations'
    | 'contextPath'
    | 'width'
    | 'height'
  >;
  lang: Lang;
  presentation?: 'catalogue' | 'overview';
}
const { item, lang, presentation = 'catalogue' } = Astro.props;
const overview = presentation === 'overview';
---

<article
  class:list={[
    'recognition-card',
    { 'recognition-card--overview': overview, 'recognition-card--text': !item.previewSrc },
  ]}
  id={`recognition-${item.id}`}
>
  <DevPublicationMark kind="recognitions" recordId={item.id} lang={lang} />
  {item.previewSrc ? (
    <button
      data-material-id={item.id}
      class="recognition-card__image"
      type="button"
      data-lightbox
      data-src={item.previewSrc}
      data-alt={item.title[lang]}
      data-caption={`${item.title[lang]} · ${item.issuer[lang]}, ${item.year}`}
      aria-label={lang === 'ru' ? `Открыть документ: ${item.title.ru}` : `Open document: ${item.title.en}`}
    >
      <img
        src={item.previewSrc}
        alt=""
        width={item.width}
        height={item.height}
        loading="lazy"
        decoding="async"
      />
    </button>
  ) : null}
  <span class="meta">
    {item.year} · {recognitionKindLabel[item.kind][lang]}
  </span>
  <div>
    <h3>{item.title[lang]}</h3>
    {!overview && <p>{item.issuer[lang]}</p>}
    <p class="recognition-card__claim">
      {overview ? (item.overviewClaim?.[lang] ?? item.claim[lang]) : item.claim[lang]}
    </p>
    {!overview && (
      <p class="small-note">
        {lang === 'ru' ? 'Адресат' : 'Recipient'}: {item.recipient[lang]}
      </p>
    )}
    {!overview && item.limitations && <p class="small-note">{item.limitations[lang]}</p>}
    {(item.contextPath || overview) && (
      <CalloutLink href={`/${lang}/${item.contextPath ?? `recognition/#recognition-${item.id}`}`}>
        {item.contextPath
          ? lang === 'ru'
            ? 'Контекст участия'
            : 'Contribution context'
          : lang === 'ru'
            ? 'Подробнее о признании'
            : 'Recognition details'}
      </CalloutLink>
    )}
  </div>
</article>
