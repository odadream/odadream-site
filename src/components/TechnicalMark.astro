---
import { technicalPaths } from '../lib/technical-marks';
interface Props {
  kind: keyof typeof technicalPaths;
}
const { kind } = Astro.props;
---

<svg
  class="technical-mark"
  data-mark={kind}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path d={technicalPaths[kind]} />
</svg>
