---
import CalloutLink from './CalloutLink.astro';
import TechnicalMark from './TechnicalMark.astro';
export interface StampField {
  label: string;
  value: string | number;
  href?: string;
  metric?: boolean;
}
interface Props {
  title: string;
  fields: StampField[];
  wide?: boolean;
  tone?: 'document' | 'reference';
}
const { title, fields, wide = false, tone = 'document' } = Astro.props;
---

<section
  class:list={[
    'record-stamp',
    { 'record-stamp--wide': wide, 'record-stamp--reference': tone === 'reference' },
  ]}
  aria-label={title}
>
  <p class="record-stamp__title">
    <TechnicalMark kind="record" />
    {title}
  </p>
  <dl>
    {fields.map((field) => (
      <div>
        <dt>{field.label}</dt>
        <dd class:list={{ 'record-stamp__metric': field.metric }}>
          {field.href ? <CalloutLink href={field.href}>{field.value}</CalloutLink> : field.value}
        </dd>
      </div>
    ))}
    <slot name="fields-after" />
  </dl>
  <slot />
</section>
