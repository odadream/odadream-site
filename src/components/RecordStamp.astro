---
export interface StampField {
  label: string;
  value: string | number;
  href?: string;
  metric?: boolean;
}
interface Props {
  title: string;
  fields: StampField[];
  wide?: boolean;
}
const { title, fields, wide = false } = Astro.props;
---

<section class:list={['record-stamp', { 'record-stamp--wide': wide }]} aria-label={title}>
  <p class="record-stamp__title">
    <span aria-hidden="true">⌑</span>
    {title}
  </p>
  <dl>
    {fields.map((field) => (
      <div>
        <dt>{field.label}</dt>
        <dd class:list={{ 'record-stamp__metric': field.metric }}>
          {field.href ? (
            <a href={field.href}>
              {field.value}
              <span aria-hidden="true"> ↗</span>
            </a>
          ) : (
            field.value
          )}
        </dd>
      </div>
    ))}
    <slot name="fields-after" />
  </dl>
  <slot />
</section>
