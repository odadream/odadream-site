---
import type { Lang } from '../data/site';
import type { DocumentMetadata } from '../data/reference-documents';
import CalloutLink from './CalloutLink.astro';
import MediaGallery from './MediaGallery.astro';
import type { MediaItem } from '../lib/media-presentation';
interface Props {
  documents: DocumentMetadata[];
  lang: Lang;
  title?: string;
}
const { documents, lang, title } = Astro.props;
const ru = lang === 'ru';
const heading = title ?? (ru ? 'Архивные документы' : 'Archive documents');
const size = (bytes: number) => {
  const small = bytes < 1_000_000;
  const value = new Intl.NumberFormat(lang, { maximumFractionDigits: 1 }).format(
    bytes / (small ? 1_000 : 1_000_000),
  );
  return `${value} ${small ? (ru ? 'КБ' : 'kB') : ru ? 'МБ' : 'MB'}`;
};
const metadata = (document: Props['documents'][number]) =>
  [
    document.year ?? (ru ? 'Год не указан' : 'Year unspecified'),
    'WebP',
    document.language.toUpperCase(),
    `${document.pageImages?.length === document.pages ? document.pages : `${document.pageImages?.length ?? 0}/${document.pages}`} ${ru ? 'стр.' : 'pp.'}`,
    size((document.pageImages ?? []).reduce((total, page) => total + page.bytes, 0)),
  ].join(' · ');
const pageItems = (document: DocumentMetadata): MediaItem[] =>
  (document.pageImages ?? []).map((page, index) => ({
    id: `${document.id}-page-${index + 1}`,
    ...page,
    kind: 'image',
    representation: 'document',
    alt: {
      ru: `${document.title.ru} — страница ${page.pageNumber ?? index + 1}`,
      en: `${document.title.en} — page ${page.pageNumber ?? index + 1}`,
    },
    caption: {
      ru: `Страница ${page.pageNumber ?? index + 1} из ${document.pages}`,
      en: `Page ${page.pageNumber ?? index + 1} of ${document.pages}`,
    },
  }));
---

{documents.length > 0 && (
  <section class="section-body spaced-actions" aria-label={heading}>
    <h3>{heading}</h3>
    <div class="document-list">
      {documents.map((document) => (
        <article class="document-list__item" id={`document-${document.id}`} data-material-id={document.id}>
          <div class="list-row">
            <span class="meta">{metadata(document)}</span>
            <div>
              <strong>{document.title[lang]}</strong>
              <p class="small-note">{document.description[lang]}</p>
            </div>
            {document.href && document.originalAccess !== 'internal' && (
              <CalloutLink href={document.href} target="_blank" rel="noopener">
                {document.downloadLabel?.[lang] ?? (ru ? 'Исходный PDF' : 'Original PDF')} ·{' '}
                {size(document.bytes)}
              </CalloutLink>
            )}
          </div>
          <MediaGallery
            id={`document-pages-${document.id}`}
            items={pageItems(document)}
            lang={lang}
            mode="tiles"
            fit="natural"
            label={document.title[lang]}
          />
        </article>
      ))}
    </div>
  </section>
)}
