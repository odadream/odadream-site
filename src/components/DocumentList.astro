---
import type { Lang } from '../data/site';
import type { WorkDocument } from '../data/work-details';
import CalloutLink from './CalloutLink.astro';
interface Props {
  documents: Pick<
    WorkDocument,
    'id' | 'title' | 'description' | 'href' | 'year' | 'language' | 'pages' | 'bytes'
  >[];
  lang: Lang;
}
const { documents, lang } = Astro.props;
const ru = lang === 'ru';
const size = (bytes: number) =>
  new Intl.NumberFormat(lang, { maximumFractionDigits: 1 }).format(bytes / 1_000_000);
const metadata = (document: Props['documents'][number]) =>
  [
    document.year,
    'PDF',
    document.language.toUpperCase(),
    `${document.pages} ${ru ? 'стр.' : 'pp.'}`,
    `${size(document.bytes)} ${ru ? 'МБ' : 'MB'}`,
  ].join(' · ');
---

{documents.length > 0 && (
  <section class="section-body spaced-actions" aria-label={ru ? 'Архивные документы' : 'Archive documents'}>
    <h3>{ru ? 'Архивные документы' : 'Archive documents'}</h3>
    <div>
      {documents.map((document) => (
        <article class="list-row" id={`document-${document.id}`}>
          <span class="meta">{metadata(document)}</span>
          <div>
            <strong>{document.title[lang]}</strong>
            <p class="small-note">{document.description[lang]}</p>
          </div>
          <CalloutLink href={document.href} target="_blank" rel="noopener">
            {ru ? 'Открыть PDF' : 'Open PDF'}
          </CalloutLink>
        </article>
      ))}
    </div>
  </section>
)}
