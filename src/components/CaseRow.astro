---
import DevPublicationMark from './DevPublicationMark.astro';
import type { CaseEvent, Lang } from '../data/site';
import { caseUrl } from '../lib/routes';
import { caseTypeLabels, participationLabels, contextLabels, formatCaseDate } from '../lib/case-presentation';
import CalloutLink from './CalloutLink.astro';
export interface Props {
  item: Pick<
    CaseEvent,
    | 'id'
    | 'slug'
    | 'title'
    | 'summary'
    | 'date'
    | 'datePrecision'
    | 'dateMeaning'
    | 'dateEnd'
    | 'place'
    | 'type'
    | 'context'
    | 'participationStatus'
    | 'event'
  >;
  lang: Lang;
  specimen?: boolean;
  presentation?: 'catalogue' | 'overview';
  destinationStudy?: boolean;
}
const { item, lang, specimen = false, presentation = 'catalogue', destinationStudy = true } = Astro.props;
const overview = presentation === 'overview';
---

<article
  class:list={['case-row', { 'case-row--overview': overview }]}
  id={specimen ? undefined : `case-${item.slug}`}
  data-case-id={item.id}
  data-case-year={item.date.slice(0, 4)}
  data-participation-status={item.participationStatus}
>
  <DevPublicationMark kind="cases" recordId={item.id} lang={lang} />
  <p class="meta case-row__year">{item.date.slice(0, 4)}</p>
  <div class="case-row__body">
    <h3>
      <CalloutLink href={caseUrl(lang, item.id)} destinationStudy={destinationStudy}>
        {overview ? (item.event?.title[lang] ?? item.title[lang]) : item.title[lang]}
      </CalloutLink>
    </h3>
    {!overview && (
      <div class="meta case-row__metadata">
        <p>{formatCaseDate(item, lang)}</p>
        <p>{item.place[lang]}</p>
        <p>{caseTypeLabels[item.type][lang]}</p>
        <p>{participationLabels[item.participationStatus][lang]}</p>
        {item.context !== 'public' && <p>{contextLabels[item.context][lang]}</p>}
      </div>
    )}
    {overview && item.dateMeaning === 'series-start' && (
      <p class="meta">{lang === 'ru' ? 'Начало серии' : 'Series began'}</p>
    )}
    {overview && (
      <p class="meta case-row__location">
        {[item.event?.city?.[lang], item.event?.venue?.[lang]].filter(Boolean).join(' · ') ||
          (lang === 'ru' ? 'Место не указано' : 'Location not specified')}
      </p>
    )}
    <p>{item.summary[lang]}</p>
  </div>
</article>
