---
import DevPublicationMark from './DevPublicationMark.astro';
import type { CaseEvent, Lang } from '../data/site';
import { works, programmes, methods, mediaById } from '../data/catalogue';
import MediaGallery from './MediaGallery.astro';
import { caseUrl, caseTargetUrl, workUrl, programmeUrl } from '../lib/routes';
import { caseTypeLabels, participationLabels, contextLabels, formatCaseDate } from '../lib/case-presentation';
import CalloutLink from './CalloutLink.astro';
interface Props {
  item: Omit<
    CaseEvent,
    'sourceRefs' | 'organizationRoles' | 'story' | 'participants' | 'evidence' | 'organizations'
  >;
  lang: Lang;
  specimen?: boolean;
  presentation?: 'catalogue' | 'overview';
}
const { item, lang, specimen = false, presentation = 'catalogue' } = Astro.props;
const overview = presentation === 'overview';
const links = [
  ...[item.work, ...(item.relatedWorks ?? [])].flatMap((id) => {
    const work = works.find((row) => row.id === id);
    return work ? [{ href: workUrl(lang, work.id), title: work.title[lang] }] : [];
  }),
  ...[item.programme, ...(item.relatedProgrammes ?? [])].flatMap((id) => {
    const programme = programmes.find((row) => row.id === id);
    return programme ? [{ href: programmeUrl(lang, programme.id), title: programme.title[lang] }] : [];
  }),
  ...methods
    .filter((row) => row.id === item.method)
    .map((row) => ({ href: `/${lang}/technology/`, title: row.title[lang] })),
];
---

<article
  class:list={['list-row case-row', { 'case-row--overview': overview }]}
  id={specimen ? undefined : `case-${item.slug}`}
  data-case-id={item.id}
  data-participation-status={item.participationStatus}
>
  <DevPublicationMark kind="cases" recordId={item.id} lang={lang} />
  <div class="meta case-row__metadata">
    <p>
      {overview
        ? (item.dateMeaning === 'series-start' ? (lang === 'ru' ? 'С ' : 'Since ') : '') +
          item.date.slice(0, 4)
        : formatCaseDate(item, lang)}
    </p>
    {!overview && <p>{item.place[lang]}</p>}
    {!overview && <p>{caseTypeLabels[item.type][lang]}</p>}
    {!overview && <p>{participationLabels[item.participationStatus][lang]}</p>}
    {!overview && item.context !== 'public' && <p>{contextLabels[item.context][lang]}</p>}
  </div>
  <div>
    <h3>{overview ? (item.event?.title[lang] ?? item.title[lang]) : item.title[lang]}</h3>
    {overview && (
      <p class="meta case-row__location">
        {[item.event?.city?.[lang], item.event?.venue?.[lang]].filter(Boolean).join(' · ') ||
          (lang === 'ru' ? 'Место не указано' : 'Location not specified')}
      </p>
    )}
    <p>{item.summary[lang]}</p>
    {!overview && <p>{item.role[lang]}</p>}
    {!overview && item.source?.startsWith('https://') && (
      <p>
        <CalloutLink href={item.source} rel="external">
          {lang === 'ru' ? 'Источник события' : 'Event source'}
        </CalloutLink>
      </p>
    )}
    {!overview && !item.detailPage && item.limitations.map((note) => <p class="small-note">{note[lang]}</p>)}
    {!overview && !item.detailPage && !specimen && (
      <MediaGallery
        id={`case-media-${item.id}`}
        items={item.media.flatMap((id) => {
          const media = mediaById(id);
          return media ? [media] : [];
        })}
        lang={lang}
        mode={item.media.length > 1 ? 'tiles' : 'sequence'}
        label={lang === 'ru' ? 'Материалы события' : 'Event materials'}
      />
    )}
    <div class="link-row spaced-actions">
      {links.map((link) => (
        <CalloutLink href={link.href}>{link.title}</CalloutLink>
      ))}
    </div>
  </div>
  <CalloutLink href={overview || item.detailPage ? caseUrl(lang, item.id) : caseTargetUrl(lang, item)}>
    {item.detailPage
      ? lang === 'ru'
        ? overview
          ? 'Подробнее'
          : 'Открыть кейс'
        : overview
          ? 'Explore'
          : 'Open case'
      : lang === 'ru'
        ? overview
          ? 'Подробнее'
          : 'Материал'
        : overview
          ? 'Explore'
          : 'Related material'}
  </CalloutLink>
</article>
