---
import type { SourceLink } from '../data/editorial';
import type { Lang } from '../data/site';
import CalloutLink from './CalloutLink.astro';
interface Props {
  links: SourceLink[];
  lang: Lang;
}
const { links, lang } = Astro.props;
const labels = {
  video: { ru: 'Видео', en: 'Video' },
  audio: { ru: 'Интервью', en: 'Interview' },
  article: { ru: 'Публикация', en: 'Article' },
};
---

<ul
  class="source-links"
  aria-label={lang === 'ru' ? 'Материалы на внешних площадках' : 'Materials on external platforms'}
>
  {[...new Map(links.map((link) => [link.href, link])).values()].map((link) => (
    <li>
      <span class="meta">
        {link.href.includes('/works/') ? (lang === 'ru' ? 'Работа' : 'Work') : labels[link.kind][lang]}
      </span>
      <CalloutLink
        href={link.href.replace(/^https:\/\/odadream\.art/, '').replace(/^\/(ru|en)\//, `/${lang}/`)}
        rel={link.href.startsWith('https://') ? 'external' : undefined}
      >
        {link.title[lang]}
      </CalloutLink>
    </li>
  ))}
</ul>
