---
const ru = Astro.props.lang === 'ru';
---

{import.meta.env.DEV && (
  <dialog class="media-framing__editor" data-study-dialog aria-labelledby="study-editor-title">
    <form method="dialog">
      <button class="button button--quiet" aria-label={ru ? 'Закрыть кадрирование' : 'Close framing'}>
        {ru ? 'Закрыть' : 'Close'}
      </button>
    </form>
    <h2 id="study-editor-title">{ru ? 'Один фокус · все форматы' : 'One focus · all formats'}</h2>
    <p class="small-note" data-study-name></p>
    <div class="media-framing__workbench">
      <div class="media-framing__original" data-study-original>
        <img
          alt={
            ru ? 'Исходное изображение: нажмите для выбора фокуса' : 'Original image: click to choose focus'
          }
        />
        <span class="media-framing__point" aria-hidden="true"></span>
      </div>
      <div class="media-framing__settings">
        <div class="media-framing__fields">
          <label>
            {ru ? 'Фокус X, %' : 'Focus X, %'}{' '}
            <input data-study-x type="range" min="0" max="100" step="any" value="50" />
          </label>
          <label>
            {ru ? 'Фокус Y, %' : 'Focus Y, %'}{' '}
            <input data-study-y type="range" min="0" max="100" step="any" value="50" />
          </label>
          <label>
            {ru ? 'Поведение' : 'Fit'}{' '}
            <select data-study-fit>
              <option value="natural">{ru ? 'Исходные пропорции' : 'Natural proportions'}</option>
              <option value="contain">{ru ? 'Вписать целиком' : 'Fit whole image'}</option>
              <option value="cover" selected>
                {ru ? 'Заполнить с обрезкой' : 'Fill and crop'}
              </option>
            </select>
          </label>
        </div>
        <p class="small-note">
          {ru
            ? 'Фокус задаётся один раз на оригинале. «Вписать» сохраняет весь кадр с полями; «заполнить» обрезает края вокруг фокуса. Исходные пропорции подходят для плотной галереи. Для документов и афиш — вписывание целиком.'
            : 'Set one focus on the original. Fit preserves the whole image with margins; fill crops around the focus. Natural proportions suit a dense gallery. Fit documents and posters in full.'}
        </p>
        <button type="button" class="button" data-study-apply>
          {ru ? 'Применить настройки' : 'Apply settings'}
        </button>
        <button type="button" class="button button--quiet" data-study-reset>
          {ru ? 'Вернуть настройки сайта' : 'Restore site settings'}
        </button>
        <p class="small-note" role="status" data-study-status>
          {ru ? 'Настройки ещё не применены.' : 'Settings have not been applied yet.'}
        </p>
      </div>
    </div>
    <div class="media-framing__previews" data-study-previews>
      {[
        ['wide', '16:9'],
        ['square', '1:1'],
        ['portrait', '4:5'],
      ].map(([shape, label]) => (
        <figure>
          <div class="media-framing__frame" data-shape={shape}>
            <img alt={`${ru ? 'Предпросмотр' : 'Preview'} ${label}`} />
          </div>
          <figcaption>{label}</figcaption>
        </figure>
      ))}
    </div>
  </dialog>
)}
<script>
  if (import.meta.env.DEV) import('../scripts/media-framing').then((module) => module.initMediaFraming());
</script>
