---
import { type MediaItem } from '../lib/media-presentation';
import TechnicalMark from './TechnicalMark.astro';
import type { Lang } from '../data/site';
interface Props {
  item?: MediaItem;
  lang: Lang;
  view?: 'card' | 'hero' | 'gallery';
}
const { item, lang, view = 'gallery' } = Astro.props;
const editable = item && (item.poster || item.kind === 'image');
---

{import.meta.env.DEV && editable && (
  <button
    type="button"
    class="media-crop-trigger"
    data-study-crop
    data-name={item.id}
    data-src={item.kind === 'video' ? item.poster : item.src}
    aria-label={lang === 'ru' ? `Кадрирование: ${item.id}` : `Framing: ${item.id}`}
    title={lang === 'ru' ? 'Кадрирование' : 'Framing'}
    data-dev-crop
    data-crop-id={item.id}
    data-crop-src={item.kind === 'video' ? item.poster : item.src}
    data-crop-view={view}
    data-crop-title={item.alt[lang]}
    data-crop-focal={item.focalPoint ?? 'center'}
    data-crop-point-desktop={item.focalPosition ? JSON.stringify(item.focalPosition.desktop) : undefined}
    data-crop-point-mobile={
      item.focalPosition ? JSON.stringify(item.focalPosition.mobile ?? item.focalPosition.desktop) : undefined
    }
  >
    <TechnicalMark kind="crop" />
  </button>
)}
