---
import TechnicalMark from './TechnicalMark.astro';
import { mediaById } from '../data/catalogue';
import type { Lang } from '../data/site';
interface Props {
  id: string;
  lang: Lang;
  priority?: boolean;
}
const { id, lang, priority = false } = Astro.props;
const item = mediaById(id);
---

{item && (
  <figure class="media-figure">
    <div class="media-register">
      <span class="media-register__id">
        <TechnicalMark kind="record" />
        {item.kind === 'image' ? 'IMG' : 'VID'} / {item.id}
      </span>
      {item.width && item.height && (
        <span>
          {item.width} × {item.height} px
        </span>
      )}
    </div>
    {item.kind === 'image' ? (
      <button
        type="button"
        class="media-open"
        data-lightbox
        data-src={item.src}
        data-alt={item.alt[lang]}
        data-caption={item.caption[lang]}
        aria-label={lang === 'en' ? `Enlarge: ${item.alt.en}` : `Увеличить: ${item.alt.ru}`}
      >
        <picture>
          {item.mobileSrc && <source media="(max-width: 700px)" srcset={item.mobileSrc} />}
          <img
            src={item.src}
            alt={item.alt[lang]}
            width={item.width}
            height={item.height}
            loading={priority ? 'eager' : 'lazy'}
            decoding={priority ? 'sync' : 'async'}
            fetchpriority={priority ? 'high' : 'auto'}
          />
        </picture>
        <span class="media-open__mark">
          <TechnicalMark kind="open" />
        </span>
      </button>
    ) : (
      <video src={item.src} poster={item.poster} controls playsinline preload="none" />
    )}
    <figcaption>{item.caption[lang]}</figcaption>
  </figure>
)}
