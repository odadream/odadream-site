---
import DisclosureHeading from './DisclosureHeading.astro';
import TechnicalMark from './TechnicalMark.astro';
import type { MediaItem } from '../lib/media-presentation';
import type { Lang } from '../data/site';
interface Props {
  item: MediaItem;
  lang: Lang;
  disclosure?: boolean;
}
const { item, lang, disclosure = false } = Astro.props;
const Wrapper = disclosure ? 'details' : 'div';
---

<Wrapper
  class:list={{ 'media-details': disclosure }}
  data-media-register={disclosure ? 'disclosure' : 'expanded'}
>
  {disclosure && (
    <DisclosureHeading>{lang === 'ru' ? 'Реквизиты материала' : 'Material details'}</DisclosureHeading>
  )}
  <div class="media-register">
    <span class="media-register__id">
      <TechnicalMark
        kind={
          item.kind === 'video'
            ? 'video'
            : item.representation === 'document'
              ? 'document'
              : item.representation === 'diagram'
                ? 'diagram'
                : 'image'
        }
      />
      <span class="media-register__name" title={item.id}>
        {item.id}
      </span>
    </span>
    {item.width && item.height && (
      <span class="media-register__dimensions">
        {item.width} × {item.height} px
      </span>
    )}
  </div>
</Wrapper>
