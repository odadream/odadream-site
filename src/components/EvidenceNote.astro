---
import type { Evidence, Lang } from '../data/site';
import CalloutLink from './CalloutLink.astro';
interface Props {
  item: Pick<Evidence, 'title' | 'claim' | 'sourceLabel' | 'source'>;
  lang: Lang;
  compact?: boolean;
  omitSource?: boolean;
}
const { item, lang, compact = false, omitSource = false } = Astro.props;
---

<details class="provenance" open={!compact}>
  <summary>{item.title[lang]}</summary>

  <p>{item.claim[lang]}</p>
  <p class="small-note">{item.sourceLabel[lang]}</p>
  {!omitSource && /^https?:\/\//.test(item.source) && (
    <CalloutLink href={item.source}>{lang === 'ru' ? 'Первоисточник' : 'Source'}</CalloutLink>
  )}
</details>
