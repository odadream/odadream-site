---
import type { EditorialSection } from '../data/editorial';
import type { Lang } from '../data/site';
import SourceLinks from './SourceLinks.astro';
interface Props {
  sections: EditorialSection[];
  lang: Lang;
  anchorPrefix: string;
  excludeSources?: string[];
  presentedMedia?: string[];
}
const { sections, lang, anchorPrefix, excludeSources = [], presentedMedia = [] } = Astro.props;
---

<div class="editorial-sections">
  {sections.map((section) => (
    <article id={`${anchorPrefix}-${section.id}`}>
      <h3>{section.title[lang]}</h3>
      {section.body[lang].split(/\n\s*\n/).map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      {section.links && (
        <SourceLinks
          links={section.links.filter(
            (link) =>
              !excludeSources.includes(link.href) &&
              !(link.representedByMedia && presentedMedia.includes(link.representedByMedia)),
          )}
          lang={lang}
        />
      )}
    </article>
  ))}
</div>
