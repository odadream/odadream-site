---
import RecordStamp from './RecordStamp.astro';
import { preview } from '../data/catalogue';
import { siteStats } from '../lib/site-stats';
import { workStageLabels, type Lang } from '../data/site';
interface Props {
  kind: 'works' | 'events' | 'recognition' | 'education';
  lang: Lang;
}
const { kind, lang } = Astro.props;
const ru = lang === 'ru';
const titles = {
  education: ru ? 'Образовательные программы сайта' : 'Educational programmes on this site',
  works: ru ? 'Каталог сайта' : 'Site catalogue',
  events: ru ? 'Охват реестра' : 'Registry coverage',
  recognition: ru ? 'Учёт документов' : 'Document inventory',
};
const fields =
  kind === 'education'
    ? [
        { label: ru ? 'Программы' : 'Programmes', value: siteStats.education.total, metric: true },
        { label: ru ? 'Лекции' : 'Lectures', value: siteStats.education.lectures, metric: true },
        { label: ru ? 'Практикумы' : 'Workshops', value: siteStats.education.workshops, metric: true },
        {
          label: ru ? 'Учебные лаборатории' : 'Educational laboratories',
          value: siteStats.education.laboratories,
          metric: true,
        },
      ]
    : kind === 'works'
      ? [
          {
            label: ru ? 'Работы в каталоге' : 'Catalogued works',
            value: siteStats.works.total,
            metric: true,
          },
          { label: ru ? 'Реализовано' : 'Realized', value: siteStats.works.realized, metric: true },
          { label: 'R&D', value: siteStats.works.research, metric: true },
          {
            label: ru ? 'Заказ обсуждаем' : 'Commission inquiries',
            value: siteStats.works.bookable,
            metric: true,
          },
        ]
      : kind === 'events'
        ? [
            {
              label: ru ? 'События в каталоге' : 'Catalogued events',
              value: siteStats.cases.total,
              metric: true,
            },
            {
              label: ru ? 'Участие состоялось' : 'Completed contributions',
              value: siteStats.cases.byStatus.held ?? 0,
              metric: true,
            },
            {
              label: ru ? 'Приглашения' : 'Invitations',
              value: siteStats.cases.byStatus.invited ?? 0,
              metric: true,
            },
            {
              label: ru ? 'Заявки' : 'Applications',
              value: (siteStats.cases.byStatus.submitted ?? 0) + (siteStats.cases.byStatus.declined ?? 0),
              metric: true,
            },
            ...(preview
              ? [
                  {
                    label: ru ? 'Папки событий · Golem' : 'Event folders · Golem',
                    value: siteStats.golemEvents.total,
                    metric: true,
                  },
                  {
                    label: ru ? 'Снимок реестра' : 'Registry snapshot',
                    value: siteStats.golemEvents.generatedAt.slice(0, 10),
                  },
                ]
              : []),
          ]
        : preview
          ? [
              {
                label: ru ? 'Прежний перечень' : 'Former archive list',
                value: siteStats.legacyRecognition.total,
                metric: true,
              },
              {
                label: ru ? 'Дипломы' : 'Diplomas',
                value: siteStats.legacyRecognition.byKind.diploma,
                metric: true,
              },
              {
                label: ru ? 'Благодарственные письма' : 'Letters of appreciation',
                value: siteStats.legacyRecognition.byKind.letter,
                metric: true,
              },
              {
                label: ru ? 'Подтверждения участия' : 'Participation records',
                value: siteStats.legacyRecognition.byKind.participation,
                metric: true,
              },
            ]
          : [
              {
                label: ru ? 'Документы на сайте' : 'Documents on this site',
                value: siteStats.recognitions.total,
                metric: true,
              },
            ];
---

<RecordStamp tone="reference" title={titles[kind]} fields={fields}>
  {kind === 'works' && (
    <details class="record-stamp__more">
      <summary>{ru ? 'Состав по стадиям' : 'Stage breakdown'}</summary>
      <dl>
        {Object.entries(siteStats.works.byStage).map(([status, count]) => (
          <div>
            <dt>{workStageLabels[status as keyof typeof workStageLabels][lang]}</dt>
            <dd>{count}</dd>
          </div>
        ))}
      </dl>
    </details>
  )}
  {kind === 'events' && preview && (
    <p class="record-stamp__note">
      {ru
        ? 'Golem учитывает архивные папки. Это отдельная выборка, ещё не проверенные публичные кейсы.'
        : 'Golem counts archival folders: a separate inventory, not yet reviewed public cases.'}
    </p>
  )}
  {kind === 'recognition' && preview && (
    <p class="record-stamp__note">
      {ru
        ? `${siteStats.recognitions.total} записей перенесены в новую модель. Права и атрибуция проверяются.`
        : `${siteStats.recognitions.total} records are structured in the new model. Rights and attribution are under review.`}
    </p>
  )}
</RecordStamp>
