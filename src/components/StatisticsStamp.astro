---
import DisclosureHeading from './DisclosureHeading.astro';
import RecordStamp from './RecordStamp.astro';
import { siteStats, workStages } from '../lib/site-stats';
import { eventGenres, eventGenreLabels } from '../lib/case-presentation';
import { recognitionKinds, recognitionKindLabels } from '../lib/recognition-presentation';
import { workStageLabels, type Lang } from '../data/site';
interface Props {
  kind: 'works' | 'events' | 'recognition' | 'education';
  lang: Lang;
}
const { kind, lang } = Astro.props;
const ru = lang === 'ru';
const titles = {
  education: ru ? 'Образовательные программы' : 'Educational programmes',
  works: ru ? 'Каталог работ' : 'Work catalogue',
  events: ru ? 'Состоявшиеся события' : 'Completed events',
  recognition: ru ? 'Признания' : 'Recognition',
};
const metric = (label: string, value: number) => ({ label, value, metric: true });
const fields =
  kind === 'works'
    ? [metric(ru ? 'Работы в каталоге' : 'Catalogued works', siteStats.works.total)]
    : kind === 'events'
      ? [metric(ru ? 'События в каталоге' : 'Catalogued events', siteStats.cases.total)]
      : kind === 'recognition'
        ? [
            metric(ru ? 'Записи признаний' : 'Recognition entries', siteStats.recognitions.total),
            ...recognitionKinds.map((key) =>
              metric(recognitionKindLabels[key][lang], siteStats.recognitions.byKind[key]),
            ),
          ]
        : [
            metric(ru ? 'Программы' : 'Programmes', siteStats.education.total),
            metric(ru ? 'Лекции' : 'Lectures', siteStats.education.lectures),
            metric(ru ? 'Практикумы' : 'Workshops', siteStats.education.workshops),
            metric(ru ? 'Учебные лаборатории' : 'Educational laboratories', siteStats.education.laboratories),
          ];
const breakdown =
  kind === 'works'
    ? workStages.map((key) => ({ label: workStageLabels[key][lang], count: siteStats.works.byStage[key] }))
    : kind === 'events'
      ? eventGenres.map((key) => ({
          label: eventGenreLabels[key][lang],
          count: siteStats.cases.byGenre[key],
        }))
      : [];
---

<RecordStamp tone="reference" title={titles[kind]} fields={fields}>
  {breakdown.length > 0 && (
    <details class="record-stamp__more">
      <DisclosureHeading>
        {kind === 'works'
          ? ru
            ? 'Состав по стадиям'
            : 'Stage breakdown'
          : ru
            ? 'По категориям событий'
            : 'Event categories'}
      </DisclosureHeading>
      <dl>
        {breakdown.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd>{row.count}</dd>
          </div>
        ))}
      </dl>
    </details>
  )}
</RecordStamp>
