---
import CalloutLink from './CalloutLink.astro';
import { mediaById } from '../data/catalogue';
import { workStageLabels, type Lang, type Work } from '../data/site';
import { workUrl } from '../lib/routes';
interface Props {
  item: Pick<Work, 'id' | 'stage' | 'media' | 'category' | 'year' | 'title' | 'summary'>;
  lang: Lang;
  eager?: boolean;
}
const { item, lang, eager = false } = Astro.props;
const media = mediaById(item.media[0]);
---

<article class="work-card" data-motion-card data-work-id={item.id} data-work-stage={item.stage}>
  <a class="work-card__link" href={workUrl(lang, item.id)}>
    <span class="work-card__media" data-media-id={media?.id}>
      <span class="work-card__visual">
        <img
          src={media?.kind === 'video' ? media.poster : media?.src}
          alt={media?.alt[lang]}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
        {media?.previewSrc && (
          <video muted playsinline loop preload="none" poster={media.src} aria-hidden="true" data-preview>
            <source src={media.previewSrc} type="video/mp4" />
          </video>
        )}
      </span>
      {media?.representation === 'illustration' && (
        <span class="work-card__media-note">
          {lang === 'ru' ? 'Иллюстрация метода' : 'Method illustration'}
        </span>
      )}
    </span>
    <span class="meta work-card__meta">
      <span class="work-card__identity">
        <span class="work-card__category">{item.category[lang]}</span>
        {item.year !== null && (
          <span class="work-card__year">
            · <time datetime={String(item.year)}>{item.year}</time>
          </span>
        )}
      </span>
      {item.stage !== 'realized' && (
        <span class="work-card__status" data-work-stage={item.stage}>
          {workStageLabels[item.stage][lang]}
        </span>
      )}
    </span>
    <h3>
      <CalloutLink>{item.title[lang]}</CalloutLink>
    </h3>
    <p>{item.summary[lang]}</p>
  </a>
</article>
