---
import { mediaById, type Lang, type Work } from '../data/site';
import { workUrl } from '../lib/routes';
interface Props {
  item: Work;
  index: number;
  lang: Lang;
  eager?: boolean;
}
const { item, index, lang, eager = false } = Astro.props;
const media = mediaById(item.media[0]);
---

<article class="work-card" data-motion-card>
  <a class="work-card__link" href={workUrl(lang, item.id)}>
    <span class="work-card__visual">
      <img src={media?.src} alt={media?.alt[lang]} loading={eager ? 'eager' : 'lazy'} decoding="async" />
      {media?.previewSrc && (
        <video muted playsinline loop preload="none" poster={media.src} aria-hidden="true" data-preview>
          <source src={media.previewSrc} type="video/mp4" />
        </video>
      )}
    </span>
    <span class="meta work-card__meta">
      <span>
        <span class="index">{String(index + 1).padStart(2, '0')}</span> / {item.category[lang]}
      </span>
      <span>{item.status[lang]}</span>
    </span>
    <h3>{item.title[lang]}</h3>
    <p>{item.summary[lang]}</p>
  </a>
</article>
