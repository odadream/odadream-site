---
import DevPublicationMark from './DevPublicationMark.astro';
import CalloutLink from './CalloutLink.astro';
import VideoPreview from './VideoPreview.astro';
import { mediaById } from '../data/catalogue';
import { fullFrameRepresentations } from '../lib/media-presentation';
import { workStageLabels, type Lang, type Work } from '../data/site';
import { workUrl } from '../lib/routes';
interface Props {
  item: Pick<Work, 'id' | 'stage' | 'media' | 'category' | 'year' | 'title' | 'summary' | 'mediaNote'>;
  lang: Lang;
  eager?: boolean;
}
const { item, lang, eager = false } = Astro.props;
const media = mediaById(item.media[0]);
const contain =
  media &&
  (fullFrameRepresentations.has(media.representation ?? '') ||
    (media.width && media.height && media.width < media.height));
const labels = {
  illustration: { ru: 'Иллюстрация метода', en: 'Method illustration' },
  render: { ru: 'Визуализация проекта', en: 'Project visualization' },
  diagram: { ru: 'Схема / эскиз', en: 'Scheme / sketch' },
  poster: { ru: 'Архивная афиша', en: 'Archival poster' },
  document: { ru: 'Документ', en: 'Document' },
  screenshot: { ru: 'Кадр интерфейса', en: 'Interface screenshot' },
  photograph: undefined,
};
---

<article class="work-card" data-motion-card data-work-id={item.id} data-work-stage={item.stage}>
  <DevPublicationMark kind="works" recordId={item.id} lang={lang} />
  <a class="work-card__link" data-preview-trigger href={workUrl(lang, item.id)}>
    <span class="work-card__media" data-media-id={media?.id}>
      <span class="work-card__visual" data-fit={contain ? 'contain' : 'cover'}>
        {media &&
          (media.previewSrc && media.poster ? (
            <VideoPreview
              src={media.previewSrc}
              poster={media.poster}
              alt={media.alt[lang]}
              width={media.width}
              height={media.height}
              priority={eager}
              focusable={false}
            />
          ) : (
            <img
              src={media?.kind === 'video' ? media.poster : media?.src}
              alt={media?.alt[lang]}
              loading={eager ? 'eager' : 'lazy'}
              decoding="async"
            />
          ))}
      </span>
      {media?.representation && labels[media.representation] && (
        <span class="work-card__media-note">{labels[media.representation]![lang]}</span>
      )}
      {!media && (
        <span class="work-card__media-note">
          {item.mediaNote?.[lang] ??
            (lang === 'ru'
              ? 'Визуальный материал пока не опубликован.'
              : 'Visual material is not published yet.')}
        </span>
      )}
    </span>
    <span class="meta work-card__meta">
      <span class="work-card__identity">
        <span class="work-card__category">{item.category[lang]}</span>
        {item.year !== null && (
          <span class="work-card__year">
            · <time datetime={String(item.year)}>{item.year}</time>
          </span>
        )}
      </span>
      {item.stage !== 'realized' && (
        <span class="work-card__status" data-work-stage={item.stage}>
          {workStageLabels[item.stage][lang]}
        </span>
      )}
    </span>
    <h3>
      <CalloutLink>{item.title[lang]}</CalloutLink>
    </h3>
    <p>{item.summary[lang]}</p>
  </a>
</article>
