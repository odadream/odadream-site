---
interface Props {
  href?: string;
  class?: string;
  rel?: string;
  target?: string;
}

const { href, class: className, rel, target } = Astro.props;
// Without href, decorate the title inside an existing card anchor.
const Tag = href ? 'a' : 'span';
---

<Tag
  class:list={['callout-link', { 'quiet-link': !!href }, className]}
  href={href}
  rel={rel}
  target={target}
  data-callout-link
>
  <slot />
</Tag>

<script>
  import '../scripts/callout-links.js';
</script>
