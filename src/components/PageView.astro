---
import MediaFigure from './MediaFigure.astro';
import { cases, evidence, formats, mediaById, organizations, people, works, workById } from '../data/site';
import { caseUrl, formatUrl, workUrl, type Page } from '../lib/routes';
interface Props {
  page: Page;
}
const { page } = Astro.props;
const lang = page.lang;
const ru = lang === 'ru';
const work = page.kind === 'work' ? works.find((x) => x.slug === page.slug) : undefined;
const oneCase = page.kind === 'case' ? cases.find((x) => x.slug === page.slug) : undefined;
const sectionName = {
  home: ru ? 'Главная' : 'Home',
  works: ru ? 'Работы' : 'Works',
  formats: ru ? 'Форматы' : 'Formats',
  cooperation: ru ? 'Сотрудничество' : 'Cooperation',
  studio: ru ? 'Студия' : 'Studio',
  cases: ru ? 'Кейсы' : 'Cases',
  contact: ru ? 'Контакт' : 'Contact',
};
---

{page.kind === 'home' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">ODA.DREAM / ART · PERCEPTION · TECHNOLOGY</p>
      <h1>{ru ? 'Состояние человека как художественный материал.' : 'Human state as artistic material.'}</h1>
      <p class="lead">
        {ru
          ? 'ODA.dream создаёт партисипаторные спектакли, инсталляции и объекты, в которых человек не зритель технологии, а участник художественного события.'
          : 'ODA.dream creates participatory performances, installations and objects in which a person is not a spectator of technology, but part of the artwork.'}
      </p>
    </section>
    <div class="shell">
      <div class="feature-split">
        <MediaFigure id="interference-stage" lang={lang} priority />
        <div>
          <span class="eyebrow">01 / {ru ? 'Избранная работа' : 'Selected work'}</span>
          <h2 class="feature-title">{works[0].title[lang]}</h2>
          <p>{works[0].summary[lang]}</p>
          <a class="quiet-link" href={workUrl(lang, 'interference')}>
            {ru ? 'Смотреть работу' : 'Explore the work'} ↗
          </a>
        </div>
      </div>
    </div>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">02</span>
        <span class="eyebrow">{ru ? 'Практика' : 'Practice'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Художественная форма первична.' : 'The artistic form comes first.'}</h2>
        <p>
          {ru
            ? 'Мы работаем с вниманием, движением, рассказом и совместным восприятием. Сенсоры, код и генеративная графика нужны там, где они открывают новую драматургию, а не подменяют её.'
            : 'We work with attention, movement, narrative and shared perception. Sensors, code and generative imagery matter when they open a new dramaturgy, not when they replace one.'}
        </p>
        <div class="link-row">
          <a class="quiet-link" href={`/${lang}/studio/`}>
            {ru ? 'О студии' : 'About the studio'} ↗
          </a>
          <a class="quiet-link" href={`/${lang}/formats/`}>
            {ru ? 'Форматы' : 'Formats'} ↗
          </a>
        </div>
      </div>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">03</span>
        <span class="eyebrow">{ru ? 'Шесть работ' : 'Six works'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Избранное' : 'Selected works'}</h2>
        <div class="work-grid">
          {works.map((item, i) => (
            <article class="work-card">
              <a href={workUrl(lang, item.id)}>
                <img
                  src={mediaById(item.media[0])?.src}
                  alt={mediaById(item.media[0])?.alt[lang]}
                  loading="lazy"
                  decoding="async"
                />
                <div class="meta">
                  <span>
                    {String(i + 1).padStart(2, '0')} / {item.category[lang]}
                  </span>
                  <span>{item.status[lang]}</span>
                </div>
                <h3>{item.title[lang]}</h3>
                <p>{item.summary[lang]}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">04</span>
        <span class="eyebrow">{ru ? 'Контекст' : 'Context'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Работы в реальном пространстве' : 'Works in public space'}</h2>
        <p>
          {ru
            ? 'Фестивальные показы и отдельные заказы дают проверяемый контекст — с датой, местом, ролью команды и ссылкой на исходную запись.'
            : 'Festival presentations and commissioned events provide verifiable context: date, place, our role and the underlying source record.'}
        </p>
        {cases.slice(0, 3).map((item) => (
          <div class="list-row">
            <span class="meta">
              {item.date} · {item.place[lang]}
            </span>
            <div>
              <h3>{item.title[lang]}</h3>
              <p>{item.summary[lang]}</p>
            </div>
            <a class="quiet-link" href={caseUrl(lang, item.id)}>
              {ru ? 'Кейс' : 'Case'} ↗
            </a>
          </div>
        ))}
        <a class="quiet-link" href={`/${lang}/cases/`}>
          {ru ? 'Все кейсы' : 'All cases'} ↗
        </a>
      </div>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">05</span>
        <span class="eyebrow">{ru ? 'Связь' : 'Contact'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Есть проект или вопрос?' : 'Have a project or a question?'}</h2>
        <p>
          {ru
            ? 'Обсудим показ, адаптацию готового формата или совместное исследование.'
            : 'Let’s discuss a presentation, an adapted format or a shared investigation.'}
        </p>
        <a class="quiet-link" href={`/${lang}/contact/`}>
          {ru ? 'Связаться со студией' : 'Contact the studio'} ↗
        </a>
      </div>
    </section>
  </>
)}
{page.kind === 'works' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">01 / {sectionName.works}</p>
      <h1>{ru ? 'Работы' : 'Works'}</h1>
      <p class="lead">
        {ru
          ? 'Произведения, лаборатории и объекты. Работа — это художественная идея и её история; формат заказа описан отдельно.'
          : 'Artworks, laboratories and objects. A work has its own artistic history; bookable configurations are described separately.'}
      </p>
    </section>
    <section class="shell">
      <div class="work-grid">
        {works.map((item, i) => (
          <article class="work-card">
            <a href={workUrl(lang, item.id)}>
              <img
                src={mediaById(item.media[0])?.src}
                alt={mediaById(item.media[0])?.alt[lang]}
                loading="lazy"
                decoding="async"
              />
              <div class="meta">
                <span>
                  {String(i + 1).padStart(2, '0')} / {item.category[lang]}
                </span>
                <span>{item.status[lang]}</span>
              </div>
              <h3>{item.title[lang]}</h3>
              <p>{item.summary[lang]}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  </>
)}
{work && (
  <article class="shell page-intro">
    <nav class="breadcrumbs" aria-label={ru ? 'Навигационная цепочка' : 'Breadcrumbs'}>
      <a href={`/${lang}/`}>{ru ? 'Главная' : 'Home'}</a>
      <span>/</span>
      <a href={`/${lang}/works/`}>{ru ? 'Работы' : 'Works'}</a>
      <span>/</span>
      <span>{work.title[lang]}</span>
    </nav>
    <div class="work-layout">
      <aside class="work-aside">
        <span class="eyebrow">{work.category[lang]}</span>
        <span class="status">{work.status[lang]}</span>
        <span class="meta">{work.source}</span>
      </aside>
      <div class="work-main">
        <h1>{work.title[lang]}</h1>
        <p class="lead">{work.experience[lang]}</p>
        <MediaFigure id={work.media[0]} lang={lang} priority />
        <section class="work-section">
          <span class="eyebrow">01 / {ru ? 'Художественная ставка' : 'Artistic question'}</span>
          <h2>{work.question[lang]}</h2>
          <p>{work.summary[lang]}</p>
        </section>
        <section class="work-section">
          <span class="eyebrow">02 / {ru ? 'Контекст' : 'Context'}</span>
          <h2>{ru ? 'Подтверждённые факты' : 'Documented facts'}</h2>
          <ul class="facts">
            {work.facts[lang].map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
          {work.cases.length > 0 && (
            <div class="link-row spaced-actions">
              {work.cases.map((id) => (
                <a class="quiet-link" href={caseUrl(lang, id)}>
                  {cases.find((x) => x.id === id)?.title[lang]} ↗
                </a>
              ))}
            </div>
          )}
        </section>
        {['interference', 'mindshow', 'neurobattle'].includes(work.id) && (
          <section class="work-section">
            <span class="eyebrow">03 / {ru ? 'Опыт и метод' : 'Experience and method'}</span>
            <h2>{ru ? 'Человек внутри работы' : 'The participant inside the work'}</h2>
            <p>{work.experience[lang]}</p>
            <p>
              {work.id === 'interference'
                ? ru
                  ? 'Движение, выбор и рассказ соседствуют с виртуальным пространством, которое остаётся самостоятельной сценой. ЭЭГ и компьютерное зрение присутствуют как художественные инструменты, но не выдают точную карту внутреннего мира.'
                  : 'Movement, choice and narrative meet a virtual space that remains a stage in its own right. EEG and computer vision act as artistic instruments, not a precise map of inner life.'
                : work.id === 'mindshow'
                  ? ru
                    ? 'Состояние участника и его слова участвуют в генерации визуального сюжета. Разные версии произведения имеют разный технический состав, поэтому конфигурация оговаривается отдельно.'
                    : 'A participant’s state and words shape a visual sequence. Versions differ technically, so the configuration is agreed for each context.'
                  : ru
                    ? 'Система показывает относительные изменения в моменте, а не сравнивает интеллект или «силу мозга». Участие не требует предварительной подготовки.'
                    : 'The system shows relative changes in the moment, not intelligence or “brain power”. No advance training is needed.'}
            </p>
          </section>
        )}
        <section class="work-section">
          <span class="eyebrow">04 / {ru ? 'Доступность' : 'Availability'}</span>
          <h2>{ru ? 'Как работать с проектом' : 'Working with the project'}</h2>
          <p>{work.availability[lang]}</p>
          {work.formats.length > 0 && (
            <div class="link-row spaced-actions">
              {work.formats.map((id) => (
                <a class="quiet-link" href={formatUrl(lang, id)}>
                  {formats.find((x) => x.id === id)?.title[lang]} ↗
                </a>
              ))}
            </div>
          )}
          <div class="link-row spaced-actions">
            <a class="button primary" href={`/${lang}/contact/`}>
              {ru ? 'Обсудить проект' : 'Discuss a project'}
            </a>
          </div>
        </section>
        <div class="provenance">
          <strong>{ru ? 'Источник и права' : 'Source and rights'}</strong>
          <p>
            {ru
              ? 'Описание сверено с архивной карточкой ODA.dream. Права на представленное изображение требуют редакционного подтверждения до публикации.'
              : 'Description checked against the ODA.dream archive record. Image rights require editorial confirmation before publication.'}
          </p>
          <p>{work.source}</p>
        </div>
      </div>
    </div>
  </article>
)}
{page.kind === 'formats' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">02 / {sectionName.formats}</p>
      <h1>{ru ? 'Форматы' : 'Formats'}</h1>
      <p class="lead">
        {ru
          ? 'Формат — это согласуемая конфигурация работы или отдельная образовательная программа. Наличие реализованной работы само по себе не означает готовность к заказу.'
          : 'A format is an agreed configuration of a work or an educational programme. A realized artwork is not automatically available to commission.'}
      </p>
    </section>
    <section class="shell">
      {formats.map((item, i) => (
        <article class="section section-grid" id={item.slug}>
          <div class="section-label">
            <span class="index">0{i + 1}</span>
            <span class="eyebrow">{ru ? 'Конфигурация' : 'Configuration'}</span>
          </div>
          <div class="section-body">
            <h2>{item.title[lang]}</h2>
            <p class="lead">{item.summary[lang]}</p>
            <p>{item.scope[lang]}</p>
            <div class="link-row">
              {item.works.map((id) => (
                <a class="quiet-link" href={workUrl(lang, id)}>
                  {workById(id)?.title[lang]} ↗
                </a>
              ))}
              <a class="quiet-link" href={`/${lang}/cooperation/`}>
                {ru ? 'Условия сотрудничества' : 'Cooperation details'} ↗
              </a>
            </div>
          </div>
        </article>
      ))}
    </section>
  </>
)}
{page.kind === 'cooperation' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">03 / {sectionName.cooperation}</p>
      <h1>{ru ? 'Сотрудничество' : 'Cooperation'}</h1>
      <p class="lead">
        {ru
          ? 'Можно пригласить существующую работу, адаптировать формат или разработать новый художественный проект совместно.'
          : 'Present an existing work, adapt a format or develop a new artistic project together.'}
      </p>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">01</span>
        <span class="eyebrow">{ru ? 'Три маршрута' : 'Three paths'}</span>
      </div>
      <div class="section-body">
        {[
          [
            ru ? 'Показ работы' : 'Present a work',
            ru
              ? 'Обсуждаем площадку, команду, технические условия и права на документацию.'
              : 'We discuss venue, team, technical conditions and documentation rights.',
          ],
          [
            ru ? 'Адаптация формата' : 'Adapt a format',
            ru
              ? 'MindShow и «Нейробитва» имеют существующие конфигурации, но состав каждого заказа фиксируется отдельно.'
              : 'MindShow and Neurobattle have existing configurations, but each commission is scoped separately.',
          ],
          [
            ru ? 'Совместная разработка' : 'Co-develop',
            ru
              ? 'Для нового произведения формулируем художественный вопрос, исследовательский метод, этапы и ответственность сторон.'
              : 'For a new work we define the artistic question, method, phases and responsibilities.',
          ],
        ].map(([title, body], i) => (
          <div class="list-row">
            <span class="index">0{i + 1}</span>
            <div>
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">02</span>
        <span class="eyebrow">{ru ? 'Что сообщить' : 'What to send'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Начните с контекста' : 'Start with the context'}</h2>
        <p>
          {ru
            ? 'Полезны дата, город, площадка, предполагаемая аудитория, желаемая форма участия и бюджетный диапазон. Если задача ещё не оформлена — опишите её как есть.'
            : 'A date, city, venue, intended audience, desired form of participation and budget range help us respond. If the brief is still open, describe what you know.'}
        </p>
        <a class="button primary" href={`/${lang}/contact/`}>
          {ru ? 'Написать нам' : 'Write to us'}
        </a>
      </div>
    </section>
  </>
)}
{page.kind === 'studio' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">04 / {sectionName.studio}</p>
      <h1>{ru ? 'Студия ODA.dream' : 'ODA.dream studio'}</h1>
      <p class="lead">
        {ru
          ? 'Ольга и Далер Арабовы создают произведения на пересечении сценического искусства, человеческого восприятия и технологических систем.'
          : 'Olga and Daler Arabov create work at the intersection of performance, human perception and technological systems.'}
      </p>
    </section>
    <section class="section shell section-grid" id="people">
      <div class="section-label">
        <span class="index">01</span>
        <span class="eyebrow">{ru ? 'Люди' : 'People'}</span>
      </div>
      <div class="section-body">
        <h2>{people[0].name[lang]}</h2>
        <p>
          {people[0].role[lang]}.{' '}
          {ru
            ? 'Для каждого проекта команда расширяется за счёт художников, исполнителей и технических специалистов. Роли соавторов отмечаются на страницах конкретных работ.'
            : 'Each project brings in artists, performers and technical specialists. Co-authorship is credited in the context of each work.'}
        </p>
      </div>
    </section>
    <section class="section shell section-grid" id="milestones">
      <div class="section-label">
        <span class="index">02</span>
        <span class="eyebrow">{ru ? 'Вехи' : 'Milestones'}</span>
      </div>
      <div class="section-body">
        {cases.map((item) => (
          <div class="list-row">
            <span class="meta">{item.date}</span>
            <div>
              <h3>{item.title[lang]}</h3>
              <p>{item.place[lang]}</p>
            </div>
            <a class="quiet-link" href={caseUrl(lang, item.id)}>
              {ru ? 'Детали' : 'Details'} ↗
            </a>
          </div>
        ))}
      </div>
    </section>
    <section class="section shell section-grid" id="method">
      <div class="section-label">
        <span class="index">03</span>
        <span class="eyebrow">{ru ? 'Метод и этика' : 'Method and ethics'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Данные не объясняют человека.' : 'Data does not explain a person.'}</h2>
        <p>
          {ru
            ? 'Сигналы в работах используются как материал для художественного взаимодействия, а не для медицинских или психологических выводов. Для каждого показа отдельно определяются согласие участников, хранение данных, права на изображение и документацию.'
            : 'Signals in our work become material for artistic interaction, not medical or psychological claims. Consent, data retention, image rights and documentation terms are established for each presentation.'}
        </p>
      </div>
    </section>
    <section class="section shell section-grid" id="evidence">
      <div class="section-label">
        <span class="index">04</span>
        <span class="eyebrow">{ru ? 'Подтверждение' : 'Evidence'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Проверяемый контекст' : 'Verifiable context'}</h2>
        <p>
          {ru
            ? 'В кейсах указаны события, даты, места и роли организаций. Благодарности и цитаты не публикуются без отдельного разрешения.'
            : 'Cases name events, dates, places and organizational roles. Letters and quotations are not published without separate permission.'}
        </p>
        <a class="quiet-link" href={`/${lang}/cases/`}>
          {ru ? 'Смотреть кейсы' : 'See cases'} ↗
        </a>
      </div>
    </section>
  </>
)}
{page.kind === 'cases' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">05 / {sectionName.cases}</p>
      <h1>{ru ? 'Кейсы и события' : 'Cases and events'}</h1>
      <p class="lead">
        {ru
          ? 'Конкретные показы и заказы, отделённые от художественных описаний работ. Роли организаций указаны только в пределах подтверждённых источников.'
          : 'Specific presentations and commissions, distinct from the artistic description of each work. Organizational roles are stated only as supported by source records.'}
      </p>
    </section>
    <section class="shell">
      {cases.map((item) => (
        <article class="list-row">
          <span class="meta">
            {item.date}
            <br />
            {item.place[lang]}
          </span>
          <div>
            <h3>{item.title[lang]}</h3>
            <p>{item.summary[lang]}</p>
            <p>{item.role[lang]}</p>
          </div>
          <a class="quiet-link" href={caseUrl(lang, item.id)}>
            {ru ? 'Открыть' : 'Open'} ↗
          </a>
        </article>
      ))}
    </section>
  </>
)}
{oneCase && (
  <article class="shell page-intro">
    <nav class="breadcrumbs" aria-label={ru ? 'Навигационная цепочка' : 'Breadcrumbs'}>
      <a href={`/${lang}/`}>{ru ? 'Главная' : 'Home'}</a>
      <span>/</span>
      <a href={`/${lang}/cases/`}>{ru ? 'Кейсы' : 'Cases'}</a>
      <span>/</span>
      <span>{oneCase.title[lang]}</span>
    </nav>
    <div class="work-layout">
      <aside class="work-aside">
        <span class="eyebrow">{oneCase.date}</span>
        <span class="meta">{oneCase.place[lang]}</span>
      </aside>
      <div class="work-main">
        <h1>{oneCase.title[lang]}</h1>
        <p class="lead">{oneCase.summary[lang]}</p>
        <MediaFigure id={oneCase.media[0]} lang={lang} priority />
        <section class="work-section">
          <span class="eyebrow">01 / {ru ? 'Участие' : 'Participation'}</span>
          <h2>{ru ? 'Роль ODA.dream' : 'ODA.dream’s role'}</h2>
          <p>{oneCase.role[lang]}</p>
          <a class="quiet-link" href={workUrl(lang, oneCase.work)}>
            {ru ? 'Связанная работа' : 'Related work'}: {workById(oneCase.work)?.title[lang]} ↗
          </a>
        </section>
        <section class="work-section">
          <span class="eyebrow">02 / {ru ? 'Контекст' : 'Context'}</span>
          <h2>{ru ? 'Организации и источники' : 'Organizations and sources'}</h2>
          {oneCase.organizations.length ? (
            <ul class="facts">
              {oneCase.organizations.map((id) => (
                <li>
                  {organizations.find((org) => org.id === id)?.name[lang]} ·{' '}
                  {organizations.find((org) => org.id === id)?.role}
                </li>
              ))}
            </ul>
          ) : (
            <p>
              {ru
                ? 'Организатор в этой записи не приводится как подтверждённый партнёр.'
                : 'The organizer is not presented as a confirmed partner in this record.'}
            </p>
          )}
          <div class="provenance">
            <strong>{ru ? 'Происхождение сведений' : 'Provenance'}</strong>
            <p>{oneCase.source}</p>
            {oneCase.evidence.map((id) => (
              <p>
                {evidence.find((x) => x.id === id)?.title[lang]} · {evidence.find((x) => x.id === id)?.source}
              </p>
            ))}
            <p>
              {ru
                ? 'Права на изображения и публичное цитирование документов проверяются отдельно.'
                : 'Image and document quotation rights are reviewed separately.'}
            </p>
          </div>
        </section>
      </div>
    </div>
  </article>
)}
{page.kind === 'contact' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">06 / {sectionName.contact}</p>
      <h1>{ru ? 'Связаться со студией' : 'Contact the studio'}</h1>
