---
import MediaFigure from './MediaFigure.astro';
import WorkCard from './WorkCard.astro';
import {
  cases,
  evidence,
  formats,
  heroVisuals,
  mediaById,
  organizations,
  people,
  recognitions,
  works,
  workById,
} from '../data/site';
import { caseUrl, formatUrl, workUrl, type Page } from '../lib/routes';
interface Props {
  page: Page;
}
const { page } = Astro.props;
const lang = page.lang;
const ru = lang === 'ru';
const work = page.kind === 'work' ? works.find((x) => x.slug === page.slug) : undefined;
const oneCase = page.kind === 'case' ? cases.find((x) => x.slug === page.slug) : undefined;
const publishedRecognitions = recognitions.filter(
  (item) => item.publication === 'published' && item.documentRights === 'cleared',
);
const sectionName = {
  home: ru ? 'Главная' : 'Home',
  works: ru ? 'Работы' : 'Works',
  formats: ru ? 'Форматы' : 'Formats',
  cooperation: ru ? 'Сотрудничество' : 'Cooperation',
  studio: ru ? 'Студия' : 'Studio',
  cases: ru ? 'Кейсы' : 'Cases',
  contact: ru ? 'Контакт' : 'Contact',
  technology: ru ? 'Нейромандала' : 'Neuromandala',
  recognition: ru ? 'Признания' : 'Recognition',
};
const featured = heroVisuals;
const timeline = [...cases]
  .sort((a, b) => a.date.localeCompare(b.date))
  .map((item) => ({
    year: item.date.slice(0, 4),
    en: `${item.title.en} · ${item.place.en}`,
    ru: `${item.title.ru} · ${item.place.ru}`,
    url: caseUrl(lang, item.id),
  }));
---

{page.kind === 'home' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">ODA.DREAM / ART · PERCEPTION · TECHNOLOGY</p>
      <h1>{ru ? 'Состояние человека как художественный материал.' : 'Human state as artistic material.'}</h1>
      <p class="lead">
        {ru
          ? 'ODA.dream создаёт партисипаторные спектакли, инсталляции и объекты, в которых человек не зритель технологии, а участник художественного события.'
          : 'ODA.dream creates participatory performances, installations and objects in which a person is not a spectator of technology, but part of the artwork.'}
      </p>
    </section>
    <div class="shell">
      <div
        class="feature-carousel"
        aria-label={ru ? 'Нейромандала: избранные фрагменты' : 'Neuromandala: selected sequences'}
        data-carousel
      >
        {featured.map((item, i) => {
          const image = mediaById(item.mediaId);
          return (
            <div class="feature-split feature-slide" data-slide data-slide-id={item.id} hidden={i !== 0}>
              <figure class="feature-visual">
                <video
                  muted
                  playsinline
                  loop
                  preload={i === 0 ? 'metadata' : 'none'}
                  poster={image?.poster}
                  aria-label={`${item.title[lang]} — ${item.medium[lang]}`}
                  data-preview
                >
                  <source src={image?.previewSrc} type="video/mp4" />
                </video>
                <figcaption>
                  {item.title[lang]} · {item.medium[lang]}
                </figcaption>
              </figure>
              <div class="feature-copy">
                <div class="feature-kicker">
                  <span class="index" data-slide-number>
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="eyebrow">/ {ru ? 'Формы Нейромандалы' : 'Neuromandala forms'}</span>
                </div>
                <h2 class="feature-title">{item.title[lang]}</h2>
                <p>
                  {ru
                    ? 'Биосигнал становится частью визуальной композиции — не портретом человека, а материалом художественного процесса.'
                    : 'A biosignal enters the visual composition—not as a portrait of a person, but as material in an artistic process.'}
                </p>
                <a class="quiet-link" href={`/${lang}/technology/`}>
                  {ru ? 'О технологии и методе' : 'About the technology and method'} ↗
                </a>
              </div>
            </div>
          );
        })}
        <div class="carousel-controls">
          <span class="eyebrow">
            {ru ? 'Фрагмент' : 'Sequence'} <span data-carousel-position>01 / 05</span>
          </span>
          <div>
            <button type="button" data-carousel-prev aria-label={ru ? 'Предыдущая работа' : 'Previous work'}>
              ←
            </button>
            <button type="button" data-carousel-next aria-label={ru ? 'Следующая работа' : 'Next work'}>
              →
            </button>
            <button
              type="button"
              data-carousel-toggle
              aria-pressed="false"
              aria-label={ru ? 'Остановить движение' : 'Pause motion'}
            >
              Ⅱ
            </button>
          </div>
        </div>
      </div>
    </div>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">02</span>
        <span class="eyebrow">{ru ? 'Шесть работ' : 'Six works'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Избранное' : 'Selected works'}</h2>
        <div class="work-grid">
          {works.map((item, i) => (
            <WorkCard item={item} index={i} lang={lang} />
          ))}
        </div>
      </div>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">03</span>
        <span class="eyebrow">{ru ? 'Метод / медиум' : 'Method / medium'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Обратная связь как художественный медиум.' : 'Biofeedback as an artistic medium.'}</h2>
        <p>
          {ru
            ? 'Биологическая обратная связь превращает измеряемые сигналы тела в звук, изображение или движение. Участник видит, как его состояние влияет на произведение, и может исследовать эту связь вместе с другими.'
            : 'Biofeedback translates measured bodily signals into sound, image or movement. A participant can see how their state affects the work and explore that relationship with others.'}
        </p>
        <div class="method-steps">
          <p>
            <span class="index">01</span>
            <strong>{ru ? 'Сигнал' : 'Signal'}</strong>
            {ru
              ? 'Сенсор считывает ограниченный физиологический параметр, а не мысли или чувства.'
              : 'A sensor reads a limited physiological signal, not thoughts or feelings.'}
          </p>
          <p>
            <span class="index">02</span>
            <strong>{ru ? 'Перевод' : 'Translation'}</strong>
            {ru
              ? 'Художественные правила преобразуют его в материал сцены.'
              : 'Artistic rules translate it into stage material.'}
          </p>
          <p>
            <span class="index">03</span>
            <strong>{ru ? 'Опыт' : 'Experience'}</strong>
            {ru
              ? 'Человек наблюдает ответ среды и сам выбирает, как участвовать.'
              : 'The person observes the response and chooses how to participate.'}
          </p>
        </div>
        <p class="small-note">
          {ru
            ? 'Мы не ставим диагнозов и не считаем сигнал доказательством внутреннего состояния.'
            : 'We do not diagnose people or claim that a signal proves an inner state.'}
        </p>
        <div class="link-row">
          <a class="quiet-link" href={`/${lang}/technology/`}>
            {ru ? 'Как устроена Нейромандала' : 'How Neuromandala works'} ↗
          </a>
          <a class="quiet-link" href={`/${lang}/formats/`}>
            {ru ? 'Форматы' : 'Formats'} ↗
          </a>
        </div>
      </div>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">04</span>
        <span class="eyebrow">{ru ? 'Хронология' : 'Timeline'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Избранные события и показы' : 'Selected events and presentations'}</h2>
        <p>
          {ru
            ? 'Даты, места и роли взяты из карточек кейсов. Перенос полного реестра событий ещё продолжается.'
            : 'Dates, places and roles come from the case records. Migration of the complete event register is still in progress.'}
        </p>
        <ol class="timeline">
          {timeline.map((item) => (
            <li>
              <span class="index">{item.year}</span>
              <p>{item[lang]}</p>
              <a class="quiet-link" href={item.url}>
                {ru ? 'Подробнее' : 'Explore'} ↗
              </a>
            </li>
          ))}
        </ol>
        <a class="quiet-link" href={`/${lang}/cases/`}>
          {ru ? 'Опубликованные кейсы' : 'Published cases'} ↗
        </a>
      </div>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">05</span>
        <span class="eyebrow">{ru ? 'Признания' : 'Recognition'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Архив наград и благодарностей.' : 'Awards and acknowledgements archive.'}</h2>
        <p class="acknowledgements">
          {ru
            ? 'Здесь будут собраны награды, сертификаты и благодарственные письма — с событием, источником и разрешением на публикацию. Документы из прежнего архива сейчас проходят сверку.'
            : 'Awards, certificates and letters of appreciation will be listed with their event, source and publication permission. Documents from the previous archive are being checked.'}
        </p>
        <a class="quiet-link" href={`/${lang}/recognition/`}>
          {ru ? 'Архив признаний' : 'Recognition archive'} ↗
        </a>
      </div>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">06</span>
        <span class="eyebrow">{ru ? 'Связь' : 'Contact'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Есть проект или вопрос?' : 'Have a project or a question?'}</h2>
        <p>
          {ru
            ? 'Обсудим показ, адаптацию готового формата или совместное исследование.'
            : 'Let’s discuss a presentation, an adapted format or a shared investigation.'}
        </p>
        <a class="quiet-link" href={`/${lang}/contact/`}>
          {ru ? 'Связаться со студией' : 'Contact the studio'} ↗
        </a>
      </div>
    </section>
  </>
)}
{page.kind === 'works' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">01 / {sectionName.works}</p>
      <h1>{ru ? 'Работы' : 'Works'}</h1>
      <p class="lead">
        {ru
          ? 'Произведения, лаборатории и объекты. Работа — это художественная идея и её история; формат заказа описан отдельно.'
          : 'Artworks, laboratories and objects. A work has its own artistic history; bookable configurations are described separately.'}
      </p>
    </section>
    <section class="shell">
      <div class="work-grid">
        {works.map((item, i) => (
          <WorkCard item={item} index={i} lang={lang} />
        ))}
      </div>
    </section>
  </>
)}
{page.kind === 'technology' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">01 / {sectionName.technology}</p>
      <h1>
        {ru
          ? 'Нейромандала: сигнал становится художественным материалом'
          : 'Neuromandala: a signal becomes artistic material'}
      </h1>
      <p class="lead">
        {ru
          ? 'Нейромандала — разработанная ODA.dream система для создания интерактивных аудиовизуальных форм из биосигналов. Это не способ читать мысли и не медицинский инструмент.'
          : 'Neuromandala is an ODA.dream system for shaping interactive audiovisual forms from biosignals. It does not read thoughts and is not a medical instrument.'}
      </p>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">01</span>
        <span class="eyebrow">{ru ? 'Процесс' : 'Process'}</span>
      </div>
      <div class="section-body">
        <h2>{ru ? 'Измерение — не объяснение.' : 'Measurement is not explanation.'}</h2>
        <div class="method-steps">
          <p>
            <span class="index">01</span>
            <strong>{ru ? 'Сигнал' : 'Signal'}</strong>
            {ru
              ? 'Сенсор регистрирует ограниченные физиологические параметры, например электрическую активность мозга.'
              : 'A sensor records limited physiological parameters, such as electrical brain activity.'}
          </p>
          <p>
            <span class="index">02</span>
            <strong>{ru ? 'Художественный перевод' : 'Artistic translation'}</strong>
            {ru
              ? 'Правила конкретной работы связывают изменения сигнала со звуком, изображением или движением.'
              : 'Rules specific to each artwork map signal changes to sound, image or movement.'}
          </p>
          <p>
            <span class="index">03</span>
            <strong>{ru ? 'Обратная связь' : 'Feedback'}</strong>
            {ru
              ? 'Участник видит отклик среды и может исследовать его; это не объективная оценка эмоций или личности.'
              : 'A participant sees the environment respond and can explore that response; it is not an objective reading of emotion or personality.'}
          </p>
        </div>
        <p class="small-note">
          {ru
            ? 'Состав сенсоров, согласие, хранение исходных данных и возможность участия без сенсора определяются отдельно для каждого показа.'
            : 'Sensors, consent, raw-data retention and sensor-free participation are specified for each presentation.'}
        </p>
        <div class="link-row">
          {works
            .filter((item) => ['mindshow', 'interference', 'neurobattle'].includes(item.id))
            .map((item) => (
              <a class="quiet-link" href={workUrl(lang, item.id)}>
                {item.title[lang]} ↗
              </a>
            ))}
        </div>
      </div>
    </section>
  </>
)}
{page.kind === 'recognition' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">02 / {sectionName.recognition}</p>
      <h1>{ru ? 'Документы признания' : 'Recognition archive'}</h1>
      <p class="lead">
        {ru
          ? 'Архив отделяет награды, сертификаты и благодарственные письма от списка площадок и заказчиков. Публикуются только записи с проверенным содержанием; изображения документов — после проверки разрешений.'
          : 'This archive distinguishes awards, certificates and letters of appreciation from a client or venue list. Records are published only after their contents are checked; document images require separate permission review.'}
      </p>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <span class="index">01</span>
        <span class="eyebrow">{ru ? 'Редакционный статус' : 'Editorial status'}</span>
      </div>
      <div class="section-body">
        <p>
          {ru
            ? 'Исходный архив предыдущей версии содержит документы 2024–2026 годов. В текущей миграции их названия, даты и связи с событиями требуют сверки, а права на сканы — отдельного подтверждения. Поэтому документы пока не представлены как опубликованные награды.'
            : 'The previous site’s archive contains documents from 2024–2026. Their titles, dates and event links are being checked during migration, and scan permissions require separate confirmation. They are therefore not yet presented here as published awards.'}
        </p>
        {publishedRecognitions.map((item) => (
          <article class="list-row">
            <span class="meta">
              {item.year} · {item.kind}
            </span>
            <div>
              <h2>{item.title[lang]}</h2>
              <p>{item.issuer[lang]}</p>
            </div>
          </article>
        ))}
        <a class="quiet-link" href={`/${lang}/cases/`}>
          {ru ? 'Проверяемые события' : 'Documented events'} ↗
        </a>
      </div>
    </section>
  </>
)}
{work && (
  <article class="shell page-intro">
    <nav class="breadcrumbs" aria-label={ru ? 'Навигационная цепочка' : 'Breadcrumbs'}>
      <a href={`/${lang}/`}>{ru ? 'Главная' : 'Home'}</a>
      <span>/</span>
      <a href={`/${lang}/works/`}>{ru ? 'Работы' : 'Works'}</a>
      <span>/</span>
      <span>{work.title[lang]}</span>
    </nav>
    <div class="work-layout">
      <aside class="work-aside">
        <span class="eyebrow">{work.category[lang]}</span>
        <span class="status">{work.status[lang]}</span>
        <span class="meta">{work.source}</span>
      </aside>
      <div class="work-main">
        <h1>{work.title[lang]}</h1>
        <p class="lead">{work.experience[lang]}</p>
        <MediaFigure id={work.media[0]} lang={lang} priority />
        <section class="work-section">
          <span class="eyebrow">01 / {ru ? 'Художественная ставка' : 'Artistic question'}</span>
          <h2>{work.question[lang]}</h2>
          <p>{work.summary[lang]}</p>
        </section>
        <section class="work-section">
          <span class="eyebrow">02 / {ru ? 'Контекст' : 'Context'}</span>
          <h2>{ru ? 'Подтверждённые факты' : 'Documented facts'}</h2>
          <ul class="facts">
            {work.facts[lang].map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
          {work.cases.length > 0 && (
            <div class="link-row spaced-actions">
              {work.cases.map((id) => (
                <a class="quiet-link" href={caseUrl(lang, id)}>
                  {cases.find((x) => x.id === id)?.title[lang]} ↗
                </a>
              ))}
            </div>
          )}
        </section>
        {['interference', 'mindshow', 'neurobattle'].includes(work.id) && (
          <section class="work-section">
            <span class="eyebrow">03 / {ru ? 'Опыт и метод' : 'Experience and method'}</span>
            <h2>{ru ? 'Человек внутри работы' : 'The participant inside the work'}</h2>
            <p>{work.experience[lang]}</p>
            <p>
              {work.id === 'interference'
                ? ru
                  ? 'Движение, выбор и рассказ соседствуют с виртуальным пространством, которое остаётся самостоятельной сценой. ЭЭГ и компьютерное зрение присутствуют как художественные инструменты, но не выдают точную карту внутреннего мира.'
                  : 'Movement, choice and narrative meet a virtual space that remains a stage in its own right. EEG and computer vision act as artistic instruments, not a precise map of inner life.'
                : work.id === 'mindshow'
                  ? ru
                    ? 'Состояние участника и его слова участвуют в генерации визуального сюжета. Разные версии произведения имеют разный технический состав, поэтому конфигурация оговаривается отдельно.'
                    : 'A participant’s state and words shape a visual sequence. Versions differ technically, so the configuration is agreed for each context.'
                  : ru
                    ? 'Система показывает относительные изменения в моменте, а не сравнивает интеллект или «силу мозга». Участие не требует предварительной подготовки.'
                    : 'The system shows relative changes in the moment, not intelligence or “brain power”. No advance training is needed.'}
            </p>
          </section>
        )}
        <section class="work-section">
          <span class="eyebrow">04 / {ru ? 'Доступность' : 'Availability'}</span>
          <h2>{ru ? 'Как работать с проектом' : 'Working with the project'}</h2>
          <p>{work.availability[lang]}</p>
          {work.formats.length > 0 && (
            <div class="link-row spaced-actions">
              {work.formats.map((id) => (
                <a class="quiet-link" href={formatUrl(lang, id)}>
                  {formats.find((x) => x.id === id)?.title[lang]} ↗
                </a>
              ))}
            </div>
          )}
          <div class="link-row spaced-actions">
            <a class="button primary" href={`/${lang}/contact/`}>
              {ru ? 'Обсудить проект' : 'Discuss a project'}
            </a>
          </div>
        </section>
        <div class="provenance">
          <strong>{ru ? 'Источник и права' : 'Source and rights'}</strong>
          <p>
            {ru
              ? 'Описание сверено с архивной карточкой ODA.dream. Права на представленное изображение требуют редакционного подтверждения до публикации.'
              : 'Description checked against the ODA.dream archive record. Image rights require editorial confirmation before publication.'}
          </p>
          <p>{work.source}</p>
        </div>
      </div>
    </div>
  </article>
)}
{page.kind === 'formats' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">02 / {sectionName.formats}</p>
      <h1>{ru ? 'Форматы' : 'Formats'}</h1>
      <p class="lead">
        {ru
          ? 'Формат — это согласуемая конфигурация работы или отдельная образовательная программа. Наличие реализованной работы само по себе не означает готовность к заказу.'
          : 'A format is an agreed configuration of a work or an educational programme. A realized artwork is not automatically available to commission.'}
      </p>
    </section>
    <section class="shell">
      {formats.map((item, i) => (
        <article class="section section-grid" id={item.slug}>
          <div class="section-label">
            <span class="index">0{i + 1}</span>
            <span class="eyebrow">{ru ? 'Конфигурация' : 'Configuration'}</span>
          </div>
          <div class="section-body">
            <h2>{item.title[lang]}</h2>
            <p class="lead">{item.summary[lang]}</p>
            <p>{item.scope[lang]}</p>
            <div class="link-row">
              {item.works.map((id) => (
                <a class="quiet-link" href={workUrl(lang, id)}>
                  {workById(id)?.title[lang]} ↗
                </a>
              ))}
              <a class="quiet-link" href={`/${lang}/cooperation/`}>
                {ru ? 'Условия сотрудничества' : 'Cooperation details'} ↗
              </a>
            </div>
          </div>
        </article>
      ))}
    </section>
  </>
)}
{page.kind === 'cooperation' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">03 / {sectionName.cooperation}</p>
      <h1>{ru ? 'Сотрудничество' : 'Cooperation'}</h1>
      <p class="lead">
        {ru
          ? 'Можно пригласить существующую работу, адаптировать формат или разработать новый художественный проект совместно.'
          : 'Present an existing work, adapt a format or develop a new artistic project together.'}
      </p>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
