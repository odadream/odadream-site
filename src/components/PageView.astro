        <p class="lead">{oneCase.summary[lang]}</p>
        <MediaFigure id={oneCase.media[0]} lang={lang} priority />
        <section class="work-section" id="case-contribution">
          <span class="eyebrow">
            <PageCode family={family} section={1} lang={lang} /> / {ru ? 'Участие' : 'Participation'}
          </span>
          <h2>{ru ? 'Роль ODA.dream' : 'ODA.dream’s role'}</h2>
          <p>{oneCase.role[lang]}</p>
          <CalloutLink href={caseTargetUrl(lang, oneCase)}>
            {ru ? 'Связанный материал' : 'Related material'}:{' '}
            {oneCase.work
              ? workById(oneCase.work)?.title[lang]
              : methods.find((row) => row.id === oneCase.method)?.title[lang]}
          </CalloutLink>
        </section>
        <section class="work-section" id="case-story">
          <span class="eyebrow">
            <PageCode family={family} section={2} lang={lang} /> / {ru ? 'Участие' : 'Contribution'}
          </span>
          <h2>{ru ? 'Как проходил показ' : 'The presentation'}</h2>
          <EditorialSections sections={oneCase.story} lang={lang} anchorPrefix="case-story" />
        </section>
        <section class="work-section" id="case-context">
          <span class="eyebrow">
            <PageCode family={family} section={3} lang={lang} /> / {ru ? 'Контекст' : 'Context'}
          </span>
          <h2>{ru ? 'Организации и источники' : 'Organizations and sources'}</h2>
          {oneCase.organizationRoles.length > 0 && (
            <ul class="facts">
              {oneCase.organizationRoles.map((item) => (
                <li>
                  <strong>{organizations.find((org) => org.id === item.organizationId)?.name[lang]}</strong> ·{' '}
                  {item.description[lang]}
                </li>
              ))}
            </ul>
          )}
          {oneCase.participants.map((person) => (
            <div class="list-row">
              <div>
                <h3>{person.name[lang]}</h3>
                <p>{person.role[lang]}</p>
              </div>
            </div>
          ))}
          {oneCase.limitations.map((note) => (
            <p class="small-note">{note[lang]}</p>
          ))}
        </section>
        <section class="work-section" id="case-evidence">
          <span class="eyebrow">
            <PageCode family={family} section={4} lang={lang} /> / {ru ? 'Основание сведений' : 'Sources'}
          </span>
          <h2>{ru ? 'Что подтверждает запись' : 'What the record supports'}</h2>
          {oneCase.evidence.flatMap((id) => {
            const item = evidence.find((row) => row.id === id);
            return item ? [<EvidenceNote item={item} lang={lang} />] : [];
          })}
          <div class="link-row spaced-actions">
            <a class="button primary" href={`/${lang}/contact/`}>
              {ru ? 'Обсудить похожий показ' : 'Discuss a similar presentation'}
            </a>
          </div>
        </section>
      </div>
      <aside class="work-aside">
        <RecordStamp
          title={ru ? 'Паспорт события' : 'Event record'}
          fields={[
            { label: 'ID', value: oneCase.legacyId },
            { label: ru ? 'Тип' : 'Type', value: caseTypeLabels[oneCase.type][lang] },
            { label: ru ? 'Дата' : 'Date', value: oneCase.date },
            { label: ru ? 'Место' : 'Place', value: oneCase.place[lang] },
            {
              label: ru ? 'Работа' : 'Work',
              value: oneCase.work
                ? workById(oneCase.work)!.title[lang]
                : methods.find((row) => row.id === oneCase.method)!.title[lang],
              href: caseTargetUrl(lang, oneCase),
            },
          ]}
        />
      </aside>
    </div>
  </article>
)}
{page.kind === 'contact' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">
        <PageCode family={family} lang={lang} /> / {sectionName.contact}
      </p>
      <h1>{ru ? 'Связаться со студией' : 'Contact the studio'}</h1>
      <p class="lead">
        {ru
          ? 'Для показов, заказов, совместной разработки и вопросов об архиве. Напишите напрямую — без обязательной формы.'
          : 'For presentations, commissions, co-development and questions about the archive. Write directly; no form is required.'}
      </p>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <PageCode family={family} section={1} lang={lang} />
        <span class="eyebrow">EMAIL / TELEGRAM</span>
      </div>
      <div class="section-body">
        <p class="contact-address">
          <CalloutLink href="mailto:hi@odadream.art">hi@odadream.art</CalloutLink>
        </p>
        <p class="small-note">
          {ru
            ? 'Быстрый ответ — в Telegram. Адреса сверены с контактными данными старого сайта.'
            : 'For a quick reply, use Telegram. These addresses match the previous site’s contact registry.'}
        </p>
        <CalloutLink href="https://t.me/odadream_info" rel="noopener noreferrer">
          t.me/odadream_info
        </CalloutLink>
      </div>
    </section>
  </>
)}
