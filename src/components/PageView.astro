---
import MindDBStamp from './MindDBStamp.astro';
import EditorialSections from './EditorialSections.astro';
import DocumentList from './DocumentList.astro';
import MediaFigure from './MediaFigure.astro';
import VideoPreview from './VideoPreview.astro';
import WorkCard from './WorkCard.astro';
import RecognitionCard from './RecognitionCard.astro';
import SectionRail from './SectionRail.astro';
import RecordStamp from './RecordStamp.astro';
import PageCode from './PageCode.astro';
import TechnicalMark from './TechnicalMark.astro';
import CalloutLink from './CalloutLink.astro';
import StatisticsStamp from './StatisticsStamp.astro';
import {
  methods,
  cooperationPages,
  studioPages,
  workDocuments,
  referenceDocuments,
  cases,
  evidence,
  formats,
  publicHeroVisuals,
  selectedWorks,
  realizedWorks,
  researchWorks,
  mediaById,
  organizations,
  people,
  recognitions,
  works,
  workById,
} from '../data/catalogue';
import { workStageLabels } from '../data/site';
import { minddbSnapshot, preview } from '../data/catalogue';
import { caseUrl, caseTargetUrl, formatUrl, workUrl, type Page } from '../lib/routes';
import EvidenceNote from './EvidenceNote.astro';
interface Props {
  page: Page;
}
const { page } = Astro.props;
const lang = page.lang;
const family = page.family;
const ru = lang === 'ru';
const work = page.kind === 'work' ? works.find((x) => x.slug === page.slug) : undefined;
const oneCase = page.kind === 'case' ? cases.find((x) => x.slug === page.slug) : undefined;
const sectionName = {
  home: ru ? 'Главная' : 'Home',
  works: ru ? 'Работы' : 'Works',
  formats: ru ? 'Форматы' : 'Formats',
  cooperation: ru ? 'Сотрудничество' : 'Cooperation',
  studio: ru ? 'Студия' : 'Studio',
  cases: ru ? 'Кейсы' : 'Cases',
  contact: ru ? 'Контакт' : 'Contact',
  technology: ru ? 'Нейромандала' : 'Neuromandala',
  recognition: ru ? 'Признания' : 'Recognition',
};
const method = methods.find((item) => item.id === 'neuromandala');
const cooperation = cooperationPages.find((item) => item.id === 'cooperation');
const studio = studioPages.find((item) => item.id === 'studio');
const studioMembers = (studio?.people ?? []).flatMap((id) => {
  const person = people.find((item) => item.id === id);
  return person ? [person] : [];
});
const featured = publicHeroVisuals;
const homepageRecognitions = recognitions.filter((item) => item.featuredOnHome);
const caseTypeLabels = {
  performance: { ru: 'Перформанс', en: 'Performance' },
  presentation: { ru: 'Публичный показ', en: 'Public presentation' },
  'participatory-format': { ru: 'Партисипаторный формат', en: 'Participatory format' },
};
const timeline = [...cases]
  .filter((item) => item.featuredOnHome)
  .sort((a, b) => a.date.localeCompare(b.date))
  .map((item) => ({
    year: item.date.slice(0, 4),
    en: `${item.title.en} · ${item.place.en}`,
    ru: `${item.title.ru} · ${item.place.ru}`,
    url: caseUrl(lang, item.id),
  }));
---

{page.kind === 'home' && (
  <>
    <div class="shell">
      <div
        class="feature-carousel nm-hero"
        aria-label={ru ? 'Нейромандала: видео и данные коллекции' : 'Neuromandala: video and collection data'}
        data-carousel
      >
        {featured.map((item, i) => {
          const image = mediaById(item.mediaId);
          const linkedWork = item.target.kind === 'work' ? workById(item.target.workId) : undefined;
          const caseId = item.target.kind === 'work' ? item.target.caseId : undefined;
          const linkedCase = caseId ? cases.find((caseItem) => caseItem.id === caseId) : undefined;
          const mediaTitle = image?.caption[lang].split(' · ')[0];
          const mediaDetail = image?.caption[lang].split(' · ').slice(1).join(' · ');
          return (
            <article
              class="nm-slide feature-slide"
              data-slide
              data-preview-trigger
              data-slide-id={item.id}
              data-media-id={item.mediaId}
              hidden={i !== 0}
            >
              <div class="nm-visual">
                {image?.previewSrc && image.poster && (
                  <VideoPreview
                    class="nm-background-video"
                    src={image.previewSrc}
                    poster={image.poster}
                    alt={image.alt[lang]}
                    width={image.width}
                    height={image.height}
                    priority={i === 0}
                    focusable={false}
                  />
                )}
                <div class="nm-scrim" aria-hidden="true"></div>
                <div class="nm-work-caption">
                  <div class="carousel-controls nm-carousel-controls">
                    <span class="eyebrow">
                      {ru ? 'КАДР' : 'FRAME'} ·{' '}
                      <span data-carousel-position>
                        {String(i + 1).padStart(2, '0')} / {String(featured.length).padStart(2, '0')}
                      </span>
                    </span>
                    <div>
                      <button
                        type="button"
                        data-carousel-prev
                        aria-label={ru ? 'Предыдущая работа' : 'Previous work'}
                      >
                        <TechnicalMark kind="previous" />
                      </button>
                      <button
                        type="button"
                        data-carousel-next
                        aria-label={ru ? 'Следующая работа' : 'Next work'}
                      >
                        <TechnicalMark kind="next" />
                      </button>
                    </div>
                  </div>
                  <h2>{linkedWork?.title[lang] ?? mediaTitle}</h2>
                  <p>
                    {linkedCase
                      ? `${linkedCase.title[lang]} · ${linkedCase.date.slice(0, 4)} · ${linkedCase.place[lang]}`
                      : mediaDetail}
                  </p>
                  {linkedCase && <p class="nm-caption">{mediaDetail}</p>}
                  <div class="nm-caption-link">
                    {item.target.kind === 'work' ? (
                      <CalloutLink
                        href={
                          item.target.caseId
                            ? caseUrl(lang, item.target.caseId)
                            : workUrl(lang, item.target.workId)
                        }
                      >
                        {item.target.caseId
                          ? ru
                            ? 'Работа в контексте показа'
                            : 'Work in presentation context'
                          : ru
                            ? 'Страница работы'
                            : 'Work documentation'}
                      </CalloutLink>
                    ) : item.target.kind === 'method' ? (
                      <CalloutLink href={`/${lang}/technology/`}>
                        {ru ? 'Метод Нейромандалы' : 'Neuromandala method'}
                      </CalloutLink>
                    ) : (
                      <span class="nm-pending-link" role="status">
                        {ru ? 'Архивный фрагмент' : 'Archive excerpt'}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
        <div class="nm-heading">
          <span class="eyebrow">
            <PageCode family="H" section={0} lang={lang} /> / {ru ? 'НЕЙРОМАНДАЛА' : 'NEUROMANDALA'}
          </span>
          <h1>
            {ru ? 'Состояние человека — художественный материал.' : 'Human state as artistic material.'}
          </h1>
          <p>
            {ru
              ? 'Художественная студия создаёт партисипаторные спектакли, инсталляции и объекты, в которых человек влияет на произведение.'
              : 'An art studio creating participatory performances, installations and objects shaped by the people who encounter them.'}
          </p>
        </div>
        {minddbSnapshot && (
          <aside
            class="nm-data-panel"
            aria-label={ru ? 'Сводные данные MindDB' : 'MindDB collection summary'}
          >
            <MindDBStamp lang={lang} />
          </aside>
        )}
      </div>
    </div>
    <section class="section shell section-grid section--atlas" id="selected-works">
      <div class="section-body">
        <h2>{ru ? 'Избранные работы' : 'Selected works'}</h2>
        <div class="work-grid">
          {selectedWorks.map((item) => (
            <WorkCard item={item} lang={lang} />
          ))}
        </div>
        <CalloutLink href={`/${lang}/works/`}>{ru ? 'Все работы' : 'All works'}</CalloutLink>
      </div>
      <SectionRail
        family="H"
        section={1}
        label={ru ? 'Работы' : 'Works'}
        note={
          ru
            ? 'Живое действие, совместный опыт, материальный след. У каждой работы — своя история.'
            : 'Live action, shared experience, a material trace. Each work has its own history.'
        }
        lang={lang}
      >
        <StatisticsStamp kind="works" lang={lang} />
      </SectionRail>
    </section>
    <section class="section shell section-grid section--atlas section--method" id="medium">
      <div class="section-body">
        <h2>{ru ? 'Обратная связь как художественный медиум.' : 'Biofeedback as an artistic medium.'}</h2>
        <p>
          {ru
            ? 'Биологическая обратная связь превращает измеряемые сигналы тела в звук, изображение или движение. Участник видит, как его состояние влияет на произведение, и может исследовать эту связь вместе с другими.'
            : 'Biofeedback translates measured bodily signals into sound, image or movement. A participant can see how their state affects the work and explore that relationship with others.'}
        </p>
        <div class="method-steps method-steps--linked">
          <p>
            <strong>{ru ? 'Сигнал' : 'Signal'}</strong>
            {ru
              ? 'Сенсор считывает ограниченный физиологический параметр, а не мысли или чувства.'
              : 'A sensor reads a limited physiological signal, not thoughts or feelings.'}
          </p>
          <p>
            <strong>{ru ? 'Перевод' : 'Translation'}</strong>
            {ru
              ? 'Художественные правила преобразуют его в материал сцены.'
              : 'Artistic rules translate it into stage material.'}
          </p>
          <p>
            <strong>{ru ? 'Опыт' : 'Experience'}</strong>
            {ru
              ? 'Человек наблюдает ответ среды и сам выбирает, как участвовать.'
              : 'The person observes the response and chooses how to participate.'}
          </p>
        </div>
        <p class="small-note">
          {ru
            ? 'Мы не ставим диагнозов и не считаем сигнал доказательством внутреннего состояния.'
            : 'We do not diagnose people or claim that a signal proves an inner state.'}
        </p>
        <div class="link-row">
          <CalloutLink href={`/${lang}/technology/`}>
            {ru ? 'Как устроена Нейромандала' : 'How Neuromandala works'}
          </CalloutLink>
          <CalloutLink href={`/${lang}/formats/`}>{ru ? 'Форматы' : 'Formats'}</CalloutLink>
        </div>
      </div>
      <SectionRail
        family="H"
        section={2}
        label={ru ? 'Метод / медиум' : 'Method / medium'}
        note={
          ru
            ? 'Измерение становится формой. Значение возникает в опыте участника.'
            : 'Measurement takes form. Meaning emerges in the participant’s experience.'
        }
        lang={lang}
      />
    </section>
    <section class="section shell section-grid section--atlas" id="timeline">
      <div class="section-body">
        <h2>{ru ? 'Избранные события и показы' : 'Selected events and presentations'}</h2>
        <ol class="timeline">
          {timeline.map((item) => (
            <li>
              <div class="timeline__date">
                <span class="index">{item.year}</span>
              </div>
              <p>{item[lang]}</p>
              <CalloutLink href={item.url}>{ru ? 'Подробнее' : 'Explore'}</CalloutLink>
            </li>
          ))}
        </ol>
        <CalloutLink href={`/${lang}/cases/`}>{ru ? 'Опубликованные кейсы' : 'Published cases'}</CalloutLink>
      </div>
      <SectionRail
        family="H"
        section={3}
        label={ru ? 'Хронология' : 'Timeline'}
        note={
          ru
            ? 'Произведение меняется от встречи к встрече. Здесь — дата, место и роль студии.'
            : 'A work changes with each encounter. Here: date, place and the studio’s role.'
        }
        lang={lang}
      >
        <StatisticsStamp kind="events" lang={lang} />
      </SectionRail>
    </section>
    {homepageRecognitions.length > 0 && (
      <section class="section shell section-grid section--atlas" id="recognition">
        <div class="section-body">
          <h2>{ru ? 'Архив наград и благодарностей.' : 'Awards and acknowledgements archive.'}</h2>
          <div class="recognition-grid">
            {homepageRecognitions.map((item) => (
              <RecognitionCard item={item} lang={lang} />
            ))}
          </div>
          <p class="small-note">
            {ru
              ? preview
                ? 'Превью из прежнего публичного архива. Права на повторную публикацию документов ещё проверяются.'
                : 'Выбранные документы с подтверждённым разрешением на публикацию.'
              : preview
                ? 'Previews from the former public archive. Re-publication rights remain under review.'
                : 'Selected documents cleared for publication.'}
          </p>
          <CalloutLink href={`/${lang}/recognition/`}>
            {ru ? 'Архив признаний' : 'Recognition archive'}
          </CalloutLink>
        </div>
        <SectionRail
          family="H"
          section={4}
          label={ru ? 'Признания' : 'Recognition'}
          note={
            ru
              ? 'След встречи — документ. Автор, институция и повод сохраняются рядом с изображением.'
              : 'An encounter leaves a document. Author, institution and occasion stay with the image.'
          }
          lang={lang}
        >
          <StatisticsStamp kind="recognition" lang={lang} />
        </SectionRail>
      </section>
    )}
    <section class="section shell section-grid section--atlas" id="contact">
      <div class="section-body">
        <h2>{ru ? 'Есть проект или вопрос?' : 'Have a project or a question?'}</h2>
        <p>
          {ru
            ? 'Обсудим показ, адаптацию готового формата или совместное исследование.'
            : 'Let’s discuss a presentation, an adapted format or a shared investigation.'}
        </p>
        <CalloutLink href={`/${lang}/contact/`}>
          {ru ? 'Связаться со студией' : 'Contact the studio'}
        </CalloutLink>
      </div>
      <SectionRail
        family="H"
        section={homepageRecognitions.length > 0 ? 5 : 4}
        label={ru ? 'Связь' : 'Contact'}
        note={
          ru
            ? 'От первого вопроса — к совместной форме. Показ, заказ или исследование.'
            : 'A first question can become a shared form. Presentation, commission or research.'
        }
        lang={lang}
      />
    </section>
  </>
)}
{page.kind === 'works' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">
        <PageCode family={family} lang={lang} /> / {sectionName.works}
      </p>
      <h1>{ru ? 'Работы' : 'Works'}</h1>
      <p class="lead">
        {ru
          ? 'Произведения, лаборатории и объекты. Работа — это художественная идея и её история; формат заказа описан отдельно.'
          : 'Artworks, laboratories and objects. A work has its own artistic history; bookable configurations are described separately.'}
      </p>
    </section>
    <section class="shell works-catalogue">
      <p class="eyebrow catalogue-label">
        <PageCode family={family} section={1} lang={lang} /> / {ru ? 'КАТАЛОГ' : 'CATALOGUE'}
      </p>
      <div class="work-grid">
        {realizedWorks.map((item) => (
          <WorkCard item={item} lang={lang} />
        ))}
      </div>
    </section>
    <section class="shell works-catalogue" id="research-works">
      <p class="eyebrow catalogue-label">
        <PageCode family={family} section={2} lang={lang} /> / R&amp;D
      </p>
      <h2>{ru ? 'Концепции и прототипы' : 'Concepts and prototypes'}</h2>
      <p class="catalogue-note">
        {ru
          ? 'Работы в разработке: концепции, прототипы и внутренние лаборатории.'
          : 'Works in development: concepts, prototypes and internal laboratories.'}
      </p>
      <div class="work-grid">
        {researchWorks.map((item) => (
          <WorkCard item={item} lang={lang} />
        ))}
      </div>
    </section>
  </>
)}
{page.kind === 'technology' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">
        <PageCode family={family} lang={lang} /> / {sectionName.technology}
      </p>
      <h1>
        {ru
          ? 'Нейромандала: сигнал становится художественным материалом'
          : 'Neuromandala: a signal becomes artistic material'}
      </h1>
      <p class="lead">
        {method?.summary[lang] ??
          (ru
            ? 'Авторская система ODA.dream для создания художественной среды из биосигналов.'
            : 'ODA.dream’s system for creating an artistic environment from biosignals.')}
      </p>
    </section>
    {method && (
      <>
        {method.sections.map((section, i) => (
          <section class="section shell section-grid" id={section.id}>
            <div class="section-label">
              <PageCode family={family} section={i + 1} lang={lang} />
              <span class="eyebrow">{ru ? 'Метод' : 'Method'}</span>
            </div>
            <div class="section-body">
              <h2>{section.title[lang]}</h2>
              <p class="lead">{section.body[lang]}</p>
              {section.id === 'visual-language' &&
                method.media.map((id) => <MediaFigure id={id} lang={lang} />)}
            </div>
          </section>
        ))}
        <section class="section shell section-grid" id="signal-process">
          <div class="section-label">
            <PageCode family={family} section={4} lang={lang} />
            <span class="eyebrow">{ru ? 'Процесс' : 'Process'}</span>
          </div>
          <div class="section-body">
            <h2>{ru ? 'От измерения к отклику' : 'From measurement to response'}</h2>
            <div class="method-steps">
              {method.steps.map((step) => (
                <p>
                  <strong>{step.title[lang]}</strong>
                  {step.body[lang]}
                </p>
              ))}
            </div>
          </div>
        </section>
        <section class="section shell section-grid" id="participation">
          <div class="section-label">
            <PageCode family={family} section={5} lang={lang} />
            <span class="eyebrow">{ru ? 'Участие' : 'Participation'}</span>
          </div>
          <div class="section-body">
            <h2>{ru ? 'Человек, группа, зритель' : 'Person, group, audience'}</h2>
            {method.participation.map((item) => (
              <div class="list-row">
                <div>
                  <h3>{item.title[lang]}</h3>
                  <p>{item.body[lang]}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
        <section class="section shell section-grid" id="method-boundaries">
          <div class="section-label">
            <PageCode family={family} section={6} lang={lang} />
            <span class="eyebrow">{ru ? 'Границы' : 'Boundaries'}</span>
          </div>
          <div class="section-body">
            <h2>{ru ? 'Измерение — не объяснение' : 'Measurement is not explanation'}</h2>
            <ul class="facts">
              {method.limitations[lang].map((text) => (
                <li>{text}</li>
              ))}
            </ul>
            <div class="link-row">
              {method.works.map((id) => (
                <CalloutLink href={workUrl(lang, id)}>{workById(id)?.title[lang]}</CalloutLink>
              ))}
            </div>
            <div class="link-row spaced-actions">
              <CalloutLink href={`/${lang}/formats/`}>
                {ru ? 'Форматы участия' : 'Participation formats'}
              </CalloutLink>
              <CalloutLink href={`/${lang}/cooperation/`}>
                {ru ? 'Обсудить показ или разработку' : 'Discuss presentation or development'}
              </CalloutLink>
            </div>
          </div>
        </section>
      </>
    )}
  </>
)}
{page.kind === 'recognition' && (
  <>
    <section class="page-intro shell">
      <p class="eyebrow">
        <PageCode family={family} lang={lang} /> / {sectionName.recognition}
      </p>
      <h1>{ru ? 'Документы признания' : 'Recognition archive'}</h1>
      <p class="lead">
        {ru
          ? 'Архив отделяет награды, дипломы и благодарственные письма от списка площадок и заказчиков. Здесь показаны превью найденных документов; права на их повторную публикацию проверяются.'
          : 'This archive distinguishes awards, diplomas and letters of appreciation from a venue or client list. Available documents have previews; re-publication rights are being reviewed.'}
      </p>
    </section>
    <section class="section shell section-grid">
      <div class="section-label">
        <PageCode family={family} section={1} lang={lang} />
        <span class="eyebrow">{ru ? 'Редакционный статус' : 'Editorial status'}</span>
      </div>
      <div class="section-body">
        <p>
          {ru
            ? 'Ниже — выборка из прежнего публичного архива. Откройте превью для чтения; отсутствующий скан МФТИ помечен отдельно.'
            : 'A selection from the former public archive. Open a preview to read it; the missing MIPT scan is identified separately.'}
        </p>
        <div class="recognition-grid">
          {recognitions.map((item) => (
            <RecognitionCard item={item} lang={lang} />
          ))}
        </div>
        <CalloutLink href={`/${lang}/cases/`}>{ru ? 'Проверяемые события' : 'Documented events'}</CalloutLink>
      </div>
    </section>
  </>
)}
{work && (
  <article class="shell page-intro">
    <nav class="breadcrumbs" aria-label={ru ? 'Навигационная цепочка' : 'Breadcrumbs'}>
      <CalloutLink href={`/${lang}/`}>{ru ? 'Главная' : 'Home'}</CalloutLink>
      <span>/</span>
      <CalloutLink href={`/${lang}/works/`}>{ru ? 'Работы' : 'Works'}</CalloutLink>
      <span>/</span>
      <span>{work.title[lang]}</span>
    </nav>
    <div class="work-layout">
      <div class="work-main">
        <p class="eyebrow">
          <PageCode family={family} lang={lang} /> / {sectionName.works}
        </p>
        <h1>{work.title[lang]}</h1>
        <p class="lead">{work.experience[lang]}</p>
        <MediaFigure id={work.media[0]} lang={lang} priority />
        <section class="work-section">
          <span class="eyebrow">
            <PageCode family={family} section={1} lang={lang} /> /{' '}
            {ru ? 'Художественная ставка' : 'Artistic question'}
          </span>
          <h2>{work.question[lang]}</h2>
          <p>{work.summary[lang]}</p>
        </section>
        <section class="work-section" id="work-context">
          <span class="eyebrow">
            <PageCode family={family} section={2} lang={lang} /> / {ru ? 'Контекст' : 'Context'}
          </span>
          <h2>{ru ? 'Подтверждённые факты' : 'Documented facts'}</h2>
          {work.components && (
            <>
              <h3>{ru ? 'Состав работы' : 'Components of the work'}</h3>
              <ul class="facts">
                {work.components[lang].map((part) => (
                  <li>{part}</li>
                ))}
              </ul>
            </>
          )}
          {work.basedOn.length > 0 && (
            <p>
              {ru ? 'На основе работы: ' : 'Based on: '}
              {work.basedOn.map((id) => (
