{
  "name": "oda-dream-interface",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run assets:generate && tsc && vite build",
    "preview": "vite preview",
    "assets:generate": "node scripts/generate-assets.js",
    "assets:clean": "node scripts/generate-assets.js --clean",
    "assets:map": "node scripts/generate-map.js",
    "version:sync": "node scripts/update-version.js",
    "dates:sync": "node scripts/sync-dates.js",
    "registry:sync": "node scripts/sync-registry.js",
    "registry:import-obsidian": "node scripts/import-from-obsidian.js",
    "photos:add": "node scripts/add-event-photo.js",
    "pack:materia": "node scripts/pack-materia-assets.js",
    "image:pack": "node scripts/pack-image.js",
    "deploy:check": "powershell -ExecutionPolicy Bypass -File scripts/check-deployment.ps1",
    "migrate:dry": "node scripts/migrate.js",
    "migrate:run": "node scripts/migrate.js --write",
    "migrate:media-dry": "node scripts/migrate/media-subject.js",
    "migrate:media-run": "node scripts/migrate/media-subject.js --write",
    "audit": "node scripts/audit/content-audit.js",
    "audit:structure": "node scripts/audit/dump-structure.js",
    "restructure:dry": "node scripts/audit/restructure.js",
    "restructure:run": "node scripts/audit/restructure.js --write",
    "audit:checklist": "node scripts/audit/dump-checklist.js"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^8.0.7",
    "remark-gfm": "^3.0.1",
    "tailwind-merge": "^2.2.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "terser": "^5.46.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
