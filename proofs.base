filters:
  and:
    - file.folder == "src/content"
    - kind == "proof"
views:
  - type: table
    name: Пруфы
    order:
      - file.name
      - subkind
      - publication
      - publication_date
      - issued_by
      - proof_of
    sort:
      - property: publication
        direction: ASC
      - property: publication_date
        direction: ASC
    columnSize:
      file.name: 182
      note.publication: 383
